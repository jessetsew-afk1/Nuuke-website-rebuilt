---
import Base from '../layouts/Base.astro';
import ServicesSystem from '../components/ServicesSystem.astro';
import ProjectCover from '../components/ProjectCover.astro';
import { projects } from '../data/projects';
import logo from '../data/logo-paths.json';
import MissionHud from '../components/home/MissionHud.astro';

const answer = [
  ['A'], ['design'], ['and'], ['engineering'], ['studio'], ['for'], ['brands'], ['that'], ['refuse'], ['to'], ['blend', 'hi'], ['in.', 'hi'],
  ['We'], ['build'], ['the'], ['apps,', 'hi'], ['worlds,', 'hi'], ['campaigns', 'hi'], ['and'], ['systems', 'hi'], ['that'], ['make'], ['markets'], ['pay'], ['attention.'],
];
const answerText = answer.map(([w]) => w).join(' ');
const stages = [
  { n: 'T‑5', t: 'Pre-flight', s: 'Discover', d: 'Workshops, interviews and a teardown of the competition. We find the one problem worth solving first.' },
  { n: 'T‑4', t: 'Fuelling', s: 'Define', d: 'Flows, information architecture and grey-box wireframes you can react to in days, not weeks.' },
  { n: 'T‑3', t: 'Ignition', s: 'Design', d: 'Clickable prototypes, UI systems and motion. You tap through the product before a line of code exists.' },
  { n: 'T‑2', t: 'Lift-off', s: 'Build', d: 'Native and cross-platform engineering, WebGL and 3D pipelines, tested on real devices.' },
  { n: 'T‑1', t: 'Orbit', s: 'Launch & grow', d: 'Store launch, campaigns and analytics. We measure what changed and keep shipping.' },
];
---

<Base title="NUUKE" score="custom">
  <noscript><style is:inline>.loader { display: none !important; }</style></noscript>
  <!-- LAUNCH SCREEN: the 3D pad fills the screen; only the two launch buttons sit on top -->
  <div class="loader" data-loader>
    <p class="visually-hidden" role="status" data-ld-status>Preparing for launch</p>
    <div class="ld-ui">
      <div class="ld-progress" aria-hidden="true"><span data-ld-bar></span></div>
      <div class="ld-actions" data-ld-actions hidden>
        <button class="ld-go ld-go--sound" type="button" data-launch="sound"><span class="ld-eq" aria-hidden="true"><i></i><i></i><i></i></span> Launch with sound</button>
        <button class="ld-go" type="button" data-launch="silent">Launch silently</button>
      </div>
    </div>
  </div>

  <canvas class="journey" data-journey aria-hidden="true"></canvas>
  <MissionHud />

  <!-- 1. WHAT IS NUUKE? -->
  <section class="h-hero container" data-fx="0.5" data-fy="-0.05" data-fs="1.1" data-mfx="0.42" data-mfy="0.52" data-mfs="0.85" data-hud="What is NUUKE?">
    <h1 class="h-q" aria-label="What is NUUKE?">
      <span class="h-w" aria-hidden="true">What</span>
      <span class="h-w" aria-hidden="true">is</span>
      <span class="h-w h-w--brand" aria-hidden="true">NUUKE?</span>
    </h1>
    <p class="h-sub">Scroll. We’ll show you.</p>
    <div class="h-cue" aria-hidden="true"><span></span></div>
  </section>

  <!-- 2. THE ANSWER -->
  <section class="h-answer" data-fx="-0.66" data-fy="0.1" data-fs="0.9" data-mfx="0.6" data-mfy="-0.66" data-mfs="0.5" data-answer data-hud="What is NUUKE?">
    <div class="h-answer-sticky container">
      <p class="t-label">The short answer</p>
      <p class="h-answer-text">
        <span class="visually-hidden">{answerText}</span>
        {answer.map(([w, k]) => <span class:list={['aw', { 'aw--hi': k === 'hi' }]} aria-hidden="true">{w} </span>)}
      </p>
    </div>
  </section>

  <!-- 3. THE MESSAGE -->
  <section class="h-msg" data-fx="0.7" data-fy="-0.42" data-fs="0.55" data-mfx="0.58" data-mfy="-0.3" data-mfs="0.42" data-msg data-hud="Message">
    <p class="h-msg-line h-msg-a" data-msg-a>We don’t design for everyone.</p>
    <p class="h-msg-line h-msg-b" data-msg-b>We design for <span>winners.</span></p>
    <div class="container h-msg-body">
      <p class="t-lead" data-reveal>Our work doesn’t just look good, it works hard. For your goals, your growth, and your long-term brand value. A specialized unit for market domination, not a vendor.</p>
    </div>
  </section>

  <!-- 4. THE FILM -->
  <section class="h-film container" data-fx="-0.82" data-fy="-0.55" data-fs="0.55" data-mfx="0.6" data-mfy="0.3" data-mfs="0.5" data-film data-hud="Film">
    <div class="h-film-sticky">
      <div class="h-film-head" data-film-head>
        <p class="t-label">Seventeen seconds of NUUKE</p>
        <h2 class="t-h2">Clean thinking.<br />Bold output.</h2>
      </div>
      <div class="h-film-stage">
        <figure class="h-screen" data-screen>
          <video data-film-video muted playsinline loop preload="none" poster="/video/intro-poster.jpg" aria-label="NUUKE intro film: clean thinking, bold output, express">
            <source src="/video/intro.webm" type="video/webm" />
            <source src="/video/intro.mp4" type="video/mp4" />
          </video>
        </figure>
        <button type="button" class="h-film-toggle" data-film-toggle aria-pressed="false">Play film</button>
      </div>
    </div>
  </section>

  <!-- 5. SERVICES -->
  <div class="wp" data-fx="0.2" data-fy="0.2" data-fs="0.4" data-fo="0" data-hud="Services" aria-hidden="true"></div>
  <ServicesSystem />
  <div class="wp" data-fx="-0.8" data-fy="-0.6" data-fs="0.45" data-fo="0" aria-hidden="true"></div>

  <!-- 6. WORKS -->
  <section class="h-works" data-fx="0.76" data-fy="0.58" data-fs="0.45" data-mfx="0.72" data-mfy="0.62" data-mfs="0.4" data-works data-hud="Works" aria-labelledby="works-title">
    <div class="h-works-sticky">
      <div class="container h-works-head">
        <p class="t-label">Missions · concept case studies</p>
        <h2 id="works-title" class="t-h1">Works</h2>
        <p class="t-lead">Tap through prototypes, spin the 3D and follow every step from first sketch to launch.</p>
      </div>
      <div class="h-works-track" data-works-track>
        {
          projects.map((p, i) => (
            <a class="h-card" href={`/works/${p.slug}`} style={`--a:${p.accent}`} data-card>
              <ProjectCover project={p} />
              <span class="h-card-meta">
                <span class="t-num h-card-n">{String(i + 1).padStart(2, '0')}</span>
                <span class="chip">{p.disciplineLabel}</span>
              </span>
              <span class="h-card-title">{p.brand}</span>
              <span class="t-small">{p.summary}</span>
            </a>
          ))
        }
        <a class="h-card h-card--all" href="/works"><span class="h-card-title">All works →</span></a>
      </div>
    </div>
  </section>

  <!-- 7. FLIGHT PLAN -->
  <section class="h-plan container" data-fx="0.66" data-fy="0" data-fs="0.8" data-mfx="0.9" data-mfs="0.4" data-mfo="0.45" aria-labelledby="plan-title" data-plan data-hud="Flight plan">
    <div class="h-plan-head">
      <p class="t-label">How we build</p>
      <h2 id="plan-title" class="t-h2">The flight plan.</h2>
      <p class="t-lead">From napkin to App Store in five stages. Every project follows the same countdown.</p>
    </div>
    <ol class="h-stages" role="list">
      {
        stages.map((s) => (
          <li class="h-stage" data-stage>
            <span class="h-stage-n t-num">{s.n}</span>
            <div>
              <h3 class="h-stage-t">{s.t} <span>· {s.s}</span></h3>
              <p class="t-body">{s.d}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- 8. FINALE -->
  <section class="h-finale" data-fx="0" data-fy="0.15" data-fs="0.9" data-finale data-hud="Final approach" aria-labelledby="finale-title">
    <div class="fin-sticky">
      <p class="t-label fin-kicker" data-fin-kicker>Final approach</p>
      <div class="fin-logo-wrap">
        <svg class="fin-logo" viewBox={`0 0 ${logo.w} ${logo.h}`} data-fin-logo aria-hidden="true">
          <defs>
            <radialGradient id="fin-glow" cx="50%" cy="60%" r="50%">
              <stop offset="0" stop-color="#fff3c4" />
              <stop offset="0.35" stop-color="#ffb020" />
              <stop offset="0.7" stop-color="#ff2e88" />
              <stop offset="1" stop-color="#ff2e88" stop-opacity="0" />
            </radialGradient>
            <clipPath id="fin-rest-clip"><rect data-fin-rest-clip x="0" y="0" width="0" height={logo.h} /></clipPath>
          </defs>
          <ellipse class="fin-glow" data-fin-glow cx="362" cy="470" rx="220" ry="330" fill="url(#fin-glow)" />
          <path class="fin-n-line" data-fin-line d={logo.n} pathLength="1" />
          <path class="fin-n" data-fin-n d={logo.n} fill-rule="evenodd" />
          <g clip-path="url(#fin-rest-clip)"><path class="fin-rest" d={logo.rest} fill-rule="evenodd" /></g>
        </svg>
      </div>
      <h2 id="finale-title" class="fin-tag" data-fin-tag>Built for market leaders.</h2>
      <div class="fin-cta" data-fin-cta>
        <a class="btn btn--accent" href="/works">See our work <span class="btn-icon" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="/contact">Start a project <span class="btn-icon" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { gsap, ScrollTrigger, reducedMotion, lenis } from '../scripts/motion';
  import { hasHardwareGL } from '../scripts/gl-support';
  import * as audio from '../scripts/audio';

  const html = document.documentElement;
  const loader = document.querySelector<HTMLElement>('[data-loader]')!;
  const canvas = document.querySelector<HTMLCanvasElement>('[data-journey]')!;
  const finale = document.querySelector<HTMLElement>('[data-finale]')!;
  const logoSvg = document.querySelector<SVGSVGElement>('[data-fin-logo]')!;
  const useGL = !reducedMotion && hasHardwareGL();
  if (useGL) html.classList.add('hj-gl');
  let launched = false;
  try {
    launched = sessionStorage.getItem('nuuke:launched') === '1';
  } catch {}

  // ---------- Score follows the whole journey ----------
  const scoreScroll = () => {
    const max = html.scrollHeight - window.innerHeight;
    audio.setIntensity(0.1 + 0.9 * Math.pow(max > 0 ? window.scrollY / max : 0, 0.9));
  };
  window.addEventListener('scroll', scoreScroll, { passive: true });

  // ---------- Launch sequence ----------
  type J = import('../scripts/three/journey').Journey;
  let journey: J | null = null;
  const showLoader = useGL && !launched;
  const onJourney: ((j: J) => void)[] = [];
  const startJourney = (m: typeof import('../scripts/three/journey'), pad: boolean) => {
    journey = m.initJourney(canvas, { pad, shake: [loader] });
    onJourney.forEach((f) => f(journey!));
    return journey;
  };

  const finishLoader = () => {
    html.classList.remove('is-loading');
    loader.classList.add('is-gone');
    setTimeout(() => (loader.hidden = true), 1200);
    lenis?.start();
    try {
      sessionStorage.setItem('nuuke:launched', '1');
    } catch {}
    ScrollTrigger.refresh();
    heroIn();
  };

  if (showLoader) {
    html.classList.add('is-loading');
    lenis?.stop();
    window.scrollTo(0, 0);
    const barEl = loader.querySelector<HTMLElement>('[data-ld-bar]')!;
    const status = loader.querySelector<HTMLElement>('[data-ld-status]')!;
    const actions = loader.querySelector<HTMLElement>('[data-ld-actions]')!;
    let target = 0.08;
    let shown = 0;
    const t0 = performance.now();
    let last = t0;
    const tick = () => {
      const now = performance.now();
      const minTime = Math.min(1, (now - t0) / 2200);
      shown += (Math.min(target, minTime) - shown) * (1 - Math.exp(-((now - last) / 1000) * 5));
      last = now;
      const p = Math.min(1, shown + 0.001);
      journey?.setLoad(p);
      barEl.style.transform = `scaleX(${p})`;
      if (p > 0.995) {
        actions.hidden = false;
        loader.classList.add('is-ready');
        status.textContent = 'Ready for launch';
        return;
      }
      requestAnimationFrame(tick);
    };
    tick();
    document.fonts?.ready.then(() => (target = Math.max(target, 0.35)));
    import('../scripts/three/journey').then((m) => {
      startJourney(m, true);
      target = Math.max(target, 0.7);
      requestAnimationFrame(() => loader.classList.add('is-scene'));
      const done = () => (target = 1);
      document.readyState === 'complete' ? done() : window.addEventListener('load', done);
    });
    const skipEvents = ['wheel', 'touchstart', 'keydown', 'pointerdown'] as const;
    const skip = () => journey?.skip();
    loader.querySelectorAll<HTMLButtonElement>('[data-launch]').forEach((b) =>
      b.addEventListener('click', async () => {
        if (loader.classList.contains('is-launching') || !journey) return;
        // iOS asks for motion access only inside a tap; the scene tilts with the phone.
        const DOE = window.DeviceOrientationEvent as unknown as { requestPermission?: () => Promise<string> } | undefined;
        DOE?.requestPermission?.().catch(() => {});
        try {
          navigator.vibrate?.([40, 60, 80, 50, 140, 40, 260, 30, 600]);
        } catch {}
        if (b.dataset.launch === 'sound') audio.enable(0);
        loader.classList.add('is-launching');
        status.textContent = 'Launching';
        (document.activeElement as HTMLElement | null)?.blur();
        setTimeout(() => skipEvents.forEach((ev) => window.addEventListener(ev, skip, { passive: true })), 400);
        await journey.launch();
        skipEvents.forEach((ev) => window.removeEventListener(ev, skip));
        finishLoader();
      }),
    );
  } else {
    loader.hidden = true;
    audio.resumeOnFirstGesture();
    if (useGL) import('../scripts/three/journey').then((m) => startJourney(m, false).skipLaunch());
    else canvas.hidden = true;
  }

  // ---------- Section motion ----------
  let heroDone = false;
  function heroIn() {
    if (heroDone || reducedMotion) return;
    heroDone = true;
    gsap.fromTo('.h-w', { yPercent: 110, rotate: 4, opacity: 0 }, { yPercent: 0, rotate: 0, opacity: 1, duration: 1.4, ease: 'expo.out', stagger: 0.12, delay: 0.15 });
    gsap.fromTo('.h-sub, .h-cue', { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 1.2, ease: 'expo.out', stagger: 0.1, delay: 0.55 });
  }
  if (!reducedMotion) {
    if (showLoader) gsap.set('.h-w, .h-sub, .h-cue', { opacity: 0 });
    else heroIn();
    gsap.to('.h-hero', { yPercent: -15, opacity: 0, ease: 'none', scrollTrigger: { trigger: '.h-hero', start: 'top top', end: 'bottom top', scrub: true } });

    // The answer lights up word by word.
    const words = document.querySelectorAll('.aw');
    gsap.fromTo(words, { color: '#5d5d66' }, { color: (i: number) => (words[i].classList.contains('aw--hi') ? '#ff2e88' : '#f5f5f6'), stagger: 0.12, ease: 'none', scrollTrigger: { trigger: '[data-answer]', start: 'top 70%', end: 'bottom 80%', scrub: 0.4 } });

    // The message: two lines slide past each other.
    gsap.fromTo('[data-msg-a]', { xPercent: -30 }, { xPercent: 12, ease: 'none', scrollTrigger: { trigger: '[data-msg]', start: 'top bottom', end: 'bottom top', scrub: true } });
    gsap.fromTo('[data-msg-b]', { xPercent: 30 }, { xPercent: -14, ease: 'none', scrollTrigger: { trigger: '[data-msg]', start: 'top bottom', end: 'bottom top', scrub: true } });

    // The film screen flattens as it arrives (static layout only; with 3D it lives in the porthole).
    if (!useGL) gsap.fromTo('[data-screen]', { rotateX: 28, rotateY: -14, scale: 0.82 }, { rotateX: 0, rotateY: 0, scale: 1, ease: 'none', scrollTrigger: { trigger: '[data-film]', start: 'top bottom', end: 'center 55%', scrub: true } });

    // Works: horizontal cover-flow.
    const works = document.querySelector<HTMLElement>('[data-works]')!;
    const track = document.querySelector<HTMLElement>('[data-works-track]')!;
    const cards = [...track.querySelectorAll<HTMLElement>('.h-card')];
    const dist = () => track.scrollWidth - window.innerWidth + 80;
    gsap.to(track, {
      x: () => -dist(),
      ease: 'none',
      scrollTrigger: {
        trigger: works,
        start: 'top top',
        end: () => `+=${dist()}`,
        pin: '.h-works-sticky',
        scrub: 0.6,
        invalidateOnRefresh: true,
        onUpdate: () => {
          const mid = window.innerWidth / 2;
          cards.forEach((c) => {
            const r = c.getBoundingClientRect();
            const d = (r.left + r.width / 2 - mid) / window.innerWidth;
            c.style.transform = `perspective(1200px) rotateY(${d * -28}deg) translateZ(${-Math.abs(d) * 160}px)`;
          });
        },
      },
    });

    // Flight plan stages ignite as they pass the middle.
    document.querySelectorAll<HTMLElement>('[data-stage]').forEach((s) =>
      ScrollTrigger.create({ trigger: s, start: 'top 62%', end: 'bottom 38%', toggleClass: 'is-lit' }),
    );
  }

  // ---------- Film ----------
  const filmSec = document.querySelector<HTMLElement>('[data-film]')!;
  const filmHead = filmSec.querySelector<HTMLElement>('[data-film-head]')!;
  const screen = filmSec.querySelector<HTMLElement>('[data-screen]')!;
  const video = document.querySelector<HTMLVideoElement>('[data-film-video]')!;
  const filmBtn = document.querySelector<HTMLButtonElement>('[data-film-toggle]')!;
  let userPaused = false;
  const setFilm = (play: boolean) => {
    if (play) {
      video.preload = 'auto';
      video.play().catch(() => {});
    } else video.pause();
    filmBtn.textContent = play ? 'Pause film' : 'Play film';
    filmBtn.setAttribute('aria-pressed', String(play));
  };
  filmBtn.addEventListener('click', () => {
    userPaused = !video.paused;
    setFilm(video.paused);
  });
  if (useGL) {
    // The film plays inside the rocket's porthole, then the window opens up.
    let filmP = 0;
    let filmOn = false;
    const ease = (x: number) => (x <= 0 ? 0 : x >= 1 ? 1 : x * x * (3 - 2 * x));
    const setActive = (on: boolean) => {
      if (on === filmOn) return;
      filmOn = on;
      filmSec.classList.toggle('is-active', on);
      if (on && !userPaused) setFilm(true);
      if (!on) setFilm(false);
    };
    ScrollTrigger.create({
      trigger: filmSec,
      start: 'top top',
      end: 'bottom bottom',
      onUpdate: (st) => {
        filmP = st.progress;
        journey?.setFilm(filmP);
        setActive(filmP > 0.001 && filmP < 0.999);
      },
      onLeave: () => (journey?.setFilm(1), setActive(false)),
      onLeaveBack: () => (journey?.setFilm(0), setActive(false)),
    });
    // Screen size is measured on resize, not per frame (a layout read after GSAP's style
    // writes would force a synchronous layout every frame). Styles are written only on change.
    let W = 0;
    let H = 0;
    new ResizeObserver(() => {
      W = screen.offsetWidth;
      H = screen.offsetHeight;
    }).observe(screen);
    const last: Record<string, string> = {};
    const put = (el: HTMLElement, k: 'transform' | 'clipPath' | 'opacity', key: string, v: string) => {
      if (last[key] === v) return;
      last[key] = v;
      el.style[k] = v;
    };
    onJourney.push((j) =>
      j.onPorthole((f) => {
        if (!filmOn) return;
        if (!W || !H) {
          W = screen.offsetWidth;
          H = screen.offsetHeight;
        }
        if (!W || !H) return;
        const cx = window.innerWidth / 2;
        const cy = window.innerHeight / 2 - 12;
        const k1 = ease(f.open * 2);
        const k2 = ease(f.open * 2 - 1);
        const s = (2 * f.r) / H + (1 - (2 * f.r) / H) * k1;
        const tx = (f.x - cx) * (1 - k1);
        const ty = (f.y - cy) * (1 - k1);
        const inset = ((W - H) / 2) * (1 - k2);
        const round = H / 2 + (18 - H / 2) * k2;
        const vis = f.visible ? ease((f.facing - 0.35) / 0.35) : 0;
        put(screen, 'transform', 'st', `translate(${tx.toFixed(1)}px, ${ty.toFixed(1)}px) scale(${s.toFixed(4)})`);
        put(screen, 'clipPath', 'sc', `inset(0px ${inset.toFixed(1)}px round ${round.toFixed(1)}px)`);
        put(screen, 'opacity', 'so', Math.max(vis, k1).toFixed(3));
        // The heading steps aside once the camera is close to the hull.
        put(filmHead, 'opacity', 'ho', Math.min(1, Math.max(0, 1 - f.near * 1.6)).toFixed(3));
        const bottom = cy + ty + (H / 2) * s;
        put(filmBtn, 'transform', 'bt', `translate(calc(-50% + ${tx.toFixed(1)}px), ${(bottom + 18).toFixed(1)}px)`);
        put(filmBtn, 'opacity', 'bo', Math.max(0.0001, Math.max(vis * ease((f.r - 14) / 20), k1)).toFixed(4));
      }),
    );
  } else {
    new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (e.isIntersecting && !userPaused && !reducedMotion) setFilm(true);
          else if (!e.isIntersecting) setFilm(false);
        }),
      { threshold: 0.45 },
    ).observe(video);
  }

  // ---------- Finale: warp jump, then the rocket flies home into the "n" ----------
  const line = finale.querySelector<SVGPathElement>('[data-fin-line]')!;
  const nFill = finale.querySelector<SVGPathElement>('[data-fin-n]')!;
  const glow = finale.querySelector<SVGEllipseElement>('[data-fin-glow]')!;
  const restClip = finale.querySelector<SVGRectElement>('[data-fin-rest-clip]')!;
  const tag = finale.querySelector<HTMLElement>('[data-fin-tag]')!;
  const cta = finale.querySelector<HTMLElement>('[data-fin-cta]')!;
  const kicker = finale.querySelector<HTMLElement>('[data-fin-kicker]')!;
  const W = 3232;
  const H = 736;
  const cutout = { x: 362, y: 448, h: 312, tilt: -0.17 };
  let climaxed = false;
  const range = (p: number, a: number, b: number) => Math.min(1, Math.max(0, (p - a) / (b - a)));
  const setFinale = (p: number) => {
    line.style.strokeDashoffset = String(1 - range(p, 0.02, 0.4));
    nFill.style.opacity = String(range(p, 0.7, 0.86));
    glow.style.opacity = String(range(p, 0.6, 0.78) * (1 - range(p, 0.92, 1) * 0.6));
    restClip.setAttribute('width', String(W * range(p, 0.84, 0.97)));
    kicker.style.opacity = String(1 - range(p, 0.6, 0.75));
    tag.classList.toggle('is-in', p > 0.9);
    cta.classList.toggle('is-in', p > 0.93);
    if (p > 0.03 && !climaxed) {
      climaxed = true;
      audio.cueClimax();
    }
    if (journey) {
      const r = logoSvg.getBoundingClientRect();
      const sx = r.width / W;
      journey.setFinale(p, p > 0 ? { x: r.left + cutout.x * sx, y: r.top + cutout.y * sx, h: cutout.h * sx, tilt: cutout.tilt } : null);
    }
  };
  const warpIn = () => {
    if (!journey || finale.classList.contains('is-dropped') || finale.classList.contains('is-warping')) return;
    finale.classList.add('is-warping');
    journey.warp(() => {
      finale.classList.remove('is-warping');
      finale.classList.add('is-dropped');
    });
  };
  if (reducedMotion) setFinale(1);
  else
    ScrollTrigger.create({
      trigger: finale,
      start: 'top top',
      end: 'bottom bottom',
      onUpdate: (st) => setFinale(st.progress),
      onEnter: warpIn,
      onLeaveBack: () => {
        setFinale(0);
        journey?.resetWarp();
        finale.classList.remove('is-warping', 'is-dropped');
      },
    });
  setFinale(reducedMotion ? 1 : 0);
</script>

