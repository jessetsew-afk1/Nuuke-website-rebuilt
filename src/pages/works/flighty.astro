  </Chapter>

  <Chapter id="test" n="08" label="Making of · Usability test" title="Watch a tester get lost. Then watch them not." intro="We test before we polish. This replay shows the method: taps build a heatmap, the dashed line is the path, the ticks on the scrubber are taps (red = misclick). Switch tasks, then flip to <strong>After · v2</strong> to see the redesigned screen take the same test.">
    <TestReplay />
  </Chapter>

  <Chapter id="passport" n="09" label="Passport" title="A year of flying, drawn as great circles." intro="Passport is where Flighty turns a year of travel into something you want to share. We prototyped a richer version as a 3D globe. Drag it, or pick a route.">
    <PassportGlobe />
  </Chapter>

  <Chapter id="system" n="10" label="Design system" title="A departure board at night: colour only ever means status.">
    <DesignSystem
      colors={[
        { name: 'Night', hex: '#0B0B0F', use: 'Base background, like a board at night' },
        { name: 'Board', hex: '#15151C', use: 'Cards and sheets' },
        { name: 'Flap', hex: '#1E1E27', use: 'Tiles, tracks, inactive rings' },
        { name: 'Signage', hex: '#F5F5F0', use: 'Primary text and codes' },
        { name: 'On time', hex: '#2EE58A', use: 'On time, boarding, landed' },
        { name: 'Delayed', hex: '#FFB020', use: 'Delays and changes, always with a word' },
        { name: 'Cancelled', hex: '#FF5A5A', use: 'Cancelled or diverted, then the next step' },
        { name: 'In the air', hex: '#6CB4FF', use: 'Live progress, friends’ flights' },
      ]}
      type={[
        { role: 'Airport codes', sample: 'ORD → SFO', spec: 'System sans (SF-style) Heavy · 44/44', style: 'font-family:-apple-system,system-ui,Inter,sans-serif;font-weight:800;font-size:2.6rem;letter-spacing:-0.01em' },
        { role: 'Times', sample: '14:05 → 14:53', spec: 'System sans Bold · tabular numerals · 28', style: 'font-family:-apple-system,system-ui,Inter,sans-serif;font-weight:700;font-size:1.75rem;font-variant-numeric:tabular-nums' },
        { role: 'Status', sample: 'DELAYED 48 MIN', spec: 'Inter 800 · 13 · +0.08em', style: 'font-family:Inter;font-weight:800;font-size:.85rem;letter-spacing:.08em;color:#FFB020' },
        { role: 'Body', sample: 'Your plane is late out of Denver.', spec: 'System sans 400 · 15/21', style: 'font-family:-apple-system,system-ui,Inter,sans-serif;font-size:1rem' },
