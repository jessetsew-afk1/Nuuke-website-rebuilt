  <Chapter id="measure" n="11" label="Ship & measure" title="How we’d know it worked.">
    <Metrics
      metrics={[
        { name: 'Head start', hypothesis: 'Users hear about delays meaningfully earlier than the airline’s own update, on most delayed flights.', how: 'First alert timestamp vs. the airline’s first status change, per delayed flight.' },
        { name: 'One-second read', hypothesis: 'At least 9 in 10 testers read gate and time from the Live Activity in a one-second glance.', how: 'The glance test from chapter 07, run per state in moderated sessions.' },
        { name: 'Calm cancellations', hypothesis: 'After a cancellation, people reach rebooking options faster and contact support less.', how: 'Time from cancel alert to rebook tap; rebook completion; a short stress rating.' },
        { name: 'Shared, not bought', hypothesis: 'Passport posters and Friends invites bring new installs without paid media.', how: 'Share-sheet completions and installs attributed to share links.' },
      ]}
    />
