---
import Case from '../../layouts/Case.astro';
import Chapter from '../../components/case/Chapter.astro';
import Brief from '../../components/case/Brief.astro';
import Personas from '../../components/case/Personas.astro';
import JourneyMap from '../../components/case/JourneyMap.astro';
import FlowMap from '../../components/case/FlowMap.astro';
import ScreenStack from '../../components/case/ScreenStack.astro';
import Prototype from '../../components/case/Prototype.astro';
import DesignSystem from '../../components/case/DesignSystem.astro';
import Metrics from '../../components/case/Metrics.astro';
import HeroPoster from '../../components/cases/flighty/HeroPoster.astro';
import Opening from '../../components/cases/flighty/Opening.astro';
import Itinerary from '../../components/cases/flighty/Itinerary.astro';
import LiveBench from '../../components/cases/flighty/LiveBench.astro';
import TestReplay from '../../components/cases/flighty/TestReplay.astro';
import PassportGlobe from '../../components/cases/flighty/PassportGlobe.astro';
import { bySlug } from '../../data/projects';
import { flightyLayers } from '../../data/cases/flighty';

const p = bySlug('flighty');
const chapters = [
  { id: 'brief', label: 'Brief' },
  { id: 'research', label: 'Research' },
  { id: 'journey', label: 'Journey' },
  { id: 'flow', label: 'User flow' },
  { id: 'layers', label: '3D wireframe' },
  { id: 'prototype', label: 'Prototype' },
  { id: 'live', label: 'Live Activity' },
  { id: 'test', label: 'Usability test' },
  { id: 'passport', label: 'Passport globe' },
  { id: 'system', label: 'Design system' },
  { id: 'measure', label: 'Measure' },
];
const sources = [
  { label: 'Wikipedia — Flighty', url: 'https://en.wikipedia.org/wiki/Flighty' },
  { label: 'Mercury — Flighty case study', url: 'https://mercury.com/blog/flighty-app-case-study' },
  { label: 'Apple — Behind the Design: Flighty', url: 'https://developer.apple.com/news/?id=970ncww4' },
  { label: 'Apple Design Awards 2023', url: 'https://developer.apple.com/design/awards/2023/' },
  { label: 'Apple Newsroom — 2023 ADA winners', url: 'https://www.apple.com/newsroom/2023/06/apple-announces-winners-of-the-2023-apple-design-awards/' },
  { label: 'Flighty — homepage', url: 'https://flighty.com' },
  { label: 'Flighty — pricing', url: 'https://flighty.com/pricing' },
  { label: 'Flighty — Android waitlist', url: 'https://flighty.com/android-waitlist' },
  { label: 'App Store — Flighty', url: 'https://apps.apple.com/us/app/flighty-live-flight-tracker/id1358823008' },
  { label: 'Simple Flying — interview', url: 'https://simpleflying.com/flighty-app-interview/' },
];
const meta = [
  { label: 'Brand', value: 'Flighty · live flight tracker' },
  { label: 'Discipline', value: 'Mobile app · UX/UI' },
  { label: 'Our role', value: 'Research, flows, prototype, Live Activities, usability testing' },
  { label: 'Timeline (concept)', value: '4-week design sprint' },
];
const personas = [
  {
    name: 'Road-warrior Ana',
    meta: '38 · consultant · ~80 legs a year',
    quote: 'If it’s going to be late, I want to know before the queue at the gate does.',
    goals: ['Rebook before everyone else', 'The reason, not just the word “delayed”', 'Gate and time without unlocking'],
    pains: ['Status that says “on time” until it doesn’t', 'Five apps for one trip', 'Alerts that bury the next step'],
    color: '#ffb020',
  },
  {
    name: 'Pickup-duty Tom',
    meta: '55 · collects family at arrivals',
    quote: 'I don’t need the flight. I need to know when to leave the house.',
    goals: ['One “leave by” time', 'A ping when they land', 'Which terminal and belt'],
    pains: ['Airport maps', 'Refreshing a web page in the car', 'Jargon like “block time”'],
    color: '#2ee58a',
  },
  {
    name: 'AvGeek Jordan',
    meta: '26 · counts tail numbers',
    quote: 'Which plane is it, and where has it been today?',
    goals: ['Aircraft history and type', 'A year-in-flight poster to share', 'Seeing the inbound plane live'],
    pains: ['Stats hidden behind menus', 'Ugly share images', 'Losing old trips'],
    color: '#6cb4ff',
  },
];
const stages = [
  { label: 'Booking', doing: 'Forwards the confirmation email.', feeling: 'Fine. One more trip.', score: 0.5, opportunity: 'Import from email, calendar or TripIt. The flight appears without typing a single code.' },
  { label: 'Morning of', doing: 'Checks the airline app: on time.', feeling: 'Cautiously fine.', score: 0.3, opportunity: 'Watch the inbound plane. “Your plane is 48 min late in Denver” lands hours before the airline says so.' },
  { label: 'To the airport', doing: 'Decides whether to leave early.', feeling: 'Second-guessing.', score: -0.6, opportunity: 'A “leave by” time based on the predicted departure, not the schedule.' },
  { label: 'At the gate', doing: 'Gate changes; the board flips to DELAYED.', feeling: 'Frustrated, stuck in a crowd.', score: -1.7, opportunity: 'A gate-change alert with walk time, the reason in plain words, and rebooking one tap away.' },
  { label: 'In the air', doing: 'Phone in flight mode, family waiting.', feeling: 'Settled.', score: 0.6, opportunity: 'The Live Activity keeps the flight clock on the lock screen; Friends show Tom a live ETA.' },
  { label: 'Landing', doing: 'Finds the connection and the bags.', feeling: 'Relief.', score: 1.2, opportunity: 'Arrival gate and baggage belt the moment the wheels touch down.' },
  { label: 'Year end', doing: 'Shares the Passport poster.', feeling: 'Proud, a bit nerdy.', score: 1.8, opportunity: 'A richer poster that is safe to share: routes and totals, no dates or seat numbers.' },
];
const nodes = [
  { id: 'home', label: 'My flights', x: 90, y: 200, kind: 'start' as const },
  { id: 'add', label: 'Add flight', x: 280, y: 80 },
  { id: 'friends', label: 'Friends', x: 280, y: 290 },
  { id: 'passport', label: 'Passport', x: 280, y: 380 },
  { id: 'flight', label: 'Flight card', x: 490, y: 200, kind: 'key' as const },
  { id: 'delay', label: 'Why it’s late', x: 710, y: 60 },
  { id: 'timeline', label: 'Live timeline', x: 710, y: 160 },
  { id: 'gate', label: 'Gate change', x: 710, y: 260 },
  { id: 'live', label: 'Lock screen', x: 710, y: 360, kind: 'end' as const },
  { id: 'inbound', label: 'Where’s my plane', x: 930, y: 110 },
];
const edges = [
  { from: 'home', to: 'add', label: '+' },
  { from: 'add', to: 'flight' },
  { from: 'home', to: 'flight' },
  { from: 'home', to: 'friends' },
  { from: 'home', to: 'passport' },
  { from: 'flight', to: 'delay', label: 'Why?' },
  { from: 'flight', to: 'timeline' },
  { from: 'flight', to: 'gate' },
  { from: 'flight', to: 'live' },
  { from: 'delay', to: 'inbound' },
  { from: 'timeline', to: 'inbound' },
];
const tasks = [
  { label: 'Add today’s flight', screen: 'add' },
  { label: 'Open the flight card', screen: 'flight' },
  { label: 'Find out why it’s late', screen: 'delay' },
  { label: 'Follow the live timeline', screen: 'timeline' },
  { label: 'Catch the gate change', screen: 'gate' },
  { label: 'Find where your plane is', screen: 'inbound' },
  { label: 'See it on the lock screen', screen: 'live' },
  { label: 'Check a friend’s flight', screen: 'friends' },
  { label: 'Open your Passport', screen: 'passport' },
];
const timeline = [
  { t: '08:10', k: 'late', title: 'Delay predicted', sub: 'Your plane is 48 min late in Denver', go: 'delay' },
  { t: '09:30', k: 'late', title: 'ATC ground delay at Denver', sub: 'Departures held about 45 min' },
  { t: '12:03', k: 'ok', title: 'Your plane leaves Denver', sub: '48 min behind schedule' },
  { t: '13:20', k: 'late', title: 'Airline posts the delay', sub: '5h 10m after you knew' },
  { t: '13:58', k: 'sky', title: 'Gate change: B12 → C4', sub: 'Terminal 1 · 9 min walk', go: 'gate' },
  { t: '14:18', k: 'next', title: 'Plane lands at ORD', sub: 'Predicted' },
  { t: '14:28', k: 'next', title: 'Boarding', sub: 'Gate C4' },
  { t: '14:53', k: 'next', title: 'Departs for SFO', sub: 'Lands 17:26' },
];
---

<Case project={p} chapters={chapters} sources={sources} meta={meta}>
  <HeroPoster slot="hero" />

  <Opening />

  <Chapter id="brief" n="01" label="The brief · Discover" title="Make bad news feel boringly obvious.">
    <Brief
      story="Flighty is a flight tracker for iPhone, iPad, Mac, Apple Watch and Apple Vision, founded by <strong>Ryan Jones</strong>, a former Apple operations employee. A six-hour delay pushed him to tweet that he’d build something better himself; his co-founders came from the replies. It launched in <strong>2019</strong> and combines live flight data with FAA and air-traffic-control data. The promise is simple: <em>delay alerts that arrive faster than the airline’s own</em>. The team’s own bar: <em>“work so well that it feels almost boringly obvious.”</em>"
      facts={[
        { v: '2019', k: 'Launched, after about 18 months of beta with frequent flyers and pilots (Mercury)' },
        { v: 'ADA ’23', k: 'Apple Design Award winner, Interaction category' },
        { v: 'Finalist', k: 'App Store Awards 2023, App of the Year' },
        { v: '~10', k: 'People across seven countries; bootstrapped, no VC (Mercury)' },
        { v: '3M+', k: 'Users, per Flighty’s homepage (Mercury reports a higher figure)' },
        { v: '4.8', k: 'App Store rating from about 155K ratings (snapshot)' },
      ]}
      problems={[
        { title: 'Calm under bad news', text: 'A cancellation or diversion has to feel urgent but never panicky, and lead with the next action: rebook.' },
        { title: 'One hierarchy, every surface', text: 'Watch, Live Activity, widget and Mac each need the same reading order: one line per flight, like a departure board.' },
        { title: 'Shareable by design', text: 'Flighty grows without paid marketing. Passport and Friends could become richer, privacy-safe moments worth sharing.' },
      ]}
      goal="Every surface answers two questions in one glance: is my flight OK, and what do I do next?"
    />
    <Itinerary />
  </Chapter>

  <Chapter id="research" n="02" label="Research" title="Three travellers, one departure board." intro="We built personas from Flighty’s public audience: frequent flyers, business travellers, aviation fans and the families who track them. Then we studied the interface every traveller already knows how to read.">
    <Personas personas={personas} />
    <h3 class="t-h4 fl-sub">What airport signage already solved</h3>
    <div class="fl-sign" data-stagger="0.1">
      <article class="fl-sign-card fl-sign-card--quote">
        <p class="fl-sign-q">“They’ve had 50 years of figuring out what’s important.”</p>
        <p class="t-small">Flighty’s team on airport boards, in Apple’s Behind the Design. We treat that as a design brief.</p>
      </article>
      <article class="fl-sign-card">
        <span class="fl-sign-demo" aria-hidden="true"><b>14:05</b> SFO <i>DELAYED</i></span>
        <h4 class="fl-sign-h">One line per flight</h4>
        <p class="t-small">The departure-board analogy Flighty is known for. If it can’t fit a board row, it isn’t the headline.</p>
      </article>
      <article class="fl-sign-card">
        <span class="fl-sign-demo fl-sign-demo--ring" aria-hidden="true"><i></i></span>
        <h4 class="fl-sign-h">A circle for progress</h4>
        <p class="t-small">Apple notes the Dynamic Island uses a simple circular chart for flight progress. We extend it into a flight clock.</p>
      </article>
    </div>
    <h3 class="t-h4 fl-sub">How we’d validate it</h3>
    <ol class="fl-plan" role="list" data-stagger="0.08">
      <li><span class="t-num">A</span><b>Gate-side interviews</b><span>6 travellers at 2 airports, met during real delays.</span></li>
      <li><span class="t-num">B</span><b>Two-trip diary study</b><span>Screenshots of every alert that helped or annoyed.</span></li>
      <li><span class="t-num">C</span><b>Airline-app teardown</b><span>Where each one hides the reason for a delay.</span></li>
      <li><span class="t-num">D</span><b>Moderated usability test</b><span>5 people, 3 tasks, v1 against v2. Replayed in chapter 08.</span></li>
    </ol>
  </Chapter>

  <Chapter id="journey" n="03" label="Journey map" title="A travel day, from inbox to baggage belt." intro="Ana’s day with a delayed flight. Tap each moment to see what she’s doing, how she feels, and where the app can step in. The low point is the gate. That’s the moment to design for first.">
    <JourneyMap stages={stages} />
  </Chapter>

  <Chapter id="flow" n="04" label="User flow" title="Ten screens around one flight card." intro="Everything branches from the <strong>flight card</strong>: the reason, the timeline, the gate and the plane itself. Tap any screen to open it in the live prototype.">
    <FlowMap nodes={nodes} edges={edges} width={1100} height={430} />
  </Chapter>

  <Chapter id="layers" n="05" label="3D wireframe" title="Take the flight card apart." intro="Five layers, from grid to motion. Scroll and the exploded view assembles into the final card. Drag to look around it.">
    <ScreenStack layers={flightyLayers} accent={p.accent} />
  </Chapter>

  <Chapter id="prototype" n="06" label="Prototype" title="Tap through a delayed travel day." intro="FL 214, Chicago to San Francisco, running late. Follow the journey on the left, and switch between <strong>Sketch</strong>, <strong>Wireframe</strong> and <strong>Hi-fi</strong> to see how each screen evolved.">
    <Prototype title="FL 214 · travel day" start="home" tasks={tasks} note="Nine tasks, ten screens. Everything you can tap glows when you turn on tap targets.">
      <!-- My flights -->
      <section class="scr fl-s" data-screen="home" data-title="My flights">
        <div class="fl-scroll" data-scroll>
          <div class="fl-pad fl-top">
            <div class="fl-head">
              <h4 class="t fl-h1">My Flights</h4>
              <button class="ui fl-plus" data-go="add" aria-label="Add a flight"><span class="ico fl-plus-i">+</span></button>
            </div>
            <button class="ui fl-today" data-go="flight">
              <span class="fl-today-top"><span class="t fl-kick">Today · FL 214</span><span class="t fl-chip fl-chip--late">Delayed 48m</span></span>
              <span class="fl-today-route">
                <span class="t fl-code">ORD</span>
                <svg class="img fl-today-arc" viewBox="0 0 120 30" aria-hidden="true"><path d="M4 26 Q60 -6 116 26" fill="none" stroke="#3a3a46" stroke-width="2" stroke-dasharray="3 4" /><circle cx="4" cy="26" r="4" fill="#ffb020" /></svg>
                <span class="t fl-code">SFO</span>
              </span>
              <span class="fl-today-times"><span class="t"><s>14:05</s> <b class="fl-amb">14:53</b></span><span class="t"><s>16:38</s> <b class="fl-amb">17:26</b></span></span>
              <span class="t fl-today-note">Gate C4 (was B12) · boarding 14:28</span>
            </button>
            <p class="t fl-kick fl-mt">Upcoming</p>
            <div class="ui fl-boardlist">
              {[
                ['Thu 9', 'SFO → SEA', 'On time', 'ok'],
                ['Fri 10', 'SEA → ORD', 'Cancelled', 'cx'],
                ['Mon 20', 'ORD → JFK', 'Scheduled', 'mute'],
              ].map(([d, r, s, k]) => (
                <div class="fl-brd">
                  <span class="t fl-brd-d">{d}</span>
                  <span class="t fl-brd-r">{r}</span>
                  <span class={`t fl-chip fl-chip--${k}`}>{s}</span>
                </div>
              ))}
            </div>
            <button class="ui fl-row" data-go="friends">
              <span class="ico fl-dot fl-dot--sky"></span>
              <span><span class="t fl-row-t">Maya is in the air</span><br /><span class="t fl-row-s">AUS → ORD · lands 15:12</span></span>
              <span class="t fl-chev">›</span>
            </button>
          </div>
        </div>
        <nav class="fl-tabs ui">
          <button class="is-on" data-go="home"><span class="ico"></span><span class="t">Flights</span></button>
          <button data-go="friends"><span class="ico"></span><span class="t">Friends</span></button>
          <button data-go="passport"><span class="ico"></span><span class="t">Passport</span></button>
        </nav>
      </section>

      <!-- Add flight -->
      <section class="scr fl-s" data-screen="add" data-title="Add a flight">
        <div class="fl-pad fl-top">
          <button class="fl-back t" data-back>‹ Cancel</button>
          <h4 class="t fl-h2">Add a flight</h4>
          <div class="ui fl-search"><span class="ico fl-search-i"></span><span class="t">FL 214</span><span class="fl-caret"></span></div>
          <div class="fl-chips">
            <button class="ui fl-pill is-on" data-toggle><span class="t">Today</span></button>
            <button class="ui fl-pill" data-toggle><span class="t">Tomorrow</span></button>
            <button class="ui fl-pill" data-toggle><span class="t">Pick a date</span></button>
          </div>
          <button class="ui fl-result" data-go="flight">
            <span class="t fl-row-t">FL 214 · 14:05</span>
            <span class="t fl-row-s">Chicago O’Hare → San Francisco</span>
            <span class="t fl-chip fl-chip--late">Running late</span>
          </button>
          <p class="t fl-kick fl-mt">Or let it find you</p>
          <div class="fl-grid3">
            <button class="ui fl-imp" data-toggle><span class="ico fl-imp-i"></span><span class="t">Email</span></button>
            <button class="ui fl-imp" data-toggle><span class="ico fl-imp-i"></span><span class="t">Calendar</span></button>
            <button class="ui fl-imp" data-toggle><span class="ico fl-imp-i"></span><span class="t">TripIt</span></button>
          </div>
          <p class="t fl-p">Forward a confirmation email and the flight shows up on its own, usually before you’ve closed the mail app.</p>
        </div>
        <div class="fl-pad fl-bottom">
          <button class="btn fl-cta" data-go="flight"><span class="t">Add FL 214</span></button>
        </div>
      </section>

      <!-- Flight card -->
      <section class="scr fl-s" data-screen="flight" data-title="Flight card">
        <div class="fl-scroll fl-scroll--full" data-scroll>
          <div class="fl-pad fl-top">
            <div class="fl-head"><button class="fl-back t" data-back>‹ My Flights</button><span class="t fl-kick">FL 214 · Wed 8 Oct</span></div>
            <div class="fl-route">
              <div><span class="t fl-giant">ORD</span><span class="t fl-row-s">Chicago</span></div>
              <svg class="img fl-route-plane" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12 L9 10 L13 3 L15.5 3 L13.5 10 L19 10 L21 7 L22.5 7 L21.5 12 L22.5 17 L21 17 L19 14 L13.5 14 L15.5 21 L13 21 L9 14 Z" fill="#f5f5f0" /></svg>
              <div class="fl-r"><span class="t fl-giant">SFO</span><span class="t fl-row-s">San Francisco</span></div>
            </div>
            <div class="fl-times">
              <div><span class="t fl-row-s">Departs</span><span class="t fl-time"><s>14:05</s> <b class="fl-amb">14:53</b></span></div>
              <div class="fl-r"><span class="t fl-row-s">Arrives</span><span class="t fl-time"><s>16:38</s> <b class="fl-amb">17:26</b></span></div>
            </div>
            <button class="ui fl-status" data-go="delay" data-sheet>
              <span><span class="t fl-status-t">Delayed 48 min</span><br /><span class="t fl-status-s">Your plane is late in Denver</span></span>
              <span class="t fl-status-why">Why? ›</span>
            </button>
            <div class="ui fl-arc-card">
              <svg class="img fl-arc" viewBox="0 0 300 90" aria-hidden="true">
                <path d="M14 80 Q150 -20 286 80" fill="none" stroke="#2a2a35" stroke-width="5" stroke-linecap="round" />
                <circle cx="14" cy="80" r="7" fill="#ffb020" /><circle cx="286" cy="80" r="5" fill="#3a3a46" />
              </svg>
              <span class="t fl-row-s">On the ground · 4h 12m flight · 1,846 mi</span>
            </div>
            <div class="fl-grid2">
              <button class="ui fl-tile" data-go="gate"><span class="t fl-row-s">Gate</span><span class="t fl-tile-n"><s>B12</s> <b class="fl-amb">C4</b></span></button>
              <div class="ui fl-tile"><span class="t fl-row-s">Terminal</span><span class="t fl-tile-n">1</span></div>
              <div class="ui fl-tile"><span class="t fl-row-s">Boarding</span><span class="t fl-tile-n">14:28</span></div>
              <div class="ui fl-tile"><span class="t fl-row-s">Seat</span><span class="t fl-tile-n">14A</span></div>
            </div>
            {[
              ['timeline', 'Live timeline', '8 updates today', 'late'],
              ['inbound', 'Where’s my plane?', 'In Denver · leaves 12:03', 'sky'],
              ['live', 'Show on Lock Screen', 'Live Activity is on', 'ok'],
              ['friends', 'Share with Tom', 'He sees your ETA, nothing else', 'mute'],
            ].map(([go, t, s, k]) => (
              <button class="ui fl-row" data-go={go}>
                <span class={`ico fl-dot fl-dot--${k}`}></span>
                <span><span class="t fl-row-t">{t}</span><br /><span class="t fl-row-s">{s}</span></span>
                <span class="t fl-chev">›</span>
              </button>
            ))}
          </div>
        </div>
      </section>

      <!-- Delay sheet -->
      <section class="scr fl-s fl-sheet-scr" data-screen="delay" data-title="Why it’s late (sheet)">
        <div class="fl-sheet ui">
          <div class="fl-grabber"></div>
          <p class="t fl-kick">Why it’s late · predicted 08:10</p>
          <h4 class="t fl-h2">Your plane is 48 min late in Denver</h4>
          <p class="t fl-p">An air-traffic-control ground delay is holding it at DEN. It should leave around 12:03 your time, land here at 14:18 and needs 35 minutes to turn around.</p>
          <div class="ui fl-conf">
            <span class="t fl-row-s">Confidence</span>
            <span class="img fl-conf-bar"><i></i></span>
            <span class="t fl-row-t">High · the airline hasn’t posted this yet</span>
          </div>
          <button class="ui fl-row fl-row--amb" data-go="inbound">
            <span class="ico fl-dot fl-dot--late"></span>
            <span><span class="t fl-row-t">Your plane · in Denver</span><br /><span class="t fl-row-s">See its whole day</span></span>
            <span class="t fl-chev">›</span>
          </button>
          <button class="btn fl-cta" data-back><span class="t">Got it</span></button>
        </div>
      </section>

      <!-- Live timeline -->
      <section class="scr fl-s" data-screen="timeline" data-title="Live timeline">
        <div class="fl-scroll fl-scroll--full" data-scroll>
          <div class="fl-pad fl-top">
            <button class="fl-back t" data-back>‹ FL 214</button>
            <h4 class="t fl-h2">Live timeline</h4>
            <ol class="fl-tl" role="list">
              {timeline.map((e) => (
                <li class={`fl-tl-i fl-tl-i--${e.k}`}>
                  <span class="t fl-tl-t">{e.t}</span>
                  <span class="ico fl-tl-dot"></span>
                  {e.go ? (
                    <button class="ui fl-tl-c" data-go={e.go} data-sheet={e.go === 'delay' ? '' : undefined}>
                      <span class="t fl-row-t">{e.title} ›</span>
                      <span class="t fl-row-s">{e.sub}</span>
                    </button>
                  ) : (
                    <span class="ui fl-tl-c">
                      <span class="t fl-row-t">{e.title}</span>
                      <span class="t fl-row-s">{e.sub}</span>
                    </span>
                  )}
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

      <!-- Gate change -->
      <section class="scr fl-s fl-gate-scr" data-screen="gate" data-title="Gate change">
        <div class="fl-pad fl-top fl-center">
          <button class="fl-back t" data-back>‹ FL 214</button>
          <div class="ui fl-signbox">
            <span class="t fl-sign-k">Gate change</span>
            <span class="t fl-sign-old">B12</span>
            <span class="t fl-sign-new">C4</span>
            <span class="t fl-sign-s">Terminal 1 · about 9 min walk</span>
          </div>
          <div class="fl-grid2">
