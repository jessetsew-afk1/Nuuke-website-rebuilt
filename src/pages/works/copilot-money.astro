---
import Case from '../../layouts/Case.astro';
import Chapter from '../../components/case/Chapter.astro';
import Brief from '../../components/case/Brief.astro';
import Personas from '../../components/case/Personas.astro';
import JourneyMap from '../../components/case/JourneyMap.astro';
import FlowMap from '../../components/case/FlowMap.astro';
import ScreenStack from '../../components/case/ScreenStack.astro';
import Prototype from '../../components/case/Prototype.astro';
import DesignSystem from '../../components/case/DesignSystem.astro';
import Metrics from '../../components/case/Metrics.astro';
import Hero from '../../components/cases/copilot-money/Hero.astro';
import Overture from '../../components/cases/copilot-money/Overture.astro';
import Roadmap from '../../components/cases/copilot-money/Roadmap.astro';
import TrustFlow from '../../components/cases/copilot-money/TrustFlow.astro';
import DataLab from '../../components/cases/copilot-money/DataLab.astro';
import Spatial from '../../components/cases/copilot-money/Spatial.astro';
import Handoff from '../../components/cases/copilot-money/Handoff.astro';
import { bySlug } from '../../data/projects';
import { copilotLayers, netWorth } from '../../data/cases/copilot-money';

const p = bySlug('copilot-money');
const chapters = [
  { id: 'brief', label: 'Brief' },
  { id: 'research', label: 'Research' },
  { id: 'journey', label: 'Journey' },
  { id: 'flow', label: 'User flow' },
  { id: 'trust', label: 'Trust-first onboarding' },
  { id: 'dataviz', label: 'Data-viz lab' },
  { id: 'layers', label: '3D wireframe' },
  { id: 'prototype', label: 'Prototype' },
  { id: 'spatial', label: 'Spatial sketch' },
  { id: 'handoff', label: 'Dev handoff' },
  { id: 'system', label: 'Design system' },
  { id: 'measure', label: 'Measure' },
];
const sources = [
  { label: 'Copilot Money: homepage', url: 'https://www.copilot.money/' },
  { label: 'Copilot Money: FAQ', url: 'https://www.copilot.money/faq' },
  { label: 'Copilot Money: Series A post', url: 'https://copilot.money/series-a' },
  { label: 'Copilot Money: web app launch', url: 'https://www.copilot.money/dispatch/web-app' },
  { label: 'TechCrunch: $6M Series A', url: 'https://techcrunch.com/2024/03/21/budgeting-app-copilot-mint-6m-series-a/' },
  { label: 'Crowdfund Insider: Series A', url: 'https://www.crowdfundinsider.com/2024/03/223058-copilot-raises-6m-in-series-a-funding-to-expand-personal-finance-tool/' },
  { label: 'Apple Developer: Copilot spotlight', url: 'https://developer.apple.com/news/?id=m1mmw99d' },
  { label: 'Apple Design Awards 2024 (finalists)', url: 'https://developer.apple.com/design/awards/2024/' },
  { label: 'App Store listing', url: 'https://apps.apple.com/us/app/copilot-track-budget-money/id1447330651' },
  { label: 'Copilot help centre: settings', url: 'https://help.copilot.money/en/articles/11062072-settings-overview' },
  { label: 'Blake Crosley: third-party colour analysis', url: 'https://blakecrosley.com/guides/design/copilot-money' },
];
const meta = [
  { label: 'Brand', value: 'Copilot Money, New York' },
  { label: 'Discipline', value: 'Mobile app · UX/UI · data viz' },
  { label: 'Our role', value: 'Research, onboarding, data viz, prototype, handoff' },
  { label: 'Timeline', value: '6-week design sprint' },
];
const personas = [
  { name: 'Ex-Mint Priya', meta: '33 · nurse', quote: 'My old app shut down. I want something calm I can actually trust with my bank.', goals: ['A painless move from her old app', 'Know she can trust where her data goes', 'A two-minute check-in after shifts'], pains: ['Ads dressed up as “offers”', 'Re-linking banks that keep breaking', 'Dashboards she has to decode'], color: '#00CC4B' },
  { name: 'Couple-finances Sam & Alex', meta: '30s · shared rent, separate cards', quote: 'Every Sunday we ask the same thing: where did the money go this week?', goals: ['One shared view of joint spending', 'Budgets both of them believe', 'Catch subscriptions neither remembers'], pains: ['Two apps, two versions of the truth', 'Arguments over miscategorised spends', 'Monthly surprises'], color: '#FF4433' },
  { name: 'Net-worth Nate', meta: '41 · engineer', quote: 'Investments, crypto, the house. I want the whole picture on one line.', goals: ['Net worth across every asset', 'Performance and allocation at a glance', 'Charts that respect the data'], pains: ['Pie charts with twelve slivers', 'Stale balances', 'Having to export to a spreadsheet'], color: '#1C6CFF' },
];
const stages = [
  { label: 'Payday', doing: 'Paycheck lands; checks the balance.', feeling: 'Relieved, briefly.', score: 1, opportunity: 'Show what’s already spoken for (rent, recurring) so “available” is honest.' },
  { label: 'Week one', doing: 'Taps a card twenty times; no idea where it’s going.', feeling: 'Vague, a little uneasy.', score: -0.3, opportunity: 'A daily two-minute review inbox: confirm, re-categorise, done.' },
  { label: 'Mid-month', doing: 'Finds out dining is running hot, by accident.', feeling: 'Anxious, a bit guilty.', score: -1.5, opportunity: 'A proactive “what changed” card: Dining is $90 ahead of last month, with 13 days left.' },
  { label: 'A renewal', doing: 'A free trial quietly turns into a subscription.', feeling: 'Annoyed.', score: -1.2, opportunity: 'Flag “new subscription spotted” after the first charge, before the second.' },
  { label: 'Month end', doing: 'Reviews budgets; rolls unspent grocery money forward.', feeling: 'In control.', score: 1.2, opportunity: 'Rollovers make under-spending feel like progress, not a reset.' },
  { label: 'Next month', doing: 'Sees net worth tick up 1.8%.', feeling: 'Motivated.', score: 1.8, opportunity: 'Close every month with one line: what changed, and what to watch next.' },
];
const nodes = [
  { id: 'connect', label: 'Connect accounts', x: 90, y: 210, kind: 'start' as const },
  { id: 'dash', label: 'Dashboard', x: 290, y: 210, kind: 'key' as const },
  { id: 'review', label: 'To review', x: 490, y: 80 },
  { id: 'recat', label: 'Pick category', x: 690, y: 80 },
  { id: 'ai', label: 'Why this category?', x: 890, y: 80 },
  { id: 'cats', label: 'Spending', x: 490, y: 210 },
  { id: 'cat', label: 'Dining detail', x: 690, y: 210 },
  { id: 'budget', label: 'Budgets', x: 490, y: 340 },
  { id: 'recurring', label: 'Recurring', x: 690, y: 340 },
  { id: 'networth', label: 'Net worth', x: 890, y: 340, kind: 'end' as const },
];
const edges = [
  { from: 'connect', to: 'dash', label: 'link' },
  { from: 'dash', to: 'review', label: '4 new' },
  { from: 'review', to: 'recat', label: 'tap chip' },
  { from: 'recat', to: 'ai', label: 'why?' },
  { from: 'dash', to: 'cats' },
  { from: 'cats', to: 'cat' },
  { from: 'dash', to: 'budget' },
  { from: 'dash', to: 'recurring' },
  { from: 'recurring', to: 'networth' },
];
const tasks = [
  { label: 'Link a bank and land on your month', screen: 'dash' },
  { label: 'Open today’s review inbox', screen: 'review' },
  { label: 'Re-categorise a dinner', screen: 'recat' },
  { label: 'Ask why it was categorised that way', screen: 'ai' },
  { label: 'See what changed in Dining', screen: 'cat' },
  { label: 'Check budget rollovers', screen: 'budget' },
  { label: 'Catch a new subscription', screen: 'recurring' },
  { label: 'Look at net worth', screen: 'networth' },
];
const banks = [
  ['HF', 'Hudson Federal', 'Checking · savings', '#1C6CFF'],
  ['PC', 'Pinecrest Credit Union', 'Checking', '#00CC4B'],
  ['NS', 'Northstar Card', 'Credit card', '#FF4433'],
  ['MV', 'Meridian Invest', 'Brokerage', '#9085e9'],
];
const pace = 'M 6 120 C 40 116, 60 106, 90 96 S 150 70, 190 58 S 236 44, 252 36';
const paceLast = 'M 6 120 C 50 116, 90 104, 130 96 S 210 80, 250 74 S 300 66, 330 62';
const reviewRows = [
  { m: 'Corner Café', e: '☕', c: 'Coffee', a: '$6.50', col: '#c98500', go: 'recat', t: 'Today · 8:12 am' },
  { m: 'Lucia’s Trattoria', e: '🍜', c: 'Dining', a: '$48.20', col: '#199e70', go: 'recat', t: 'Yesterday · 8:40 pm' },
  { m: 'Metro Transit', e: '🚇', c: 'Transport', a: '$2.90', col: '#d55181', go: 'recat', t: 'Yesterday' },
  { m: 'StreamBox', e: '🎬', c: 'Subscriptions', a: '$15.99', col: '#FECE4C', go: 'recurring', t: 'New · monthly?' },
];
const catRows = [
  ['🏠', 'Rent', 1900, 1900, '#3987e5'],
  ['🛒', 'Groceries', 402, 600, '#d95926'],
  ['🍜', 'Dining', 388, 400, '#199e70'],
  ['🛍️', 'Shopping', 210, 450, '#c98500'],
  ['🚇', 'Transport', 132, 300, '#d55181'],
  ['📦', 'Other', 150, 750, '#9085e9'],
] as const;
const nwPts = netWorth.map((v, i) => `${(8 + i * (334 / 11)).toFixed(1)},${(150 - (v - 96) * 3.6).toFixed(1)}`).join(' ');
---

<Case project={p} chapters={chapters} sources={sources} meta={meta}>
  <Hero slot="hero" />

  <Overture />

  <Chapter id="brief" n="01" label="The brief" title="A money app that tells you what changed.">
    <Brief
      story="Copilot Money is a New York subscription app built by founder and CEO <strong>Andrés Ugarte</strong>, a software engineer who quit his job in 2018 to make it; it launched publicly around 2020. It brings bank, card and investment accounts from <strong>10,000+ US institutions</strong> into one view, with ML categorisation, budgets with rollovers, recurring tracking and net worth. The model is subscription-only: <em>“no ads, no gimmicks”</em> and no data selling. The day Mint’s shutdown was announced, in November 2023, was Copilot’s biggest day ever."
      facts={[
        { v: '100K+', k: 'Subscribers, as of March 2024' },
        { v: '$6M', k: 'Series A led by Adjacent, March 2024' },
        { v: '$10.5M', k: 'Total venture capital raised' },
        { v: 'ADA ’24', k: 'Apple Design Awards finalist, Innovation' },
      ]}
      problems={[
        { title: 'Trust at the connect step', text: 'Linking a bank is the scariest moment in any finance app. The copy, motion and security cues have to answer every fear before it becomes a bounce.' },
        { title: 'Charts that answer questions', text: 'Most money apps show what happened. People open them to learn what changed. Every chart has to earn its place by answering one question.' },
        { title: 'Review as a ritual', text: 'Checking new transactions should be a satisfying two-minute loop, and every correction should teach the model something.' },
      ]}
      goal="Every screen answers “what changed?” before “what happened?”, and the scariest step, linking a bank, feels like the safest one."
    />
    <Roadmap />
  </Chapter>

  <Chapter id="research" n="02" label="Research" title="Three people, one question: where did it go?" intro="We built personas from Copilot’s public audience (design-minded, Apple-first US professionals, many of them former Mint users) and tested every screen against them.">
    <Personas personas={personas} />
  </Chapter>

  <Chapter id="journey" n="03" label="Journey map" title="A month with money, and where it hurts." intro="Tap each moment to see what Priya is doing, how she feels, and the design opportunity it gave us. The two lows (mid-month and a surprise renewal) are both <strong>things that changed without anyone saying so</strong>.">
    <JourneyMap stages={stages} />
  </Chapter>

  <Chapter id="flow" n="04" label="User flow" title="Ten screens. One loop: review, understand, adjust." intro="Onboarding happens once; the daily loop is <strong>dashboard → review → what changed</strong>. Tap any screen to jump to it in the live prototype.">
    <FlowMap nodes={nodes} edges={edges} width={1100} height={430} />
  </Chapter>

  <Chapter id="trust" n="05" label="Trust-first onboarding" title="Six moments between “hello” and “here’s what changed”." intro="We designed onboarding around the moment people are most likely to leave: handing a bank login to an app. Step through it and <strong>tap the numbered pins</strong> to see what we show at each moment and why.">
    <TrustFlow />
  </Chapter>

  <Chapter id="dataviz" n="06" label="Data-visualisation lab" title="Same data, five charts, one right answer per question." intro="Before drawing a single dashboard, we put one sample month through every chart type and asked which one answers each question fastest. <strong>Pick a question, try each chart,</strong> and read our reasoning. The star marks our pick.">
    <DataLab />
  </Chapter>

  <Chapter id="layers" n="07" label="3D wireframe" title="Take the dashboard apart, layer by layer." intro="From grid to motion, every screen is built in five layers. Scroll and the exploded view assembles into the final UI. Drag to look around it.">
    <ScreenStack layers={copilotLayers} accent={p.accent} />
  </Chapter>

  <Chapter id="prototype" n="08" label="Prototype" title="Tap through it. Then switch to the wireframe." intro="This is the prototype we’d put in front of ten Copilot-style users. Follow the journey on the left and flip between <strong>Sketch</strong>, <strong>Wireframe</strong> and <strong>Hi-fi</strong> to see how each screen evolved. All amounts are sample data.">
    <Prototype title="Copilot daily loop" start="connect" tasks={tasks} note="Eight tasks, ten screens. Everything that glows is tappable.">
      <!-- Connect -->
      <section class="scr cmp" data-screen="connect" data-title="Connect accounts">
        <div class="cmp-scroll" data-scroll>
          <div class="cmp-pad cmp-top">
            <p class="t cmp-kick">Get started</p>
            <h4 class="t cmp-h1">Connect your first account</h4>
            <div class="ui cmp-search"><span class="ico cmp-sico">⌕</span><span class="t">Search 10,000+ institutions</span></div>
            <div class="cmp-list">
              {
                banks.map(([i, n, s, c]) => (
                  <button class="ui cmp-row" data-go="dash">
                    <span class="ico cmp-av" style={`--c:${c}`}>{i}</span>
                    <span><span class="t cmp-row-t">{n}</span><br /><span class="t cmp-row-s">{s}</span></span>
                    <span class="t cmp-chev">›</span>
                  </button>
                ))
              }
            </div>
            <div class="ui cmp-promise">
              <span class="ico cmp-lock">🔒</span>
              <span><span class="t cmp-row-t">No ads. No data selling.</span><br /><span class="t cmp-row-s">Bank names here are invented for this concept.</span></span>
            </div>
          </div>
        </div>
      </section>

      <!-- Dashboard -->
      <section class="scr cmp" data-screen="dash" data-title="Dashboard">
        <div class="cmp-scroll cmp-scroll--tabs" data-scroll>
          <div class="cmp-pad cmp-top">
            <p class="t cmp-kick">October · spent so far</p>
            <p class="t cmp-giant">$3,182<span>.40</span></p>
            <p class="t cmp-row-s">of $4,600 budget · 13 days left</p>
            <div class="ui cmp-card cmp-pace">
              <svg viewBox="0 0 340 130" class="img" aria-hidden="true">
                <defs>
                  <linearGradient id="cmp-fill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1C6CFF" stop-opacity=".35" /><stop offset="1" stop-color="#1C6CFF" stop-opacity="0" /></linearGradient>
                </defs>
                <path d={paceLast} fill="none" stroke="#3b5079" stroke-width="2.5" stroke-dasharray="2 6" stroke-linecap="round" />
                <path d={`${pace} L 252 130 L 6 130 Z`} fill="url(#cmp-fill)" />
                <path d={pace} fill="none" stroke="#1C6CFF" stroke-width="3.5" stroke-linecap="round" />
                <circle cx="252" cy="36" r="6" fill="#F2F6FF" stroke="#001533" stroke-width="3" />
              </svg>
              <p class="t cmp-legend"><i class="cmp-k1"></i> This month <i class="cmp-k2"></i> Last month</p>
            </div>
            <div class="cmp-head"><p class="t cmp-kick">What changed</p><button class="t cmp-link" data-go="cats">All categories ›</button></div>
            <button class="ui cmp-row cmp-change" data-go="cat">
              <span class="ico cmp-em" style="--c:#FF4433">🍜</span>
              <span><span class="t cmp-row-t">Dining is up $90</span><br /><span class="t cmp-row-s">vs. September, same day</span></span>
              <span class="t cmp-amt cmp-out">+$90</span>
            </button>
            <button class="ui cmp-row cmp-change" data-go="recurring">
              <span class="ico cmp-em" style="--c:#FECE4C">🎬</span>
              <span><span class="t cmp-row-t">New subscription</span><br /><span class="t cmp-row-s">StreamBox · monthly</span></span>
              <span class="t cmp-amt cmp-new">$15.99</span>
            </button>
            <button class="ui cmp-row cmp-change" data-go="networth">
              <span class="ico cmp-em" style="--c:#00CC4B">💰</span>
              <span><span class="t cmp-row-t">Savings grew</span><br /><span class="t cmp-row-s">3 months in a row</span></span>
              <span class="t cmp-amt cmp-in">+$410</span>
            </button>
            <button class="btn cmp-cta cmp-cta--review" data-go="review"><span class="t">4 transactions to review</span><span class="t cmp-badge">4</span></button>
          </div>
        </div>
        <nav class="cmp-tabs ui">
          <button class="is-on" data-go="dash"><span class="ico">⌂</span><span class="t">Home</span></button>
          <button data-go="review"><span class="ico">✓</span><span class="t">Review</span></button>
          <button data-go="budget"><span class="ico">◔</span><span class="t">Budgets</span></button>
          <button data-go="recurring"><span class="ico">↻</span><span class="t">Recurring</span></button>
          <button data-go="networth"><span class="ico">↗</span><span class="t">Net worth</span></button>
        </nav>
      </section>

      <!-- Review -->
      <section class="scr cmp" data-screen="review" data-title="To review">
        <div class="cmp-scroll" data-scroll>
          <div class="cmp-pad cmp-top">
            <button class="cmp-back t" data-back>‹ Back</button>
            <h4 class="t cmp-h2">To review</h4>
            <p class="t cmp-row-s">Four new since yesterday. Tap ✓ to confirm, tap a category to change it.</p>
            {
              reviewRows.map((r) => (
                <div class="ui cmp-rev">
                  <span class="ico cmp-em" style={`--c:${r.col}`}>{r.e}</span>
                  <span class="cmp-rev-main">
                    <span class="t cmp-row-t">{r.m}</span>
                    <span class="t cmp-row-s">{r.t}</span>
                    <button class="ui cmp-chip" style={`--c:${r.col}`} data-go={r.go} data-sheet={r.go === 'recat' ? '' : undefined}>
                      <span class="t">{r.e} {r.c} ▾</span>
                    </button>
                  </span>
                  <span class="cmp-rev-end">
                    <span class="t cmp-amt">{r.a}</span>
                    <button class="ui cmp-ok" data-toggle aria-label={`Mark ${r.m} reviewed`}>✓</button>
                  </span>
                </div>
              ))
            }
            <button class="btn cmp-cta" data-go="dash"><span class="t">Mark all reviewed</span></button>
          </div>
        </div>
      </section>

      <!-- Re-categorise sheet -->
      <section class="scr cmp cmp-sheet-scr" data-screen="recat" data-title="Pick a category (sheet)">
        <div class="cmp-sheet ui">
          <div class="cmp-grab"></div>
          <p class="t cmp-kick">Lucia’s Trattoria · $48.20</p>
          <h4 class="t cmp-h2">Choose a category</h4>
          <div class="cmp-grid3">
            {
              [
                ['🍜', 'Dining', true],
                ['🛒', 'Groceries', false],
                ['☕', 'Coffee', false],
                ['🎉', 'Going out', false],
                ['🎁', 'Gifts', false],
                ['💼', 'Work', false],
              ].map(([e, n, on]) => (
                <button class:list={['ui', 'cmp-cat', { 'is-on': on }]} data-toggle>
                  <span class="ico cmp-cat-e">{e}</span>
                  <span class="t">{n}</span>
                </button>
              ))
            }
          </div>
          <div class="ui cmp-row cmp-rule">
            <span><span class="t cmp-row-t">Always use for Lucia’s</span><br /><span class="t cmp-row-s">Future transactions only</span></span>
            <button class="cmp-switch ui is-on" data-toggle aria-label="Always use this category for Lucia’s"><i></i></button>
          </div>
          <button class="ui cmp-why" data-go="ai"><span class="t">✦ Why did we pick Dining?</span><span class="t">›</span></button>
          <button class="btn cmp-cta" data-back><span class="t">Done</span></button>
        </div>
      </section>

      <!-- AI explanation -->
      <section class="scr cmp" data-screen="ai" data-title="Why this category?">
        <div class="cmp-scroll" data-scroll>
          <div class="cmp-pad cmp-top">
            <button class="cmp-back t" data-back>‹ Back</button>
            <p class="t cmp-kick">Auto-categorisation</p>
            <h4 class="t cmp-h2">Why we chose 🍜 Dining</h4>
            <div class="ui cmp-card">
              <p class="t cmp-row-s">How sure we were</p>
              <div class="cmp-conf img"><i style="width:92%"></i></div>
              <p class="t cmp-row-t">Very likely · 92%</p>
            </div>
            <p class="t cmp-kick cmp-mt">What we looked at</p>
            {
              [
                ['🧾', 'Your history', 'You put Lucia’s in Dining 14 times before.'],
                ['🏷️', 'Merchant type', 'Listed by the bank as a restaurant.'],
                ['🕗', 'Time and amount', 'Friday, 8:40 pm, $48: looks like dinner.'],
              ].map(([e, t, s]) => (
                <div class="ui cmp-row cmp-signal">
                  <span class="ico cmp-em" style="--c:#1C6CFF">{e}</span>
                  <span><span class="t cmp-row-t">{t}</span><br /><span class="t cmp-row-s">{s}</span></span>
                </div>
              ))
            }
            <div class="ui cmp-card cmp-learn">
              <p class="t cmp-row-t">When you change it</p>
              <p class="t cmp-row-s">We learn from your choice for this merchant. Past months stay as they are unless you ask.</p>
            </div>
            <p class="t cmp-tiny">Concept: the explanation pattern is ours. Signals shown are illustrative.</p>
          </div>
        </div>
      </section>

      <!-- Spending categories -->
      <section class="scr cmp" data-screen="cats" data-title="Spending by category">
        <div class="cmp-scroll" data-scroll>
          <div class="cmp-pad cmp-top">
            <button class="cmp-back t" data-back>‹ Back</button>
            <h4 class="t cmp-h2">Spending · October</h4>
            <p class="t cmp-row-s">So far, against each budget.</p>
            {
              catRows.map(([e, n, s, b, c]) => (
                <button class="ui cmp-catrow" data-go={n === 'Dining' ? 'cat' : undefined} data-toggle={n === 'Dining' ? undefined : ''}>
                  <span class="ico cmp-em" style={`--c:${c}`}>{e}</span>
                  <span class="cmp-catrow-main">
                    <span class="cmp-catrow-top"><span class="t cmp-row-t">{n}</span><span class="t cmp-amt">${s.toLocaleString('en-US')}</span></span>
                    <span class="cmp-bar img"><i style={`width:${Math.min(100, (s / b) * 100)}%;background:${c}`}></i></span>
                    <span class="t cmp-row-s">{Math.round((s / b) * 100)}% of ${b.toLocaleString('en-US')}</span>
                  </span>
                </button>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Category detail -->
      <section class="scr cmp" data-screen="cat" data-title="Dining detail">
        <div class="cmp-scroll" data-scroll>
          <div class="cmp-pad cmp-top">
            <button class="cmp-back t" data-back>‹ Back</button>
            <div class="cmp-cathead">
              <span class="ico cmp-em cmp-em--lg" style="--c:#199e70">🍜</span>
              <span><h4 class="t cmp-h2">Dining</h4><span class="t cmp-row-s">$388 of $400 · 13 days left</span></span>
            </div>
            <div class="ui cmp-card cmp-what">
              <p class="t cmp-kick">What changed</p>
              <p class="t cmp-row-t">$90 ahead of September by this date. Three more dinners out, all on Fridays.</p>
