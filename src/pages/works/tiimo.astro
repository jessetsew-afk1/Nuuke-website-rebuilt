---
import Case from '../../layouts/Case.astro';
import Chapter from '../../components/case/Chapter.astro';
import Brief from '../../components/case/Brief.astro';
import Personas from '../../components/case/Personas.astro';
import JourneyMap from '../../components/case/JourneyMap.astro';
import FlowMap from '../../components/case/FlowMap.astro';
import ScreenStack from '../../components/case/ScreenStack.astro';
import Prototype from '../../components/case/Prototype.astro';
import DesignSystem from '../../components/case/DesignSystem.astro';
import Metrics from '../../components/case/Metrics.astro';
import Hero from '../../components/cases/tiimo/Hero.astro';
import Opening from '../../components/cases/tiimo/Opening.astro';
import Wireframes from '../../components/cases/tiimo/Wireframes.astro';
import SensoryLab from '../../components/cases/tiimo/SensoryLab.astro';
import RoadToLaunch from '../../components/cases/tiimo/RoadToLaunch.astro';
import { bySlug } from '../../data/projects';
import { tiimoLayers, TI } from '../../data/cases/tiimo';

const p = bySlug('tiimo');
const chapters = [
  { id: 'brief', label: 'Brief' },
  { id: 'research', label: 'Research' },
  { id: 'journey', label: 'Journey' },
  { id: 'flow', label: 'User flow' },
  { id: 'wireframes', label: 'Wireframes' },
  { id: 'layers', label: '3D layers' },
  { id: 'prototype', label: 'Prototype' },
  { id: 'sensory', label: 'Sensory lab' },
  { id: 'launch', label: 'Road to launch' },
  { id: 'system', label: 'Design system' },
  { id: 'measure', label: 'Measure' },
];
const sources = [
  { label: 'Tiimo: about', url: 'https://www.tiimoapp.com/about' },
  { label: 'Tiimo: pricing', url: 'https://www.tiimoapp.com/pricing' },
  { label: 'Tiimo: winner, 2025 App Store Awards', url: 'https://www.tiimoapp.com/resource-hub/tiimo-winner-2025-app-store-awards' },
  { label: 'Tiimo: raises $4.8M', url: 'https://www.tiimoapp.com/resource-hub/tiimo-raises-4-8m-neurodivergent-planner' },
  { label: 'Tiimo × Gentler Streak', url: 'https://www.tiimoapp.com/resource-hub/tiimo-gentler-streak-partnership' },
  { label: 'Wikipedia: Tiimo', url: 'https://en.wikipedia.org/wiki/Tiimo' },
  { label: 'Tiimo press kit', url: 'https://tiimo.pressdeck.io/' },
  { label: 'EU-Startups: €1.4M round (Aug 2024)', url: 'https://www.eu-startups.com/2024/08/copenhagen-based-tiimo-secures-additional-e1-4-million-to-advance-neuro-inclusive-tech/' },
  { label: 'Apple Design Awards 2024', url: 'https://developer.apple.com/design/awards/2024/' },
  { label: 'App Store editorial: iPhone App of the Year', url: 'https://apps.apple.com/au/iphone/story/id1847760015' },
  { label: 'App Store listing', url: 'https://apps.apple.com/us/app/tiimo-daily-to-do-list/id1480220328' },
  { label: 'Retention.Blog: App of the Year, Tiimo', url: 'https://www.retention.blog/p/app-of-the-year-tiimo' },
];
const meta = [
  { label: 'Brand', value: 'Tiimo, Copenhagen' },
  { label: 'Discipline', value: 'Mobile app · UX/UI' },
  { label: 'Our role', value: 'Research, flows, wireframes, prototype, sensory system, launch kit' },
  { label: 'Timeline (concept)', value: '6 weeks, sketch to App Store' },
];
const personas = [
  { name: 'Time-blind Jess', meta: '27 · designer · ADHD', quote: 'I can’t feel how long things take. I need to see time passing.', goals: ['See the whole day at a glance', 'Know how long is left without doing maths', 'Start the hard task first'], pains: ['Calendars that are just grids of text', 'Alarms that panic her', 'Red “overdue” badges'], color: TI.lilac },
  { name: 'Routine-anchored Oskar', meta: '19 · student · autistic', quote: 'Tell me what comes next, and warn me before it changes.', goals: ['Predictable visual routines', 'Gentle warnings before transitions', 'The same layout every day'], pains: ['Surprise pop-ups', 'Busy, flashing motion', 'Layouts that move around'], color: TI.mint },
  { name: 'Overloaded-parent Rosa', meta: '42 · recently diagnosed', quote: 'Sorting the house isn’t a task. It’s a weekend. Break it down for me.', goals: ['AI that splits big jobs into steps', 'Plans she can edit in seconds', 'Room for the day to go wrong'], pains: ['Long setup and forms', 'Guilt-driven streaks', 'Plans that collapse if she runs late'], color: TI.peach },
];
const stages = [
  { label: 'Wake', doing: 'Wakes with a dozen to-dos already in her head.', feeling: 'Overwhelmed before she has started.', score: -1.2, opportunity: 'One brain-dump box on the lock screen: get it out of her head first, sort it later.' },
  { label: 'Plan', doing: 'Tries to order the list; everything feels urgent.', feeling: 'Stuck, and starting to avoid it.', score: -1.7, opportunity: 'The co-planner proposes an order and soft time estimates, all editable, with undo.' },
  { label: 'Start', doing: 'Opens the deck file, closes it, opens email.', feeling: 'Can’t get going.', score: -0.6, opportunity: 'Show only the first tiny step and a focus disc. Starting should take one tap.' },
  { label: 'Focus', doing: 'Gets into flow and loses track of time.', feeling: 'Good, until lunch is late.', score: 0.9, opportunity: 'A haptic tick every 5 minutes and a Live Activity disc on the lock screen.' },
  { label: 'Running late', doing: 'Lunch overruns by 40 minutes.', feeling: 'Ashamed; tempted to give up on the plan.', score: -1, opportunity: 'The timeline shifts gently. No red, no “overdue”, just “here’s your afternoon now”.' },
  { label: 'Evening', doing: 'Looks back at the day.', feeling: 'Calm; it was a day she could see.', score: 1.6, opportunity: 'An optional mood check-in that celebrates what got done, never a broken streak.' },
];
const nodes = [
  { id: 'welcome', label: 'Welcome', x: 90, y: 90, kind: 'start' as const },
  { id: 'personalise', label: 'Personalise', x: 270, y: 90 },
  { id: 'braindump', label: 'Brain dump', x: 450, y: 90 },
  { id: 'coplanner', label: 'AI co-planner', x: 630, y: 90 },
  { id: 'today', label: 'Today timeline', x: 630, y: 230, kind: 'key' as const },
  { id: 'todo', label: 'To-dos', x: 450, y: 330 },
  { id: 'task', label: 'Task detail', x: 820, y: 230 },
  { id: 'focus', label: 'Focus timer', x: 1000, y: 230 },
  { id: 'live', label: 'Live Activity', x: 1000, y: 90 },
  { id: 'mood', label: 'Mood check-in', x: 1000, y: 350, kind: 'end' as const },
];
const edges = [
  { from: 'welcome', to: 'personalise' }, { from: 'personalise', to: 'braindump' }, { from: 'braindump', to: 'coplanner' },
  { from: 'coplanner', to: 'today', label: 'add' }, { from: 'today', to: 'task' }, { from: 'task', to: 'focus' },
  { from: 'focus', to: 'live', label: 'lock' }, { from: 'focus', to: 'mood' }, { from: 'todo', to: 'today' }, { from: 'today', to: 'braindump', label: '+' },
];
const tasks = [
  { label: 'Set up with the dyslexia-friendly font', screen: 'personalise' },
  { label: 'Empty your head into brain dump', screen: 'braindump' },
  { label: 'Let the co-planner break a task down', screen: 'coplanner' },
  { label: 'See your day as a timeline', screen: 'today' },
  { label: 'Open a task and its small steps', screen: 'task' },
  { label: 'Start a visual focus timer', screen: 'focus' },
  { label: 'Glance at the lock screen', screen: 'live' },
  { label: 'Check in on how it went', screen: 'mood' },
];
const process = [
  { n: '01', t: 'Research', d: 'Personas & journey', href: '#research', w: 'Week 1' },
  { n: '02', t: 'Flows', d: 'Ten screens, one loop', href: '#flow', w: 'Week 1' },
  { n: '03', t: 'Wireframes', d: 'Sketch → grey → colour', href: '#wireframes', w: 'Week 2' },
  { n: '04', t: 'Prototype', d: 'Tap it, test it', href: '#prototype', w: 'Week 3' },
  { n: '05', t: 'Sensory system', d: 'Settings that adapt', href: '#sensory', w: 'Week 3' },
  { n: '06', t: 'Launch', d: 'Store page, roadmap, notes', href: '#launch', w: 'Weeks 4–6' },
];
const timeline = [
  { e: '🥣', t: 'Breakfast & meds', s: '08:30 · 30 min', c: TI.peach, h: 64 },
  { e: '✉️', t: 'Reply to Sam', s: '09:15 · 30 min', c: TI.sky, h: 64 },
  { e: '💻', t: 'Focus: Friday deck', s: '10:00 · 1 h 30', c: TI.lilac, h: 118, go: 'task' },
  { e: '🌿', t: 'Walk in the sun', s: '12:00 · 30 min', c: TI.mint, h: 64 },
  { e: '📞', t: 'Call the dentist', s: '13:00 · 15 min', c: TI.pink, h: 56 },
  { e: '🧺', t: 'Laundry, one load', s: '14:00 · 45 min', c: TI.butter, h: 74 },
];
---

<Case project={p} chapters={chapters} sources={sources} meta={meta}>
  <Hero slot="hero" />

  <Opening />

  <Chapter id="brief" n="01" label="The brief" title="A planner for brains that work differently.">
    <Brief
      story="Tiimo is a visual planner from <strong>Copenhagen</strong>, founded in <strong>2015</strong> by Helene Lassen Nørlem and Melissa Würtz Azari. It began as a research project interviewing neurodivergent teenagers about how technology could support them at school. Today it turns to-dos into <em>colour-coded timeline blocks</em>, with an AI co-planner, a visual focus timer and mood check-ins. Its own line: <em>“Designed for brains that work differently.”</em>"
      facts={[
        { v: '2015', k: 'Founded in Copenhagen by Helene Lassen Nørlem and Melissa Würtz Azari' },
        { v: 'App of the Year', k: 'App Store Awards 2025, iPhone' },
        { v: 'ADA ’24', k: 'Apple Design Awards finalist, Inclusivity' },
        { v: '1M+', k: 'Users, as reported by Tiimo' },
        { v: '~20', k: 'People, 30% of whom identify as neurodivergent (press kit)' },
        { v: '$4.8M', k: 'Raised pre-Series A (EU-Startups; Tiimo)' },
      ]}
      problems={[
        { title: 'Make time visible, without panic', text: 'For people with time blindness, the passing of time has to be seen. But a ticking countdown can feel like an alarm. The shape of time must calm, not chase.' },
        { title: 'AI that doesn’t overwhelm', text: 'A co-planner that turns one task into twelve has made things worse. Its output needs pacing, sensible defaults and an undo that’s always in reach.' },
        { title: 'Sensory settings as a system', text: 'Theme colours, fonts and motion are personal. Whatever someone picks, contrast, layout and reduced motion must still hold.' },
      ]}
      goal="A day you can see is a day you can start. Make the plan visible in one glance, and gentle enough to come back to tomorrow."
    />
    <div class="ti-proc" data-reveal>
      <p class="t-label">How this app gets made: the path this page follows</p>
      <ol role="list" class="ti-proc-list" data-stagger="0.07">
        {
          process.map((s) => (
            <li>
              <a href={s.href} class="ti-proc-step">
                <span class="ti-proc-n t-num">{s.n}</span>
                <span class="ti-proc-t">{s.t}</span>
                <span class="ti-proc-d">{s.d}</span>
                <span class="ti-proc-w">{s.w}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </Chapter>

  <Chapter id="research" n="02" label="Research" title="Three people. Three ways a day falls apart." intro="We built personas from Tiimo’s public audience: ADHD, autistic and dyslexic adults, plus anyone overwhelmed by planning. Then we checked every screen against all three.">
    <Personas personas={personas} />
  </Chapter>

  <Chapter id="journey" n="03" label="Journey map" title="Jess’s Tuesday, and where the app can help." intro="Tap each moment to see what Jess is doing, how she feels, and the design opportunity we found. The low points shaped the whole product.">
    <JourneyMap stages={stages} />
  </Chapter>

  <Chapter id="flow" n="04" label="User flow" title="Ten screens. Dump, plan, do, reflect." intro="Onboarding happens once. The daily loop is <strong>brain dump → co-planner → timeline → focus → check-in</strong>. Tap any screen to open it in the live prototype below.">
    <FlowMap nodes={nodes} edges={edges} width={1100} height={420} />
  </Chapter>

  <Chapter id="wireframes" n="05" label="Wireframes" title="Watch the screens draw themselves." intro="Every screen starts as pencil, becomes grey boxes, then gets colour and content. <strong>Scroll</strong> to replay that process on three key screens; the design notes pin on as they were made.">
    <Wireframes />
  </Chapter>

  <Chapter id="layers" n="06" label="3D layers" title="The Today screen, taken apart." intro="Five layers make one calm screen. Scroll and the exploded view assembles into the final UI; drag to look around it.">
    <ScreenStack layers={tiimoLayers} accent={p.accent} />
  </Chapter>

  <Chapter id="prototype" n="07" label="Prototype" title="Tap through a whole day." intro="This is the prototype we’d put in front of testers. Follow the journey on the left, and flip between <strong>Sketch</strong>, <strong>Wireframe</strong> and <strong>Hi-fi</strong> to see how each screen evolved. Try the font switch on the second screen.">
    <Prototype title="Tiimo, one gentle day" start="welcome" tasks={tasks} device="light" note="Eight tasks, ten screens. Everything glowing is tappable.">
      <!-- Welcome -->
      <section class="scr ti-p ti-p-welcome" data-screen="welcome" data-title="Welcome">
        <div class="ti-p-blocks img" aria-hidden="true">
          <i style={`background:${TI.lilac}`}></i><i style={`background:${TI.pink}`}></i><i style={`background:${TI.mint}`}></i><i style={`background:${TI.butter}`}></i><i style={`background:${TI.sky}`}></i>
        </div>
        <div class="ti-p-pad ti-p-bottom">
          <p class="t ti-p-kicker">Tiimo · concept</p>
          <h4 class="t ti-p-h1">Designed for brains that work differently.</h4>
          <p class="t ti-p-p">Plan your day in colour. Go at your own pace.</p>
          <button class="btn ti-p-cta" data-go="personalise"><span class="t">Let’s start</span></button>
        </div>
      </section>

      <!-- Personalise -->
      <section class="scr ti-p" data-screen="personalise" data-title="Personalise">
        <div class="ti-p-scroll" data-scroll>
          <div class="ti-p-pad ti-p-top">
            <div class="ti-p-progress ui"><span style="width:40%"></span></div>
            <h4 class="t ti-p-h2">Make it yours</h4>
            <p class="t ti-p-p">All optional. You can change any of this later.</p>
            <p class="t ti-p-label">Do any of these fit you? <span class="ti-p-opt">optional</span></p>
            <div class="ti-p-chips">
              {['ADHD', 'Autistic', 'Dyslexic', 'Not sure', 'Rather not say'].map((o, i) => <button class:list={['ui', 'ti-p-chip', { 'is-on': i === 0 || i === 2 }]} data-toggle><span class="t">{o}</span></button>)}
            </div>
            <p class="t ti-p-label">Reading style</p>
            <div class="ti-p-fonts">
              <button class="ui ti-p-font is-on" data-ti-pfont="std" aria-pressed="true"><span class="t ti-p-font-a">Aa</span><span class="t">Rounded</span></button>
              <button class="ui ti-p-font ti-p-font--dys" data-ti-pfont="dys" aria-pressed="false"><span class="t ti-p-font-a">Aa</span><span class="t">Dyslexia-friendly</span></button>
            </div>
            <p class="t ti-p-label">Theme colour</p>
            <div class="ti-p-swatches">
              {[TI.purple, '#FF9DB8', '#86E0B4', '#93C6FF', '#FFB27D'].map((c, i) => <button class:list={['ui', 'ti-p-sw', { 'is-on': i === 0 }]} style={`--sw:${c}`} data-ti-ptheme={c} aria-label={`Theme colour ${i + 1}`} aria-pressed={i === 0 ? 'true' : 'false'}><span class="ico"></span></button>)}
            </div>
            <button class="btn ti-p-cta ti-p-mt" data-go="braindump"><span class="t">Continue</span></button>
            <button class="ti-p-ghost t" data-go="braindump">Skip for now</button>
          </div>
        </div>
      </section>

      <!-- Brain dump -->
      <section class="scr ti-p" data-screen="braindump" data-title="Brain dump">
        <div class="ti-p-pad ti-p-top">
          <button class="ti-p-back t" data-back>‹ Back</button>
          <h4 class="t ti-p-h2">Brain dump</h4>
          <p class="t ti-p-p">Type or talk. We’ll sort it out together.</p>
          <div class="ui ti-p-dump">
            {['clean kitchen', 'email Sam', 'dentist?!', 'deck for Friday', 'call mum'].map((t) => <p class="t ti-p-dump-l">{t}</p>)}
            <span class="ti-p-caret" aria-hidden="true"></span>
          </div>
          <div class="ti-p-row2">
            <button class="ui ti-p-mic" data-toggle aria-label="Dictate"><span class="ico ti-p-mic-i"></span></button>
            <p class="t ti-p-hint">5 things, nothing scheduled yet</p>
          </div>
        </div>
        <div class="ti-p-pad ti-p-bottom">
          <button class="btn ti-p-cta" data-go="coplanner"><span class="t">✨ Plan it with me</span></button>
        </div>
      </section>

      <!-- AI co-planner -->
      <section class="scr ti-p" data-screen="coplanner" data-title="AI co-planner">
        <div class="ti-p-scroll" data-scroll>
          <div class="ti-p-pad ti-p-top">
            <button class="ti-p-back t" data-back>‹ Back</button>
            <p class="t ti-p-kicker">Co-planner suggestion</p>
            <h4 class="t ti-p-h2">🍽️ Clean kitchen</h4>
            <p class="t ti-p-p">Here’s a gentle way in: four small steps, about 22 minutes. Tap a time to change it.</p>
            <div class="ui ti-p-steps">
              {[['Clear the counter', '5 min'], ['Dishes in the dishwasher', '10 min'], ['Wipe the surfaces', '5 min'], ['Take the bin out', '2 min']].map(([s, m], i) => (
                <div class="ui ti-p-step">
                  <span class="t ti-p-step-n">{i + 1}</span>
                  <span class="t ti-p-step-t">{s}</span>
                  <button class="ui ti-p-time" data-toggle aria-label={`Edit time for ${s}`}><span class="t">{m}</span></button>
                </div>
              ))}
            </div>
            <button class="ti-p-undo t" data-back>↺ Undo, keep it as one task</button>
            <button class="btn ti-p-cta ti-p-mt" data-go="today"><span class="t">Add to today</span></button>
          </div>
        </div>
      </section>

      <!-- Today timeline -->
      <section class="scr ti-p" data-screen="today" data-title="Today timeline">
        <div class="ti-p-scroll ti-p-scroll--tabs" data-scroll>
          <div class="ti-p-pad ti-p-top ti-p-top--tight">
            <p class="t ti-p-kicker">Tuesday 14</p>
            <h4 class="t ti-p-h1 ti-p-h1--today">Today</h4>
            <div class="ti-p-week ui">
              {['M', 'T', 'W', 'T', 'F', 'S', 'S'].map((d, i) => <span class:list={['t', { 'is-on': i === 1 }]}>{d}<b>{13 + i}</b></span>)}
            </div>
            <div class="ti-p-tl">
              {
                timeline.map((b) =>
                  b.go ? (
                    <button class="ui ti-p-blk ti-p-blk--now" style={`--c:${b.c};min-height:${b.h}px`} data-go={b.go}>
                      <span class="ico ti-p-blk-e">{b.e}</span>
                      <span class="ti-p-blk-txt"><span class="t ti-p-blk-t">{b.t}</span><span class="t ti-p-blk-s">{b.s}</span></span>
                      <span class="ti-p-blk-disc img" aria-hidden="true"></span>
                    </button>
                  ) : (
                    <div class="ui ti-p-blk" style={`--c:${b.c};min-height:${b.h}px`}>
                      <span class="ico ti-p-blk-e">{b.e}</span>
                      <span class="ti-p-blk-txt"><span class="t ti-p-blk-t">{b.t}</span><span class="t ti-p-blk-s">{b.s}</span></span>
                    </div>
                  ),
                )
              }
              <span class="ti-p-now" aria-hidden="true"><span>10:14</span></span>
            </div>
          </div>
        </div>
        <button class="btn ti-p-fab" data-go="braindump" aria-label="Add to brain dump"><span class="t">+</span></button>
        <nav class="ti-p-tabs ui" aria-label="App tabs">
          <button class="is-on" data-go="today"><span class="ico"></span><span class="t">Today</span></button>
          <button data-go="todo"><span class="ico"></span><span class="t">To-dos</span></button>
          <button data-go="mood"><span class="ico"></span><span class="t">Check-in</span></button>
        </nav>
      </section>

      <!-- Task detail -->
      <section class="scr ti-p" data-screen="task" data-title="Task detail">
        <div class="ti-p-taskhead img" style={`background:${TI.lilac}`}><span>💻</span></div>
        <div class="ti-p-pad ti-p-taskbody">
          <button class="ti-p-back t" data-back>‹ Today</button>
          <h4 class="t ti-p-h2">Focus: Friday deck</h4>
          <p class="t ti-p-p">10:00 – 11:30 · 3 small steps</p>
          <div class="ti-p-checks">
            {['Outline five slides', 'Find the usage chart', 'Write the ask'].map((s, i) => (
              <button class:list={['ui', 'ti-p-check', { 'is-on': i === 0 }]} data-toggle>
                <span class="ico ti-p-box"></span><span class="t">{s}</span>
              </button>
            ))}
          </div>
          <div class="ui ti-p-timerpick">
            <span class="t ti-p-label">Timer</span>
            <span class="t ti-p-timerpick-v">25 min · disc</span>
          </div>
        </div>
        <div class="ti-p-pad ti-p-bottom">
          <button class="btn ti-p-cta" data-go="focus"><span class="t">Start focus</span></button>
        </div>
      </section>

      <!-- Focus timer -->
      <section class="scr ti-p ti-p-focus" data-screen="focus" data-title="Focus timer">
        <div class="ti-p-pad ti-p-top ti-p-center">
          <p class="t ti-p-kicker">Now · step 2 of 3</p>
          <h4 class="t ti-p-h2">Find the usage chart</h4>
          <div class="ti-p-disc img" aria-hidden="true"><i></i></div>
          <p class="t ti-p-giant">15:30</p>
          <p class="t ti-p-p">left of 25 minutes</p>
          <div class="ti-p-grid2">
            <button class="ui ti-p-soft" data-toggle><span class="t">+5 min</span></button>
            <button class="ui ti-p-soft" data-go="live"><span class="t">Lock screen</span></button>
          </div>
        </div>
        <div class="ti-p-pad ti-p-bottom">
          <button class="btn ti-p-cta" data-go="mood" data-sheet><span class="t">Done, check in</span></button>
        </div>
      </section>

      <!-- Lock screen Live Activity -->
      <section class="scr ti-p ti-p-lock" data-screen="live" data-title="Lock screen Live Activity">
        <div class="ti-p-pad ti-p-center ti-p-lock-top">
          <p class="t ti-p-lock-date">Tuesday 14 October</p>
          <p class="t ti-p-lock-time">10:14</p>
        </div>
        <div class="ti-p-pad ti-p-lock-bottom">
          <button class="ui ti-p-live" data-back>
            <span class="ti-p-live-disc img" aria-hidden="true"></span>
            <span class="ti-p-live-txt"><span class="t ti-p-live-t">Find the usage chart</span><span class="t ti-p-live-s">15 min left · then “Write the ask”</span></span>
            <span class="t ti-p-live-n">+5</span>
          </button>
          <p class="t ti-p-lock-hint">Tap the Live Activity to go back</p>
        </div>
      </section>

      <!-- To-dos -->
      <section class="scr ti-p" data-screen="todo" data-title="To-dos">
        <div class="ti-p-scroll ti-p-scroll--tabs" data-scroll>
          <div class="ti-p-pad ti-p-top">
            <h4 class="t ti-p-h2">To-dos</h4>
            <p class="t ti-p-p">Sorted by the co-planner. Drag anything to today.</p>
            {[
              ['Now', [['📞', 'Call the dentist'], ['✉️', 'Reply to Sam']]],
