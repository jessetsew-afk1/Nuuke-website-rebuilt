<script>
  // Prototype extras: the reading-style and theme choices restyle the whole prototype.
  document.querySelectorAll<HTMLButtonElement>('[data-ti-pfont]').forEach((b) =>
    b.addEventListener('click', () => {
      const screen = b.closest<HTMLElement>('.device-screen');
      if (!screen) return;
      screen.classList.toggle('ti-dys', b.dataset.tiPfont === 'dys');
      b.parentElement?.querySelectorAll<HTMLButtonElement>('[data-ti-pfont]').forEach((x) => {
        x.classList.toggle('is-on', x === b);
        x.setAttribute('aria-pressed', String(x === b));
      });
    }),
  );
  document.querySelectorAll<HTMLButtonElement>('[data-ti-ptheme]').forEach((b) =>
    b.addEventListener('click', () => {
      const screen = b.closest<HTMLElement>('.device-screen');
      if (!screen) return;
      screen.style.setProperty('--ti-acc', b.dataset.tiPtheme!);
      b.parentElement?.querySelectorAll<HTMLButtonElement>('[data-ti-ptheme]').forEach((x) => {
        x.classList.toggle('is-on', x === b);
        x.setAttribute('aria-pressed', String(x === b));
      });
    }),
  );
</script>

