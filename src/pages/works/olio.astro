<script>
  // Design-system live components.
  const req = document.querySelector<HTMLButtonElement>('[data-ds-req]');
  const LABELS = ['Request', 'Requested · waiting', 'Reserved for you ✓'];
  req?.addEventListener('click', () => {
    const s = (Number(req.dataset.state) + 1) % 3;
    req.dataset.state = String(s);
    req.textContent = LABELS[s];
  });
  document.querySelectorAll<HTMLButtonElement>('[data-ds-chip]').forEach((c) =>
    c.addEventListener('click', () => c.setAttribute('aria-pressed', String(c.getAttribute('aria-pressed') !== 'true'))),
  );
  const add = document.querySelector<HTMLButtonElement>('[data-ds-add]');
  add?.addEventListener('click', () => {
    add.classList.remove('is-pressed');
    void add.offsetWidth;
    add.classList.add('is-pressed');
  });
  // Live age counter on the sample card, starting when it scrolls into view.
  const card = document.querySelector<HTMLElement>('[data-ds-card]');
  const age = document.querySelector<HTMLElement>('[data-ds-age]');
  if (card && age) {
    let start = 0;
    let timer = 0;
    const io = new IntersectionObserver((es) => {
      const vis = es.some((e) => e.isIntersecting);
      if (vis && !timer) {
        if (!start) start = Date.now();
        card.classList.add('is-new');
        timer = window.setInterval(() => {
          const s = Math.floor((Date.now() - start) / 1000);
          age.textContent = s < 10 ? 'just now' : s < 60 ? `${s} s ago` : `${Math.floor(s / 60)} min ago`;
        }, 1000);
      } else if (!vis && timer) {
        clearInterval(timer);
        timer = 0;
      }
    });
    io.observe(card);
  }
</script>

