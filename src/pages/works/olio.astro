---
import Case from '../../layouts/Case.astro';
import Chapter from '../../components/case/Chapter.astro';
import Brief from '../../components/case/Brief.astro';
import Personas from '../../components/case/Personas.astro';
import FlowMap from '../../components/case/FlowMap.astro';
import ScreenStack from '../../components/case/ScreenStack.astro';
import Prototype from '../../components/case/Prototype.astro';
import DesignSystem from '../../components/case/DesignSystem.astro';
import Metrics from '../../components/case/Metrics.astro';
import OlioHero from '../../components/cases/olio/Hero.astro';
import Blueprint from '../../components/cases/olio/Blueprint.astro';
import SpeedSim from '../../components/cases/olio/SpeedSim.astro';
import OlioOpening from '../../components/cases/olio/Opening.astro';
import { bySlug } from '../../data/projects';
import { olioLayers } from '../../data/cases/olio';

const p = bySlug('olio');
const chapters = [
  { id: 'brief', label: 'Brief' },
  { id: 'research', label: 'Research' },
  { id: 'blueprint', label: 'Service blueprint' },
  { id: 'speed', label: 'Speed is the product' },
  { id: 'flow', label: 'User flow' },
  { id: 'layers', label: '3D wireframe' },
  { id: 'prototype', label: 'Prototype' },
  { id: 'system', label: 'Design system' },
  { id: 'measure', label: 'Measure' },
];
const sources = [
  { label: 'The Grocer — 10th anniversary, 120M meals', url: 'https://www.thegrocer.co.uk/news/olio-food-waste-app-marks-10th-anniversary-with-120-million-meal-landmark/707257.article' },
  { label: 'Olio — 10 years of Olio', url: 'https://olioapp.com/business/2025/07/16/looking-back-at-10-years-of-olio-and-120-million-meals-rescued/' },
  { label: 'Olio — Meet the new look Olio', url: 'https://olioapp.com/en/olio-updates/meet-the-new-look-olio/' },
  { label: 'Wholegrain Digital — Olio’s low-carbon site', url: 'https://www.wholegraindigital.com/blog/olio-sustainable-site/' },
  { label: 'Olio help — adding listings', url: 'https://help.olioapp.com/en/articles/12158761-how-do-i-add-edit-and-remove-my-listings' },
  { label: 'Olio help — becoming a Supporter', url: 'https://help.olioapp.com/en/articles/12140082-becoming-an-olio-supporter' },
  { label: 'Olio help — Wanted listings', url: 'https://help.olioapp.com/article/23-wanted' },
  { label: 'TechCrunch — $43M Series B', url: 'https://techcrunch.com/2021/09/05/food-sharing-app-olio-raises-43m-series-b-as-the-world-switches-on-to-the-food-waste-crisis/' },
  { label: 'TechCrunch — Series A (2018)', url: 'https://techcrunch.com/2018/07/11/olio' },
  { label: 'Grocery Gazette — Tesco × Olio 30M meals', url: 'https://www.grocerygazette.co.uk/2023/02/08/tesco-save-meals-with-olio-app/' },
  { label: 'The Grocer — Tesco partnership hits 100M meals', url: 'https://www.thegrocer.co.uk/news/tescos-olio-food-waste-partnership-hits-100-million-meals/723887.article' },
  { label: 'Design Museum — Beazley Designs of the Year 2019', url: 'https://designmuseum.org/exhibitions/beazley-designs-of-the-year/digital-2019/olio-the-food-sharing-app' },
  { label: 'About Amazon — Tessa Clarke interview', url: 'https://www.aboutamazon.co.uk/news/aws/olios-tessa-clarke-tackling-food-waste-with-hyper-local-community-sharing-app' },
  { label: 'Olio on LinkedIn — “Share More, Waste Less”', url: 'https://www.linkedin.com/company/olio-share-more-waste-less' },
  { label: 'Wikipedia — Olio (app)', url: 'https://en.wikipedia.org/wiki/Olio_(app)' },
];
const meta = [
  { label: 'Brand', value: 'Olio, London' },
  { label: 'Discipline', value: 'Mobile app · service design' },
  { label: 'Our role', value: 'Research, blueprint, flows, prototype, UI system' },
  { label: 'Timeline (concept)', value: '5-week design sprint' },
];
const personas = [
  { name: 'Saver Sam', meta: '27 · renter in Manchester', quote: 'If it’s free and round the corner, tell me now, not in an hour.', goals: ['See what’s nearby right now', 'Request in one tap, with a time', 'Know for sure it’s his'], pains: ['Turning up to “already gone”', 'Long back-and-forth chats', 'Alerts for things across town'], color: '#ff6b5b' },
  { name: 'Declutter Diane', meta: '54 · gives things away in Bristol', quote: 'Snap a photo, set a time, done. I don’t want twenty messages.', goals: ['List in under a minute', 'Pick a collector fairly, fast', 'Porch pickup so she needn’t wait in'], pains: ['Writing descriptions', 'A flood of requests to answer', 'No-shows'], color: '#ffd23f' },
  { name: 'Hero Hamid', meta: '40 · volunteer Food Waste Hero', quote: 'I collect a bag of thirty items. Listing them one by one takes longer than the pickup.', goals: ['Batch-list a whole bag', 'Hand everything out before it expires', 'Show the store what its food did'], pains: ['The same form thirty times', 'Late-night chat juggling', 'Leftovers at the end of the night'], color: '#ff9a3d' },
];
const nodes = [
  { id: 'onboard', label: 'Get / Give / Volunteer', x: 95, y: 220, kind: 'start' as const },
  { id: 'home', label: 'Nearby feed', x: 270, y: 220, kind: 'key' as const },
  { id: 'map', label: 'Map view', x: 445, y: 70 },
  { id: 'detail', label: 'Listing detail', x: 615, y: 70 },
  { id: 'request', label: 'Request', x: 785, y: 70 },
  { id: 'chat', label: 'Chat', x: 945, y: 70 },
  { id: 'pickup', label: 'Pickup', x: 1105, y: 140, kind: 'end' as const },
  { id: 'add', label: 'Add · camera', x: 445, y: 230 },
  { id: 'draft', label: 'AI-ify draft', x: 615, y: 230, kind: 'key' as const },
  { id: 'times', label: 'Pickup times', x: 785, y: 230 },
  { id: 'published', label: 'Live!', x: 945, y: 230 },
  { id: 'hero', label: 'Hero dashboard', x: 445, y: 370 },
  { id: 'batch', label: 'Add Collection', x: 615, y: 370, kind: 'key' as const },
  { id: 'impact', label: 'Impact', x: 1105, y: 320, kind: 'end' as const },
];
const edges = [
  { from: 'onboard', to: 'home' },
  { from: 'home', to: 'map', label: 'browse' },
  { from: 'map', to: 'detail' },
  { from: 'detail', to: 'request' },
  { from: 'request', to: 'chat' },
  { from: 'chat', to: 'pickup' },
  { from: 'home', to: 'add' },
  { from: 'add', to: 'draft' },
  { from: 'draft', to: 'times' },
  { from: 'times', to: 'published' },
  { from: 'home', to: 'hero', label: 'volunteer' },
  { from: 'hero', to: 'batch' },
  { from: 'batch', to: 'published', label: 'publish all' },
  { from: 'published', to: 'impact' },
];
const tasks = [
  { label: 'Tell Olio you’re here to get food', screen: 'home' },
  { label: 'Switch to the map and find the closest food', screen: 'map' },
  { label: 'Request the sourdough with a quick reply', screen: 'chat' },
  { label: 'Confirm the pickup', screen: 'pickup' },
  { label: 'Give something away: let AI-ify write it', screen: 'draft' },
  { label: 'Publish it to your neighbours', screen: 'published' },
  { label: 'Batch-list a Food Waste Hero collection', screen: 'batch' },
  { label: 'See your impact', screen: 'impact' },
];
const feed = [
  { e: '🥕🥬', bg: 'linear-gradient(135deg,#ffd0c4,#ff6b5b)', t: 'Veg box, slightly wonky', m: '600 m · 9 min ago', tag: 'Food' },
  { e: '🥾', bg: 'linear-gradient(135deg,#ede6ff,#b9a3f5)', t: 'Kids’ wellies, size 10', m: '800 m · 21 min ago', tag: 'Non-food' },
  { e: '🍋🍋', bg: 'linear-gradient(135deg,#fff1b3,#ffd23f)', t: 'Lemons ×6 from a party', m: '950 m · 34 min ago', tag: 'Food' },
];
const batchItems = [
  ['🥪', 'Sandwiches ×4', ''],
  ['🥗', 'Salad bowls ×2', ''],
  ['🥐', 'Pastries ×6', ''],
  ['🍌', 'Bananas ×5', ''],
  ['🧃', 'Juice ×3', 'check date'],
  ['🍞', 'Bread ×2', ''],
  ['🧁', 'Muffins ×4', ''],
  ['🥛', 'Milk ×2', 'check date'],
  ['🍅', 'Tomatoes', ''],
];
---

<Case project={p} chapters={chapters} sources={sources} meta={meta}>
  <OlioHero slot="hero" />
  <OlioOpening />

  <Chapter id="brief" n="01" label="The brief" title="Giving food away should be faster than binning it.">
    <Brief
      story="Olio began with a failed handover: on moving day in 2014, co-founder Tessa Clarke couldn’t find anyone to take her good food. With Saasha Celestial-One she founded Olio in London in 2015, an app where neighbours give away, request, borrow and lend food and household things, mostly for free. Businesses pay Olio so that trained volunteer <strong>Food Waste Heroes</strong> collect their unsold food and list it in the app. Its mission: a world where “<em>nothing of value goes to waste</em>”. Its 2023 rebrand traded green for warm colours and an idea it calls “urgent optimism”."
      facts={[
        { v: '2015', k: 'Founded in London; tested first in a 12-person WhatsApp group' },
        { v: '8.8M', k: 'Users in 60 countries at its 10th anniversary (2025)' },
        { v: '120M', k: 'Meals shared through the app by its 10th anniversary' },
        { v: '150k', k: 'Food-safety-trained volunteers, collecting from 8,500 locations a month' },
      ]}
      problems={[
        { title: 'Speed is the product', text: 'Good food goes in minutes. Discovery and alerts must surface local, time-critical items fairly, without notification overload.' },
        { title: 'Trust between strangers', text: 'The doorstep handover has to feel safe and polite on both sides: clear pickup etiquette, visible reliability, no awkward no-shows.' },
        { title: 'Make the volunteer engine scale', text: 'A Food Waste Hero bag holds 10–40 items. Listing it should be a 60-second job, not thirty forms.' },
      ]}
      goal="Photo to live in under a minute, reserved in minutes, collected without awkwardness, for one loaf or a whole bag."
    />
  </Chapter>

  <Chapter id="research" n="02" label="Research" title="Three neighbours, one shared clock." intro="Olio is a two-sided market that happens on a doorstep. We modelled a collector, a giver and a volunteer from Olio’s public audience, then timed every step of their journeys. For all three, the enemy is the same: <strong>minutes</strong>.">
    <Personas personas={personas} />
  </Chapter>

  <Chapter id="blueprint" n="03" label="Service blueprint" title="Two journeys that meet on a doorstep." intro="A normal journey map follows one person. Olio needs two, plus the backstage systems that connect them. Both lanes converge on the <strong>handover</strong>, the twenty seconds where trust is won or lost. Tap any moment for the insight and the opportunity we found.">
    <Blueprint />
  </Chapter>

  <Chapter id="speed" n="04" label="Speed is the product" title="Watch a loaf find a new home in 34 minutes." intro="We played our design rules forward, minute by minute, for a single listing. The key proposal is <strong>fair waves</strong>: alert the closest neighbours first, widen the circle only if nobody asks, and stop the moment it’s reserved. Press play, or drag the timeline.">
    <SpeedSim />
    <p class="t-small ol-disclaimer">This is an illustrative scenario we wrote to test our own design rules: the times, distances and neighbour counts are invented for the walkthrough. It is not Olio data, and the “fair waves” rule is our proposal, not a description of how Olio works today.</p>
  </Chapter>

  <Chapter id="flow" n="05" label="User flow" title="Three ways in. One purple button." intro="Collectors browse, givers add, volunteers batch. Every path is reachable from the Nearby feed, and the purple <strong>Add</strong> button sits in the same spot on every screen. Tap a screen to open it in the prototype.">
    <FlowMap nodes={nodes} edges={edges} width={1190} height={440} />
  </Chapter>

  <Chapter id="layers" n="06" label="3D wireframe" title="The Nearby feed, taken apart." intro="Five layers make the home feed. Scroll to assemble it, and drag to look around. Notice how little is purple: we kept it for the actions that make sharing happen.">
    <ScreenStack layers={olioLayers} accent={p.accent} />
  </Chapter>

  <Chapter id="prototype" n="07" label="Prototype" title="Get, give, volunteer. Try all three." intro="Fourteen screens, fully tappable. Follow the tasks on the left, then flip to <strong>Sketch</strong> or <strong>Wireframe</strong> to see how each screen started.">
    <Prototype title="Olio · list → request → pickup" start="onboard" tasks={tasks} device="light" note="Eight tasks across all three personas. Chips, switches and AI-ify are live.">
      <!-- 1. Onboarding -->
      <section class="scr ol ol-onboard" data-screen="onboard" data-title="Onboarding · what do you want to do?">
        <div class="ol-blob img" aria-hidden="true"><span>🥖</span><span>🍎</span><span>🪴</span></div>
        <div class="ol-pad ol-top ol-onboard-body">
          <p class="t ol-kicker">Hi neighbour · 1 km around you</p>
          <h4 class="t ol-h1">What do you want to do?</h4>
          <div class="ol-options">
            <button class="ui ol-option is-on" data-toggle><span class="ico ol-opt-ico" style="background:#ffd0c4">🛍️</span><span><span class="t ol-row-t">Get</span><br /><span class="t ol-row-s">Free food & things nearby</span></span><span class="ico ol-check"></span></button>
            <button class="ui ol-option" data-toggle><span class="ico ol-opt-ico" style="background:#fff1b3">🎁</span><span><span class="t ol-row-t">Give</span><br /><span class="t ol-row-s">Share what you won’t use</span></span><span class="ico ol-check"></span></button>
            <button class="ui ol-option" data-toggle><span class="ico ol-opt-ico" style="background:#ffe0c2">🦸</span><span><span class="t ol-row-t">Volunteer</span><br /><span class="t ol-row-s">Become a Food Waste Hero</span></span><span class="ico ol-check"></span></button>
          </div>
          <div class="ui ol-row ol-notify">
            <span><span class="t ol-row-t">Alert me about food within</span><br /><span class="t ol-row-s">Closest first. Never more than you ask for.</span></span>
          </div>
          <div class="ol-chips">
            <button class="ui ol-chip" data-toggle><span class="t">300 m</span></button>
            <button class="ui ol-chip is-on" data-toggle><span class="t">600 m</span></button>
            <button class="ui ol-chip" data-toggle><span class="t">1 km</span></button>
          </div>
        </div>
        <div class="ol-pad ol-bottom">
          <button class="btn ol-cta" data-go="home"><span class="t">Start sharing</span></button>
        </div>
      </section>

      <!-- 2. Home feed -->
      <section class="scr ol" data-screen="home" data-title="Nearby feed">
        <div class="ol-scroll" data-scroll>
          <div class="ol-pad ol-top">
            <div class="ol-head">
              <div><h4 class="t ol-h1">Nearby</h4><p class="t ol-row-s">Within 600 m · 17:33</p></div>
              <button class="ui ol-round" data-go="map" aria-label="Map view"><span class="ico">🗺️</span></button>
            </div>
            <div class="ol-chips ol-chips--scroll">
              <button class="ui ol-chip is-on" data-toggle><span class="t">All</span></button>
              <button class="ui ol-chip" data-toggle><span class="t">Food</span></button>
              <button class="ui ol-chip" data-toggle><span class="t">Non-food</span></button>
              <button class="ui ol-chip" data-toggle><span class="t">Wanted</span></button>
              <button class="ui ol-chip" data-toggle><span class="t">Borrow</span></button>
            </div>
            <p class="t ol-kicker">Just added</p>
            <button class="ui ol-card" data-go="detail">
              <span class="img ol-photo" style="background:linear-gradient(135deg,#ffd23f,#ff9a3d)"><span>🥖🥯</span><span class="ol-age"><i class="ol-pulse"></i>2 min</span></span>
              <span class="ol-card-body">
                <span class="t ol-card-t">Sourdough + 4 bagels</span>
                <span class="t ol-row-s">350 m · today 6–8 pm · porch pickup</span>
                <span class="btn ol-mini"><span class="t">Request</span></span>
              </span>
            </button>
            <button class="ui ol-hero-banner" data-go="hero">
              <span class="ico ol-opt-ico" style="background:#ff9a3d">🦸</span>
              <span><span class="t ol-row-t">Tonight’s collection is ready</span><br /><span class="t ol-row-s">Food Waste Hero · list your bag</span></span>
              <span class="t ol-chev">›</span>
            </button>
            {
              feed.map((f) => (
                <div class="ui ol-row ol-feed-row">
                  <span class="img ol-thumb" style={`background:${f.bg}`}>{f.e}</span>
                  <span><span class="t ol-row-t">{f.t}</span><br /><span class="t ol-row-s">{f.m}</span></span>
                  <span class="t ol-tag">{f.tag}</span>
                </div>
              ))
            }
          </div>
        </div>
        <nav class="ol-tabs ui">
          <button class="is-on" data-go="home"><span class="ico">🏠</span><span class="t">Nearby</span></button>
          <button data-go="map"><span class="ico">🗺️</span><span class="t">Map</span></button>
          <button class="ol-add btn" data-go="add" aria-label="Add a listing"><span>＋</span></button>
          <button data-go="hero"><span class="ico">🦸</span><span class="t">Hero</span></button>
          <button data-go="impact"><span class="ico">🙂</span><span class="t">Me</span></button>
        </nav>
      </section>

      <!-- 3. Map -->
      <section class="scr ol" data-screen="map" data-title="Map view">
        <svg class="img ol-map" viewBox="0 0 390 844" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <rect width="390" height="844" fill="#fff3e2" />
          <path d="M0 690 C 90 650 160 740 260 710 S 360 740 390 720 V844 H0Z" fill="#e6dcff" />
          <rect x="230" y="150" width="120" height="110" rx="16" fill="#fbe3a6" />
          <g fill="none" stroke="#fffdf8" stroke-width="16"><path d="M0 130 H390 M0 290 H390 M0 450 H390 M0 600 H390 M80 0 V844 M210 0 V844 M330 0 V844" /><path d="M0 760 L390 210" stroke-width="22" /></g>
          <circle cx="195" cy="420" r="150" fill="rgb(110 59 217 / .07)" stroke="#6e3bd9" stroke-width="2" stroke-dasharray="6 8" />
          <circle cx="195" cy="420" r="9" fill="#6e3bd9" stroke="#fff" stroke-width="4" />
        </svg>
        <div class="ol-pins" aria-hidden="true">
          <span class="ol-pin ol-pin--hot" style="left:63%;top:39%">🥖</span>
          <span class="ol-pin" style="left:24%;top:30%">🥕</span>
          <span class="ol-pin" style="left:78%;top:58%">🍋</span>
          <span class="ol-pin ol-pin--cluster" style="left:30%;top:63%">3</span>
          <span class="ol-pin" style="left:52%;top:22%">🥾</span>
        </div>
        <div class="ol-pad ol-top ol-map-top">
          <div class="ol-head">
            <button class="ui ol-round" data-back aria-label="Back"><span class="ico">‹</span></button>
            <div class="ui ol-search"><span class="t">Food · within 600 m</span></div>
          </div>
          <span class="t ol-supporter">Map view · Supporter perk</span>
        </div>
        <button class="ui ol-map-card" data-go="detail">
          <span class="img ol-thumb" style="background:linear-gradient(135deg,#ffd23f,#ff9a3d)">🥖</span>
          <span><span class="t ol-row-t">Sourdough + 4 bagels</span><br /><span class="t ol-row-s">350 m · 4 min walk · 2 min ago</span></span>
          <span class="btn ol-mini"><span class="t">View</span></span>
        </button>
      </section>

      <!-- 4. Listing detail -->
      <section class="scr ol" data-screen="detail" data-title="Listing detail">
        <div class="ol-scroll ol-scroll--cta" data-scroll>
          <div class="img ol-gallery" style="background:linear-gradient(135deg,#ffd23f,#ff9a3d)">
            <span class="ol-gallery-e">🥖🥯</span>
            <span class="ol-dots"><i class="is-on"></i><i></i><i></i></span>
          </div>
          <button class="ui ol-round ol-float-back" data-back aria-label="Back"><span class="ico">‹</span></button>
          <div class="ol-pad ol-detail">
            <div class="ol-tags"><span class="t ol-tag">Food</span><span class="t ol-tag ol-tag--hot">Added 2 min ago</span><span class="t ol-tag">350 m</span></div>
            <h4 class="t ol-h2">Sourdough + 4 bagels</h4>
            <p class="t ol-p">Baked yesterday, too much for one. Lovely toasted. Bagged and ready on the porch.</p>
            <div class="ui ol-row">
              <span class="ico ol-opt-ico" style="background:#ede6ff">🕕</span>
              <span><span class="t ol-row-t">Today, 6–8 pm</span><br /><span class="t ol-row-s">Porch pickup OK · address after reserving</span></span>
            </div>
            <div class="ui ol-row">
              <span class="ico ol-avatar">D</span>
              <span><span class="t ol-row-t">Diane</span><br /><span class="t ol-row-s">★ 4.9 · 212 shares · usually replies in 5 min</span></span>
              <span class="t ol-verified">ID ✓</span>
            </div>
            <p class="t ol-row-s">Sample listing for this concept.</p>
          </div>
        </div>
        <div class="ol-cta-bar ui">
          <button class="ui ol-round" data-toggle aria-label="Save"><span class="ico">♡</span></button>
          <button class="btn ol-cta" data-go="request" data-sheet><span class="t">Request</span></button>
        </div>
      </section>

      <!-- 5. Request sheet -->
      <section class="scr ol ol-sheet-scr" data-screen="request" data-title="Request (sheet)">
        <div class="ol-sheet ui">
          <div class="ol-grabber"></div>
          <h4 class="t ol-h2">Request this?</h4>
          <p class="t ol-p">Pick a time. Diane sees it first, so she can choose quickly.</p>
          <div class="ol-quick">
            <button class="ui ol-chip is-on" data-toggle><span class="t">I can come at 6pm</span></button>
            <button class="ui ol-chip" data-toggle><span class="t">Any time after 7</span></button>
            <button class="ui ol-chip" data-toggle><span class="t">Can collect in 10 min</span></button>
          </div>
          <div class="ui ol-input"><span class="t">Hi Diane! Would love the bread for dinner 🙂</span></div>
          <button class="btn ol-cta" data-go="chat"><span class="t">Send request</span></button>
          <button class="ol-link t" data-back>Not now</button>
        </div>
      </section>

      <!-- 6. Chat -->
      <section class="scr ol" data-screen="chat" data-title="Chat">
        <div class="ol-chat-head ui">
          <button class="ol-back t" data-back aria-label="Back">‹</button>
          <span class="ico ol-avatar">D</span>
          <span><span class="t ol-row-t">Diane</span><br /><span class="t ol-row-s">Sourdough + 4 bagels</span></span>
          <span class="t ol-reserved">Reserved for you</span>
        </div>
        <div class="ol-msgs">
          <p class="t ol-msg ol-msg--me">I can come at 6pm 🙂</p>
          <p class="t ol-msg">Perfect, it’s yours! Porch pickup is fine, blue door.</p>
          <div class="ui ol-sys">
            <span class="t ol-row-t">✓ Reserved · today 6:00 pm</span>
            <span class="t ol-row-s">Address shared with you only · 4 min walk</span>
          </div>
          <p class="t ol-msg ol-msg--me">Brilliant, thank you!</p>
        </div>
        <div class="ol-chat-foot">
          <div class="ol-quick ol-quick--row">
            <button class="ui ol-chip" data-toggle><span class="t">On my way</span></button>
            <button class="ui ol-chip" data-toggle><span class="t">Running 10 min late</span></button>
            <button class="ui ol-chip" data-toggle><span class="t">Thank you!</span></button>
          </div>
          <button class="btn ol-cta" data-go="pickup"><span class="t">Confirm pickup at 6:00 pm</span></button>
        </div>
      </section>

      <!-- 7. Pickup -->
      <section class="scr ol" data-screen="pickup" data-title="Pickup confirmed">
