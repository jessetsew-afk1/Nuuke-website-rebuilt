---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import AboutHero from '../components/about/AboutHero.astro';
import Manifesto from '../components/about/Manifesto.astro';
import CrewManifest from '../components/about/CrewManifest.astro';
import Constellation from '../components/about/Constellation.astro';
import MissionLog from '../components/about/MissionLog.astro';

// TODO(owner): add awards here once each is confirmed with a link to the award page.
const awards: { year: string; project: string; award: string; org: string; href: string }[] = [];
---

<Base title="About" description="NUUKE is a specialized unit for market domination, not a vendor. Meet the crew behind our mobile, 3D, animation, marketing and AI work.">
  <AboutHero />
  <Manifesto />
  <CrewManifest />
  <Constellation />
  <MissionLog />

  {
    awards.length > 0 && (
      <section class="section container" aria-labelledby="awards-title">
        <h2 id="awards-title" class="t-h2">Recognition</h2>
        <ul class="ab-awards" role="list">
          {awards.map((a) => (
            <li>
              <span class="t-num">{a.year}</span>
              <span>{a.project}</span>
              <span>{a.award}</span>
              <a href={a.href} target="_blank" rel="noopener">
                {a.org} ↗
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <Cta />
</Base>

<style>
  .ab-awards { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  .ab-awards li { display: grid; grid-template-columns: 6rem 1fr 1fr 1fr; gap: var(--s-4); padding-block: var(--s-4); border-bottom: 1px solid var(--line); }
  @media (max-width: 700px) {
    .ab-awards li { grid-template-columns: 1fr; gap: var(--s-1); }
  }
</style>
