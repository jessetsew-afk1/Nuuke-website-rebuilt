---
// Monochrome partner marks that take the current text colour.
// Bright Systems has no published logo file, so this is a wordmark built around the light bulb on
// their site; Knight Market has no logo yet, so this is our design.
interface Props {
  mark: 'bright' | 'piermont' | 'knight';
}
const { mark } = Astro.props;
---

{
  mark === 'bright' && (
    <svg class="pm pm--bright" viewBox="0 0 260 56" role="img" aria-label="Bright Systems">
      <g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M28 11a12 12 0 0 0-7.4 21.4c1.6 1.3 2.4 3 2.4 4.9v1.7h10v-1.7c0-1.9.8-3.6 2.4-4.9A12 12 0 0 0 28 11z" />
        <path d="M23.5 43h9M24.8 47h6.4M25 31l3-4 3 4" />
        <path d="M28 2.5v3.5M12.5 9l2.5 2.5M43.5 9 41 11.5M7.5 23H11M45 23h3.5" />
      </g>
      <text x="58" y="27" fill="currentColor" font-family="Montserrat, sans-serif" font-weight="800" font-size="19" letter-spacing="2.4">BRIGHT</text>
      <text x="58" y="47" fill="currentColor" font-family="Inter, sans-serif" font-weight="500" font-size="12.5" letter-spacing="6.2">SYSTEMS</text>
    </svg>
  )
}
{mark === 'piermont' && <img class="pm pm--piermont" src="/partners/piermont-studios.webp" alt="Piermont Studios" width="477" height="200" loading="lazy" decoding="async" />}
{
  mark === 'knight' && (
    <svg class="pm pm--knight" viewBox="0 0 250 56" role="img" aria-label="Knight Market">
      <g fill="currentColor">
        <path d="M14 50h26v-4.5H14z" />
        <path d="M16.5 44h21l-2.2-5.6c4.6-4.6 6-11.6 3.4-18.4C36 13.6 30 9 23.6 8.4L20.4 5l-1.2 4.4c-3.9 2-6.6 5.7-7.5 10.1l-1.3 6.4 4.6 2 4.8-3.4 3.5.9c-3 3.4-5.8 7-7.1 10.9z" />
      </g>
      <circle cx="20.8" cy="17.2" r="1.6" fill="var(--bg, #050506)" />
      <path d="M52 8v40" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.5" />
      <text x="64" y="27" fill="currentColor" font-family="Montserrat, sans-serif" font-weight="800" font-size="19" letter-spacing="2.6">KNIGHT</text>
      <text x="64" y="47" fill="currentColor" font-family="Inter, sans-serif" font-weight="500" font-size="12.5" letter-spacing="7.6">MARKET</text>
    </svg>
  )
}

<style>
  .pm { display: block; height: 100%; width: auto; }
</style>
