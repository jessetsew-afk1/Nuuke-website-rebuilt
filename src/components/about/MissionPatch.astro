---
// An embroidered-style mission patch for each crew station (decorative).
interface Props {
  kind: 'command' | 'signal' | 'navigation';
  label: string;
  code: string;
  color: string;
}
const { kind, label, code, color } = Astro.props;
const pid = `ab-patch-${kind}`;
---

<svg class="ab-patch" viewBox="-60 -60 120 120" aria-hidden="true" focusable="false">
  <defs>
    <path id={pid} d="M -39 0 A 39 39 0 1 1 39 0 A 39 39 0 1 1 -39 0" />
  </defs>
  <circle r="57" fill="#0b0b10" stroke={color} stroke-width="3" />
  <circle r="53" fill="none" stroke={color} stroke-width="1" stroke-dasharray="2 3" opacity="0.8" />
  <circle r="31" fill="#15151d" stroke="#f5f5f6" stroke-opacity="0.25" />
  <text class="ab-patch-txt" fill="#f5f5f6"><textPath href={`#${pid}`} startOffset="0">NUUKE · {label} · {code} ·</textPath></text>
  {
    kind === 'command' && (
      <g>
        <path d="M0 -24 L 5 -5 L 24 0 L 5 5 L 0 24 L -5 5 L -24 0 L -5 -5 Z" fill={color} />
        <path d="M0 -24 L 5 -5 L 0 0 Z M24 0 L 5 5 L 0 0 Z M0 24 L -5 5 L 0 0 Z M-24 0 L -5 -5 L 0 0 Z" fill="#000" opacity="0.25" />
        <circle cx="14" cy="-15" r="1.6" fill="#f5f5f6" />
        <circle cx="-16" cy="13" r="1.2" fill="#f5f5f6" />
      </g>
    )
  }
  {
    kind === 'signal' && (
      <g fill="none" stroke={color} stroke-width="3.2" stroke-linecap="round">
        <circle cx="-12" cy="12" r="4" fill={color} stroke="none" />
        <path d="M -12 -1 A 13 13 0 0 1 1 12" />
        <path d="M -12 -11 A 23 23 0 0 1 11 12" opacity="0.75" />
        <path d="M -12 -21 A 33 33 0 0 1 21 12" opacity="0.45" />
      </g>
    )
  }
  {
    kind === 'navigation' && (
      <g>
        <ellipse rx="24" ry="10" fill="none" stroke="#f5f5f6" stroke-opacity="0.5" transform="rotate(-24)" />
        <circle r="6" fill={color} />
        <path d="M -20 14 Q -4 -26 20 -12" fill="none" stroke={color} stroke-width="2.4" stroke-dasharray="3 3" />
        <path d="M 20 -12 l -7 -2 l 3 6 z" fill={color} />
        <circle cx="-20" cy="14" r="2.4" fill="#f5f5f6" />
      </g>
    )
  }
</svg>

<style>
  .ab-patch { width: 100%; height: auto; }
  .ab-patch-txt { font-family: var(--font-ui); font-size: 8.6px; font-weight: 700; letter-spacing: 0.2em; }
</style>
