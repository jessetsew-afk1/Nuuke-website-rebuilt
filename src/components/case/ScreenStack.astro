---
// 3D exploded view of one screen's design layers. Scroll to assemble; drag to orbit.
export type StackLayer = { label: string; desc: string; svg: string };
interface Props {
  layers: StackLayer[];
  accent: string;
}
const { layers, accent } = Astro.props;
const payload = JSON.stringify({ accent, layers: layers.map((l) => ({ label: l.label, svg: l.svg })) });
---

<div class="stack" data-stack>
  <div class="stack-canvas-wrap">
    <canvas class="stack-canvas" data-stack-canvas aria-label="3D exploded view of the screen layers"></canvas>
    <p class="t-small stack-hint">Scroll to assemble · drag to orbit</p>
  </div>
  <ol class="stack-list" role="list">
    {
      layers.map((l, i) => (
        <li data-layer={i}>
          <span class="t-num">L{i + 1}</span>
          <div>
            <p class="stack-label">{l.label}</p>
            <p class="t-small">{l.desc}</p>
          </div>
        </li>
      ))
    }
  </ol>
  <script type="application/json" data-stack-data set:html={payload} />
</div>

<script>
  import { whenNear } from '../../scripts/motion';
  document.querySelectorAll<HTMLElement>('[data-stack]').forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-stack-canvas]')!;
    const data = JSON.parse(root.querySelector('[data-stack-data]')!.textContent || '{}');
    whenNear(root, () => import('../../scripts/three/stack').then((m) => m.initStack(root, canvas, data.layers, data.accent)));
  });
</script>

<style>
  .stack { display: grid; grid-template-columns: 1.3fr 1fr; gap: var(--s-7); align-items: center; min-height: 120vh; }
  .stack-canvas-wrap { position: sticky; top: 10vh; height: 80vh; border-radius: var(--r-lg); overflow: hidden; background: radial-gradient(60% 60% at 50% 50%, color-mix(in srgb, var(--a, var(--accent)) 14%, transparent), transparent 70%); }
  .stack-canvas { width: 100%; height: 100%; touch-action: pan-y; cursor: grab; }
  .stack-canvas:active { cursor: grabbing; }
  .stack-hint { position: absolute; left: 50%; bottom: var(--s-4); transform: translateX(-50%); white-space: nowrap; }
  .stack-list { list-style: none; padding: 0; display: grid; gap: var(--s-3); }
  .stack-list li { display: flex; gap: var(--s-4); padding: var(--s-5); border-radius: var(--r-md); border: 1px solid var(--line); transition: border-color var(--dur-2), background var(--dur-2), transform var(--dur-2) var(--ease-out); }
  .stack-list li.is-active { border-color: var(--a, var(--accent)); background: color-mix(in srgb, var(--a, var(--accent)) 8%, transparent); transform: translateX(-6px); }
  .stack-list .t-num { color: var(--a, var(--accent)); font-weight: 700; }
  .stack-label { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-lg); }
  @media (max-width: 900px) {
    .stack { grid-template-columns: 1fr; min-height: 0; }
    .stack-canvas-wrap { position: relative; top: 0; height: 70vh; }
  }
</style>
