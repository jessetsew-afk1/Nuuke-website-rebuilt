---
// A numbered case-study chapter. The id feeds the sticky chapter rail.
interface Props {
  id: string;
  n: string;
  label: string;
  title: string;
  intro?: string;
  wide?: boolean;
}
const { id, n, label, title, intro, wide = false } = Astro.props;
---

<section id={id} class:list={['chapter', { 'chapter--wide': wide }]} aria-labelledby={`${id}-title`}>
  <div class="container chapter-head">
    <p class="t-label chapter-kicker" data-reveal><span class="t-num">{n}</span> — {label}</p>
    <h2 id={`${id}-title`} class="t-h2 chapter-title" data-split="words">{title}</h2>
    {intro && <p class="t-lead measure" data-reveal set:html={intro} />}
  </div>
  <div class:list={[{ container: !wide }]}>
    <slot />
  </div>
</section>

<style>
  .chapter { position: relative; padding-block: var(--section) 0; scroll-margin-top: 80px; }
  .chapter:last-of-type { padding-bottom: var(--section); }
  .chapter-head { display: grid; gap: var(--s-4); margin-bottom: var(--s-8); }
  .chapter-kicker .t-num { color: var(--a, var(--accent)); }
  .chapter-title { max-width: 18ch; }
</style>
