---
// User-flow diagram. Nodes are screens; clicking one opens that screen in the prototype below.
export type FlowNode = { id: string; label: string; x: number; y: number; kind?: 'start' | 'key' | 'end' };
export type FlowEdge = { from: string; to: string; label?: string };
interface Props {
  nodes: FlowNode[];
  edges: FlowEdge[];
  width?: number;
  height?: number;
  target?: string; // id of the Prototype to drive
}
const { nodes, edges, width = 1100, height = 420, target = 'proto' } = Astro.props;
const NW = 150;
const NH = 52;
const pos = Object.fromEntries(nodes.map((n) => [n.id, n]));
const path = (e: FlowEdge) => {
  const a = pos[e.from];
  const b = pos[e.to];
  const x1 = a.x + NW / 2;
  const y1 = a.y;
  const x2 = b.x - NW / 2;
  const y2 = b.y;
  if (x2 > x1) {
    const mx = (x1 + x2) / 2;
    return `M ${x1} ${y1} C ${mx} ${y1}, ${mx} ${y2}, ${x2} ${y2}`;
  }
  // Backwards edge: loop underneath.
  const dy = Math.max(y1, y2) + 90;
  return `M ${a.x} ${a.y + NH / 2} C ${a.x} ${dy}, ${b.x} ${dy}, ${b.x} ${b.y + NH / 2}`;
};
---

<div class="flow" data-flow={target}>
  <div class="flow-scroll">
    <svg viewBox={`0 0 ${width} ${height}`} class="flow-svg" role="img" aria-label="User flow diagram">
      <defs>
        <marker id={`arrow-${target}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 L10 5 L0 10 z" class="flow-arrow" />
        </marker>
      </defs>
      {
        edges.map((e) => (
          <g class="flow-edge" data-edge={`${e.from}>${e.to}`}>
            <path d={path(e)} marker-end={`url(#arrow-${target})`} />
            {e.label && (
              <text x={(pos[e.from].x + pos[e.to].x) / 2} y={(pos[e.from].y + pos[e.to].y) / 2 - 10} text-anchor="middle">
                {e.label}
              </text>
            )}
          </g>
        ))
      }
      {
        nodes.map((n) => (
          <g class:list={['flow-node', n.kind && `flow-node--${n.kind}`]} data-node={n.id} tabindex="0" role="button" aria-label={`Open ${n.label} in the prototype`}>
            <rect x={n.x - NW / 2} y={n.y - NH / 2} width={NW} height={NH} rx="14" />
            <text x={n.x} y={n.y + 5} text-anchor="middle">{n.label}</text>
          </g>
        ))
      }
    </svg>
  </div>
  <p class="t-small flow-hint">Tap any screen to open it in the prototype ↓</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-flow]').forEach((root) => {
    const target = root.dataset.flow!;
    const nodes = root.querySelectorAll<SVGGElement>('[data-node]');
    const go = (id: string) => {
      window.dispatchEvent(new CustomEvent('proto:go', { detail: { target, screen: id, scroll: true } }));
    };
    nodes.forEach((n) => {
      const id = n.dataset.node!;
      n.addEventListener('click', () => go(id));
      n.addEventListener('keydown', (e) => (e.key === 'Enter' || e.key === ' ') && go(id));
      n.addEventListener('mouseenter', () => {
        root.querySelectorAll<SVGGElement>('[data-edge]').forEach((e) => {
          const [a, b] = e.dataset.edge!.split('>');
          e.classList.toggle('is-hot', a === id || b === id);
        });
      });
      n.addEventListener('mouseleave', () => root.querySelectorAll('[data-edge]').forEach((e) => e.classList.remove('is-hot')));
    });
    // Reflect the prototype's current screen.
    window.addEventListener('proto:changed', (ev) => {
      const { target: t, screen } = (ev as CustomEvent).detail;
      if (t !== target) return;
      nodes.forEach((n) => n.classList.toggle('is-current', n.dataset.node === screen));
    });
  });
</script>

<style>
  .flow { display: grid; gap: var(--s-3); }
  .flow-scroll { overflow-x: auto; border-radius: var(--r-lg); border: 1px solid var(--line); background: radial-gradient(circle at 1px 1px, rgb(255 255 255 / 0.08) 1px, transparent 0) 0 0 / 22px 22px, var(--bg-2); padding: var(--s-4); }
  .flow-svg { min-width: 820px; width: 100%; height: auto; }
  .flow-edge path { fill: none; stroke: var(--line-strong); stroke-width: 2; stroke-dasharray: 6 6; animation: flowdash 1.2s linear infinite; transition: stroke var(--dur-1); }
  .flow-edge.is-hot path { stroke: var(--a, var(--accent)); stroke-width: 3; }
  .flow-edge text { fill: var(--muted); font: 500 12px var(--font-ui); }
  .flow-arrow { fill: var(--line-strong); }
  @keyframes flowdash { to { stroke-dashoffset: -12; } }
  .flow-node { cursor: pointer; outline: none; }
  .flow-node rect { fill: var(--surface-2); stroke: var(--line-strong); stroke-width: 1.5; transition: fill var(--dur-1), stroke var(--dur-1), transform var(--dur-2) var(--ease-out); }
  .flow-node text { fill: var(--ink); font: 600 13px var(--font-ui); pointer-events: none; }
  .flow-node--start rect { stroke: var(--a, var(--accent)); }
  .flow-node--key rect { fill: color-mix(in srgb, var(--a, var(--accent)) 22%, var(--surface-2)); }
  .flow-node:hover rect, .flow-node:focus-visible rect { stroke: var(--ink); fill: color-mix(in srgb, var(--a, var(--accent)) 35%, var(--surface-2)); }
  .flow-node.is-current rect { fill: var(--a, var(--accent)); stroke: var(--ink); }
  .flow-node.is-current text { fill: var(--a-ink, #111); }
  .flow-hint { text-align: right; }
</style>
