---
// Interactive funnel: click a stage to see its job, channels, formats and KPIs.
import { funnel, FW } from '../../../data/cases/fishwife';
const colors = [FW.red, FW.sun, FW.pink, FW.mint];
---

<div class="fw-funnel" data-fw-funnel>
  <div class="fw-funnel-shape" role="tablist" aria-label="Funnel stages" aria-orientation="vertical">
    {
      funnel.map((s, i) => (
        <button
          type="button"
          role="tab"
          id={`fw-ft-${s.id}`}
          aria-controls={`fw-fp-${s.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class="fw-stage"
          style={`--w:${100 - i * 15}%;--c:${colors[i]}`}
          data-stage={i}
        >
          <span class="fw-stage-n t-num">0{i + 1}</span>
          <span class="fw-stage-l">{s.label}</span>
        </button>
      ))
    }
    <p class="t-small fw-funnel-tip">Tap a stage · arrow keys work too</p>
  </div>

  <div class="fw-funnel-panels">
    {
      funnel.map((s, i) => (
        <section class="fw-panel" role="tabpanel" id={`fw-fp-${s.id}`} aria-labelledby={`fw-ft-${s.id}`} hidden={i !== 0} style={`--c:${colors[i]}`}>
          <p class="t-label">
            Stage {i + 1} · {s.label} · <span class="fw-who">{s.who}</span>
          </p>
          <p class="fw-job">{s.job}</p>
          <div class="fw-cols">
            <div>
              <p class="t-label">Channels</p>
              <ul role="list" class="fw-chips">
                {s.channels.map((c) => <li>{c}</li>)}
              </ul>
            </div>
            <div>
              <p class="t-label">Content formats</p>
              <ul role="list" class="fw-list">
                {s.formats.map((c) => <li>{c}</li>)}
              </ul>
            </div>
            <div>
              <p class="t-label">KPIs we’d watch</p>
              <ul role="list" class="fw-list fw-kpi">
                {s.kpis.map((c) => <li>{c}</li>)}
              </ul>
            </div>
          </div>
        </section>
      ))
    }
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-fw-funnel]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(i === j));
        t.tabIndex = i === j ? 0 : -1;
      });
      panels.forEach((p, j) => (p.hidden = i !== j));
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); select((i + 1) % tabs.length, true); }
        if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); select((i - 1 + tabs.length) % tabs.length, true); }
      });
    });
  });
</script>

<style>
  .fw-funnel { display: grid; grid-template-columns: minmax(260px, 0.8fr) 1.2fr; gap: var(--s-7); align-items: start; }
  .fw-funnel-shape { display: grid; justify-items: center; gap: 6px; position: sticky; top: 110px; }
  .fw-stage {
    position: relative;
    width: var(--w);
    height: 84px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-3);
    color: #1d1b3a;
    background: var(--c);
    clip-path: polygon(0 0, 100% 0, calc(100% - 26px) 100%, 26px 100%);
    opacity: 0.45;
    transition: opacity var(--dur-2), transform var(--dur-2) var(--ease-out), filter var(--dur-2);
  }
  .fw-stage:hover { opacity: 0.75; }
  .fw-stage[aria-selected='true'] { opacity: 1; transform: scale(1.04); }
  .fw-stage:focus-visible { outline: none; opacity: 1; }
  .fw-stage:focus-visible .fw-stage-l { text-decoration: underline; text-underline-offset: 4px; }
  .fw-stage-n { font-weight: 700; font-size: var(--fs-sm); opacity: 0.7; }
  .fw-stage-l { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-lg); letter-spacing: -0.02em; }
  .fw-funnel-tip { margin-top: var(--s-3); }

  .fw-panel { display: grid; gap: var(--s-5); padding: var(--s-6); border-radius: var(--r-lg); border: 1px solid var(--line); background: linear-gradient(160deg, color-mix(in srgb, var(--c) 14%, var(--surface)), var(--surface)); animation: fw-panel-in 0.5s var(--ease-out); }
  @keyframes fw-panel-in { from { opacity: 0; transform: translateY(12px); } }
  .fw-who { color: var(--ink); text-transform: none; letter-spacing: 0; }
  .fw-job { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-xl); line-height: 1.2; letter-spacing: -0.02em; color: var(--ink); }
  .fw-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-5); }
  .fw-cols .t-label { margin-bottom: var(--s-3); }
  .fw-chips { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .fw-chips li { padding: 0.35rem 0.7rem; border-radius: var(--r-pill); border: 1px solid color-mix(in srgb, var(--c) 60%, transparent); font: 500 0.82rem/1.3 var(--font-ui); color: var(--ink); }
  .fw-list { list-style: none; padding: 0; display: grid; gap: var(--s-2); color: var(--ink-2); font-size: var(--fs-sm); }
  .fw-list li { padding-left: 1.1em; position: relative; }
  .fw-list li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 7px; height: 7px; border-radius: 50%; background: var(--c); }
  .fw-kpi li::before { border-radius: 2px; }
  @media (max-width: 1100px) { .fw-cols { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 860px) {
    .fw-funnel { grid-template-columns: 1fr; gap: var(--s-5); }
    .fw-funnel-shape { position: static; }
    .fw-stage { height: 64px; }
    .fw-cols { grid-template-columns: 1fr; }
    .fw-panel { padding: var(--s-5); }
  }
</style>
