---
// Data-visualisation lab: one sample dataset, five chart forms, five questions.
// Pick a question, flip chart types, and read our verdict on each pairing.
// Charts are pre-drawn SVG; the categorical palette was validated on the navy surface
// (lightness band, chroma, colour-blind separation, contrast).
import { labCats, labIncome, labMonths, labSpent, labSaved, labQuestions, chartTypes, usd } from '../../../data/cases/copilot-money';

const W = 360;
const H = 300;
const pct = (n: number) => Math.round((n / labSpent) * 100);

// Bar (horizontal, sorted).
const sorted = [...labCats].sort((a, b) => b.amount - a.amount);
const bx0 = 96;
const bScale = 200 / 2000;
const bars = sorted.map((c, i) => ({ ...c, y: 26 + i * 44, w: c.amount * bScale, bud: bx0 + c.budget * bScale, over: c.amount - c.budget }));

// Line (flexible categories, rent is fixed and left out).
const flex = labCats.filter((c) => c.id !== 'rent');
const lx = (i: number) => 44 + i * ((W - 44 - 80) / (labMonths.length - 1));
const ly = (v: number) => 262 - ((v - 200) / 600) * 232;
const lines = flex.map((c) => ({ ...c, d: c.trend.map((v, i) => `${i ? 'L' : 'M'} ${lx(i).toFixed(1)} ${ly(v).toFixed(1)}`).join(' ') }));

// Donut.
const R = 84;
const C = 2 * Math.PI * R;
let acc = 0;
const arcs = labCats.map((c) => {
  const len = (c.amount / labSpent) * C;
  const a = { ...c, len: Math.max(0, len - 3), off: -acc, mid: (acc + len / 2) / C };
  acc += len;
  return a;
});
const rentMid = arcs[0].mid * Math.PI * 2 - Math.PI / 2;

// Treemap: rent column, then two rows.
const g = 2;
const byId = Object.fromEntries(labCats.map((c) => [c.id, c]));
const restT = labSpent - byId.rent.amount;
const rentW = (byId.rent.amount / labSpent) * W;
const top = ['other', 'groceries'];
const bot = ['dining', 'shopping', 'transport'];
const topSum = top.reduce((s, k) => s + byId[k].amount, 0);
const topH = (topSum / restT) * H;
const rw = W - rentW;
type Tile = { c: (typeof labCats)[number]; x: number; y: number; w: number; h: number };
const tiles: Tile[] = [{ c: byId.rent, x: 0, y: 0, w: rentW, h: H }];
let tx = rentW;
top.forEach((k) => {
  const w = (byId[k].amount / topSum) * rw;
  tiles.push({ c: byId[k], x: tx, y: 0, w, h: topH });
  tx += w;
});
tx = rentW;
const botSum = restT - topSum;
bot.forEach((k) => {
  const w = (byId[k].amount / botSum) * rw;
  tiles.push({ c: byId[k], x: tx, y: topH, w, h: H - topH });
  tx += w;
});

// Flow: one paycheck splits into categories + saved.
const fTop = 18;
const fH = 264;
const nodes = [...labCats.map((c) => ({ id: c.id, name: c.name, amount: c.amount, color: c.color })), { id: 'saved', name: 'Saved', amount: labSaved, color: '#00CC4B' }];
const gap = 6;
const fScale = (fH - gap * (nodes.length - 1)) / labIncome;
let ly0 = fTop;
let ry0 = fTop;
const flows = nodes.map((n) => {
  const h = n.amount * fScale;
  const l = ly0;
  const r = ry0;
  ly0 += h;
  ry0 += h + gap;
  const x0 = 34;
  const x1 = 222;
  const mx = (x0 + x1) / 2;
  const d = `M ${x0} ${l} C ${mx} ${l}, ${mx} ${r}, ${x1} ${r} L ${x1} ${r + h} C ${mx} ${r + h}, ${mx} ${l + h}, ${x0} ${l + h} Z`;
  return { ...n, h, r, d };
});
const verdictLabel = { win: 'Our pick', ok: 'Works', poor: 'Struggles' } as const;
const data = JSON.stringify(labQuestions.map((q) => ({ id: q.id, win: q.win, verdicts: q.verdicts })));
---

<div class="cml" data-cml data-q={labQuestions[0].id} data-chart="bar" data-verdicts={data}>
  <div class="cml-qs">
    <p class="t-label">1 · Pick a question</p>
    <div class="cml-qlist" role="group" aria-label="Questions">
      {
        labQuestions.map((q, i) => (
          <button type="button" class="cml-q" data-q-btn={q.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            <span class="t-num">Q{i + 1}</span>
            <span>{q.q}</span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="cml-main">
    <div class="cml-types-row">
      <p class="t-label">2 · Try a chart</p>
      <div class="cml-types" role="group" aria-label="Chart type">
        {
          chartTypes.map((c, i) => (
            <button type="button" data-chart-btn={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>
              <span class="cml-star" aria-hidden="true">★</span>
              {c.label}
            </button>
          ))
        }
      </div>
    </div>

    <figure class="cml-fig">
      <figcaption class="cml-cap">
        <span class="cml-cap-t">Sample household · September</span>
        <span class="cml-cap-s">Income {usd(labIncome)} · spent {usd(labSpent)} · kept {usd(labSaved)}</span>
      </figcaption>
      <div class="cml-charts">
        <!-- BAR -->
        <svg class="cml-chart" data-chart-svg="bar" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Bar chart: September spending by category with budget marks. Dining is $120 over, Groceries $40 over.">
          {
            bars.map((b, i) => (
              <g class:list={['cml-bar', { 'is-over': b.over > 0 }]} style={`--i:${i}`}>
                <title>{`${b.name}: ${usd(b.amount)} of ${usd(b.budget)} budget`}</title>
                <text x={bx0 - 8} y={b.y + 12} text-anchor="end" class="cml-t2">
                  {b.name}
                </text>
                <path class="cml-grow" d={`M ${bx0} ${b.y} h ${b.w - 4} a 4 4 0 0 1 4 4 v 8 a 4 4 0 0 1 -4 4 h ${-(b.w - 4)} Z`} fill={b.color} />
                <line x1={b.bud} x2={b.bud} y1={b.y - 5} y2={b.y + 21} class="cml-budget" />
                <text x={bx0 + b.w + 8} y={b.y + 12} class="cml-t1">
                  {usd(b.amount)}
                  {b.over > 0 && <tspan class="cml-over"> ▲{usd(b.over)}</tspan>}
                </text>
              </g>
            ))
          }
          <line x1={bx0} x2={bx0} y1="14" y2="286" class="cml-axis" />
          <text x={W - 4} y="294" text-anchor="end" class="cml-t3">│ = budget</text>
        </svg>

        <!-- LINE -->
        <svg class="cml-chart" data-chart-svg="line" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Line chart: monthly spend April to September for five flexible categories. Dining rises every month, from $360 to $520.">
          {
            [200, 400, 600, 800].map((v) => (
              <g>
                <line x1="44" x2={W - 80} y1={ly(v)} y2={ly(v)} class="cml-grid" />
                <text x="38" y={ly(v) + 4} text-anchor="end" class="cml-t3">
                  {usd(v)}
                </text>
              </g>
            ))
          }
          {labMonths.map((m, i) => <text x={lx(i)} y="290" text-anchor="middle" class="cml-t3">{m}</text>)}
          {
            lines.map((l, i) => (
              <g class:list={['cml-line', `cml-line--${l.id}`]} style={`--i:${i}`}>
                <title>{`${l.name}: ${l.trend.map((v) => usd(v)).join(', ')}`}</title>
                <path d={l.d} fill="none" stroke={l.color} stroke-width="2" stroke-linejoin="round" stroke-linecap="round" pathLength="1" class="cml-draw" />
                <circle cx={lx(5)} cy={ly(l.trend[5])} r="4.5" fill={l.color} stroke="#001533" stroke-width="2" />
              </g>
            ))
          }
          <text x={lx(5) + 10} y={ly(520) + 4} class="cml-t1 cml-endlabel">Dining {usd(520)}</text>
          <text x={lx(5) + 10} y={ly(520) + 18} class="cml-t3 cml-endlabel">▲ 44% vs. Apr</text>
          <text x={W - 4} y="12" text-anchor="end" class="cml-t3">Rent (fixed) not shown</text>
        </svg>

        <!-- DONUT -->
        <svg class="cml-chart" data-chart-svg="donut" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Donut chart: share of September spending. Rent is ${pct(byId.rent.amount)}% of ${usd(labSpent)}.`}>
          <g transform={`translate(${W / 2} ${H / 2}) rotate(-90)`}>
            {
              arcs.map((a, i) => (
                <circle class:list={['cml-arc', `cml-arc--${a.id}`]} r={R} fill="none" stroke={a.color} stroke-width="34" stroke-dasharray={`${a.len} ${C}`} stroke-dashoffset={a.off} style={`--i:${i}`}>
                  <title>{`${a.name}: ${usd(a.amount)} (${pct(a.amount)}%)`}</title>
                </circle>
              ))
            }
          </g>
          <text x={W / 2} y={H / 2 - 2} text-anchor="middle" class="cml-big">{usd(labSpent)}</text>
          <text x={W / 2} y={H / 2 + 18} text-anchor="middle" class="cml-t3">spent in September</text>
          <text x={W / 2 + Math.cos(rentMid) * (R + 30)} y={H / 2 + Math.sin(rentMid) * (R + 30) + 4} text-anchor="start" class="cml-t1">
            Rent {pct(byId.rent.amount)}%
          </text>
        </svg>

        <!-- TREEMAP -->
        <svg class="cml-chart" data-chart-svg="tree" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Treemap: September spending, each category a rectangle sized by amount. Rent is the largest.">
          {
            tiles.map((t, i) => (
              <g class:list={['cml-tile', `cml-tile--${t.c.id}`]} style={`--i:${i}`}>
                <title>{`${t.c.name}: ${usd(t.c.amount)}`}</title>
                <rect x={t.x + g / 2} y={t.y + g / 2} width={t.w - g} height={t.h - g} rx="6" fill={t.c.color} />
                {t.w > 56 && (
                  <text x={t.x + 10} y={t.y + 22} class="cml-in">
                    {t.c.name}
                  </text>
                )}
                {t.w > 56 && t.h > 44 && (
                  <text x={t.x + 10} y={t.y + 38} class="cml-in cml-in--v">
                    {usd(t.c.amount)}
                  </text>
                )}
              </g>
            ))
          }
        </svg>

        <!-- FLOW -->
        <svg class="cml-chart" data-chart-svg="flow" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Flow chart: a ${usd(labIncome)} paycheck splits into six spending categories and ${usd(labSaved)} saved, about ${Math.round((labSaved / labIncome) * 100)}%.`}>
          {
            flows.map((f, i) => (
              <g class:list={['cml-ribbon', `cml-ribbon--${f.id}`]} style={`--i:${i}`}>
                <title>{`${f.name}: ${usd(f.amount)}`}</title>
                <path d={f.d} fill={f.color} />
                <rect x="222" y={f.r} width="10" height={f.h} rx="2" fill={f.color} />
              </g>
            ))
          }
          <rect x="22" y={fTop} width="12" height={fH - gap * (nodes.length - 1)} rx="3" fill="#00CC4B" />
          <text x="18" y={fTop - 6} class="cml-t3">Pay {usd(labIncome)}</text>
          {
            flows.map((f) => (
              <text x="240" y={f.r + f.h / 2 + 4} class:list={[f.id === 'saved' ? 'cml-t1' : 'cml-t2']}>
                {f.name} {usd(f.amount)}
                {f.id === 'saved' && ` · ${Math.round((f.amount / labIncome) * 100)}%`}
              </text>
            ))
          }
        </svg>
      </div>
      <ul class="cml-legend" role="list">
        {labCats.map((c) => <li><i style={`background:${c.color}`} />{c.name}</li>)}
        <li class="cml-legend-saved"><i style="background:#00CC4B" />Saved / income</li>
      </ul>
    </figure>
  </div>

  <aside class="cml-verdict" aria-live="polite">
    <p class="t-label">3 · Our verdict</p>
    <p class="cml-badge" data-cml-badge>{verdictLabel[labQuestions[0].verdicts.bar.v]}</p>
    <p class="cml-why" data-cml-why>{labQuestions[0].verdicts.bar.t}</p>
    <button type="button" class="cml-pick" data-cml-pick>Show our pick ★</button>
    <details class="cml-table">
      <summary>See the data as a table</summary>
      <div class="cml-tablewrap">
        <table>
          <caption class="visually-hidden">Sample spending by category, April to September</caption>
          <thead>
            <tr><th scope="col">Category</th>{labMonths.map((m) => <th scope="col">{m}</th>)}<th scope="col">Budget</th></tr>
          </thead>
          <tbody>
            {labCats.map((c) => <tr><th scope="row">{c.name}</th>{c.trend.map((v) => <td>{usd(v)}</td>)}<td>{usd(c.budget)}</td></tr>)}
          </tbody>
        </table>
      </div>
    </details>
  </aside>
</div>

<script>
  type V = { v: 'win' | 'ok' | 'poor'; t: string };
  type Q = { id: string; win: string; verdicts: Record<string, V> };
  const LABEL = { win: 'Our pick', ok: 'Works', poor: 'Struggles' };
  document.querySelectorAll<HTMLElement>('[data-cml]').forEach((root) => {
    const qs: Q[] = JSON.parse(root.dataset.verdicts || '[]');
    const qBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-q-btn]')];
    const cBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-chart-btn]')];
    const svgs = [...root.querySelectorAll<SVGSVGElement>('[data-chart-svg]')];
    const badge = root.querySelector<HTMLElement>('[data-cml-badge]')!;
    const why = root.querySelector<HTMLElement>('[data-cml-why]')!;
    const pick = root.querySelector<HTMLButtonElement>('[data-cml-pick]')!;
    let q = qs[0];
    let chart = 'bar';
    const render = () => {
      root.dataset.q = q.id;
      root.dataset.chart = chart;
      qBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.qBtn === q.id)));
      cBtns.forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.chartBtn === chart));
        b.classList.toggle('is-win', b.dataset.chartBtn === q.win);
      });
      svgs.forEach((s) => {
        const on = s.dataset.chartSvg === chart;
        if (on && !s.classList.contains('is-on')) {
          // Restart the entrance animation.
          s.classList.remove('is-on');
          void s.getBoundingClientRect();
        }
        s.classList.toggle('is-on', on);
      });
      const v = q.verdicts[chart];
      badge.textContent = LABEL[v.v];
      badge.dataset.v = v.v;
      why.textContent = v.t;
      pick.hidden = chart === q.win;
    };
    qBtns.forEach((b) => b.addEventListener('click', () => { q = qs.find((x) => x.id === b.dataset.qBtn) || q; render(); }));
    cBtns.forEach((b) => b.addEventListener('click', () => { chart = b.dataset.chartBtn!; render(); }));
    pick.addEventListener('click', () => { chart = q.win; render(); });
    render();
  });
</script>

<style>
  .cml { display: grid; grid-template-columns: minmax(220px, 0.8fr) minmax(0, 1.4fr) minmax(240px, 0.9fr); gap: var(--s-6); align-items: start; padding: var(--s-7); border-radius: calc(var(--r-lg) + 8px); border: 1px solid var(--line); background: radial-gradient(50% 60% at 50% 40%, rgb(28 108 255 / 0.12), transparent 70%), var(--bg-2); }
  .cml-qs, .cml-main, .cml-verdict { display: grid; gap: var(--s-3); align-content: start; min-width: 0; }
  .cml-qlist { display: grid; gap: var(--s-2); }
  .cml-q { display: grid; grid-template-columns: auto 1fr; gap: var(--s-3); align-items: baseline; text-align: left; padding: 0.75rem 0.9rem; border-radius: var(--r-md); border: 1px solid var(--line); color: var(--ink-2); font-size: var(--fs-sm); line-height: 1.35; transition: border-color var(--dur-1), background var(--dur-1), color var(--dur-1); }
  .cml-q .t-num { color: var(--muted); font-weight: 700; }
  .cml-q:hover { border-color: var(--line-strong); color: var(--ink); }
  .cml-q[aria-pressed='true'] { border-color: #1c6cff; background: rgb(28 108 255 / 0.12); color: var(--ink); }
  .cml-q[aria-pressed='true'] .t-num { color: #6b9dff; }

  .cml-types-row { display: grid; gap: var(--s-3); }
  .cml-types { display: flex; flex-wrap: wrap; gap: 6px; }
  .cml-types button { position: relative; display: inline-flex; align-items: center; gap: 4px; padding: 0.55rem 0.95rem; border-radius: var(--r-pill); border: 1px solid var(--line-strong); font: 600 var(--fs-sm) / 1 var(--font-ui); color: var(--ink-2); transition: background var(--dur-1), color var(--dur-1), border-color var(--dur-1); }
  .cml-types button:hover { color: var(--ink); }
  .cml-types button[aria-pressed='true'] { background: #f2f6ff; border-color: #f2f6ff; color: #000814; }
  .cml-star { display: none; color: #fece4c; }
  .cml-types button.is-win .cml-star { display: inline; }
  .cml-types button.is-win[aria-pressed='true'] .cml-star { color: #8a5d00; }

  .cml-fig { display: grid; gap: var(--s-3); padding: var(--s-5); border-radius: var(--r-lg); background: #001533; border: 1px solid #1b3157; }
  .cml-cap { display: grid; gap: 2px; }
  .cml-cap-t { font: 700 var(--fs-base) / 1.3 var(--font-ui); color: #f2f6ff; }
  .cml-cap-s { font: 500 var(--fs-sm) / 1.3 var(--font-ui); color: #a9b7d3; }
  .cml-charts { display: grid; }
  .cml-chart { grid-area: 1 / 1; width: 100%; height: auto; opacity: 0; visibility: hidden; overflow: visible; font-family: var(--font-ui); }
  .cml-chart.is-on { opacity: 1; visibility: visible; animation: cm-lab-in 0.5s var(--ease-out); }
  @keyframes cm-lab-in { from { opacity: 0; transform: scale(0.97); } }
  .cml-t1 { fill: #f2f6ff; font-size: 12px; font-weight: 700; }
  .cml-t2 { fill: #c6d1e6; font-size: 12px; font-weight: 500; }
  .cml-t3 { fill: #a9b7d3; font-size: 10.5px; }
  .cml-big { fill: #f2f6ff; font-size: 26px; font-weight: 800; letter-spacing: -0.02em; }
  .cml-in { fill: #000814; font-size: 12px; font-weight: 700; }
  .cml-in--v { font-weight: 500; }
  .cml-over { fill: #ff8a7a; font-weight: 700; }
  .cml-axis, .cml-grid { stroke: #1b3157; stroke-width: 1; }
  .cml-budget { stroke: #f2f6ff; stroke-width: 2; stroke-linecap: round; }

  /* Entrances (restart each time a chart is shown). */
  .cml-chart.is-on .cml-grow { transform-box: fill-box; transform-origin: left center; animation: cm-lab-grow 0.7s var(--ease-out) both; animation-delay: calc(var(--i) * 0.06s); }
  @keyframes cm-lab-grow { from { transform: scaleX(0); } }
  .cml-chart.is-on .cml-draw { stroke-dasharray: 1; animation: cm-lab-draw 1.1s var(--ease-out) both; animation-delay: calc(var(--i) * 0.08s); }
  @keyframes cm-lab-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  .cml-chart.is-on .cml-arc, .cml-chart.is-on .cml-tile, .cml-chart.is-on .cml-ribbon { animation: cm-lab-pop 0.6s var(--ease-out) both; animation-delay: calc(var(--i) * 0.06s); }
  @keyframes cm-lab-pop { from { opacity: 0; } }

  /* Each question puts the spotlight on what answers it. */
  .cml-bar, .cml-line, .cml-arc, .cml-tile, .cml-ribbon { transition: opacity var(--dur-2); }
  [data-q='over'] .cml-bar:not(.is-over) .cml-grow { opacity: 0.4; }
  [data-q='trend'] .cml-line:not(.cml-line--dining) { opacity: 0.35; }
  [data-q='share'] .cml-arc:not(.cml-arc--rent) { opacity: 0.35; }
  [data-q='keep'] .cml-ribbon:not(.cml-ribbon--saved) path { opacity: 0.3; }
  .cml-ribbon path { opacity: 0.55; }
  [data-q='keep'] .cml-ribbon--saved path { opacity: 0.85; }
  .cml-endlabel { opacity: 0; }
  [data-q='trend'] .cml-endlabel, [data-chart='line'] .cml-endlabel { opacity: 1; }

  .cml-legend { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 14px; font: 500 var(--fs-label) / 1.2 var(--font-ui); color: #c6d1e6; }
  .cml-legend li { display: inline-flex; align-items: center; gap: 6px; }
  .cml-legend i { width: 10px; height: 10px; border-radius: 3px; }
  .cml-legend-saved { display: none !important; }
  [data-chart='flow'] .cml-legend-saved { display: inline-flex !important; }

  .cml-badge { justify-self: start; padding: 0.45rem 0.9rem; border-radius: var(--r-pill); font: 800 var(--fs-sm) / 1 var(--font-ui); letter-spacing: 0.04em; background: var(--surface-2); color: var(--ink); }
  .cml-badge[data-v='win'] { background: #fece4c; color: #000814; }
  .cml-badge[data-v='win']::before { content: '★ '; }
  .cml-badge[data-v='ok'] { background: #0a2147; color: #c6d1e6; }
  .cml-badge[data-v='poor'] { background: rgb(255 68 51 / 0.16); color: #ff8a7a; }
  .cml-why { color: var(--ink-2); font-size: var(--fs-base); line-height: 1.55; min-height: 7.5em; }
  .cml-pick { justify-self: start; padding: 0.6rem 1rem; border-radius: var(--r-pill); background: #00cc4b; color: #000814; font: 700 var(--fs-sm) / 1 var(--font-ui); }
  .cml-table { margin-top: var(--s-3); font-size: var(--fs-sm); color: var(--ink-2); }
  .cml-table summary { cursor: pointer; font-family: var(--font-ui); font-weight: 600; color: var(--ink); }
