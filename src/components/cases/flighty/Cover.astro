---
// Card cover for Flighty: a night departure board beside a globe with a live great-circle arc.
// Original NUUKE artwork, code-drawn (no brand assets).
import type { Project } from '../../../data/projects';
import { AIRPORTS as A, arcPath, graticule, project as proj, FL } from '../../../data/cases/flighty';
interface Props {
  project: Project;
}
const { project: p } = Astro.props;
const view = { lat0: 38, lon0: -97, cx: 590, cy: 330, r: 420 };
const DISC = 220;
const grat = graticule(view, 15);
const routes: [string, string, string][] = [
  ['DEN', 'ORD', FL.late],
  ['ORD', 'SFO', FL.ok],
  ['ORD', 'JFK', FL.ok],
  ['AUS', 'SEA', FL.sky],
];
const dots = Object.values(A)
  .map((a) => ({ a, p: proj(a.lat, a.lon, view) }))
  .filter((d) => Math.hypot(d.p.x - view.cx, d.p.y - view.cy) < DISC - 8);
const pl = proj(42.6, -106, view);
const o = proj(A.ORD.lat, A.ORD.lon, view);
const sf = proj(A.SFO.lat, A.SFO.lon, view);
const heading = (Math.atan2(sf.y - o.y, sf.x - o.x) * 180) / Math.PI;
const word = 'FLIGHTY'.split('');
const rows = [
  { t: '13:15', c: 'JFK', s: 'BOARDING', col: FL.ok },
  { t: '14:05', c: 'SFO', s: 'DELAYED', col: FL.late },
  { t: '14:20', c: 'BOS', s: 'CANCELLED', col: FL.cx },
  { t: '15:00', c: 'LAX', s: 'ON TIME', col: FL.ok },
];
---

<svg viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice" data-brand={p.brand}>
  <defs>
    <radialGradient id="flc-bg" cx="70%" cy="40%" r="85%">
      <stop offset="0" stop-color="#1a1c2c" />
      <stop offset=".6" stop-color="#0d0d14" />
      <stop offset="1" stop-color="#060609" />
    </radialGradient>
    <radialGradient id="flc-globe" cx="40%" cy="35%" r="75%">
      <stop offset="0" stop-color="#1b1d2b" />
      <stop offset="1" stop-color="#0a0a10" />
    </radialGradient>
    <clipPath id="flc-clip"><circle cx="590" cy="330" r="220" /></clipPath>
    <linearGradient id="flc-flap" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2a2a34" />
      <stop offset=".5" stop-color="#1f1f28" />
      <stop offset=".5" stop-color="#15151c" />
      <stop offset="1" stop-color="#1b1b23" />
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#flc-bg)" />
  <g fill="#fff" opacity=".5">
    {Array.from({ length: 40 }).map((_, i) => <circle cx={(i * 137) % 800} cy={(i * 71) % 260} r={i % 4 ? 0.9 : 1.6} />)}
  </g>
  <!-- globe -->
  <circle cx={view.cx} cy={view.cy} r={DISC + 18} fill="none" stroke="#2a2a35" stroke-width="6" />
  <circle cx={view.cx} cy={view.cy} r={DISC + 18} fill="none" stroke={FL.late} stroke-width="6" stroke-linecap="round" stroke-dasharray={`${2 * Math.PI * (DISC + 18) * 0.42} 9999`} transform={`rotate(-90 ${view.cx} ${view.cy})`} />
  <circle cx={view.cx} cy={view.cy} r={DISC} fill="url(#flc-globe)" />
  <g clip-path="url(#flc-clip)">
    <path d={grat} fill="none" stroke="#ffffff" stroke-opacity=".09" stroke-width="1" />
    {routes.map(([a, b, c]) => <path d={arcPath(A[a], A[b], view, 0.16)} fill="none" stroke={c} stroke-width="4" stroke-linecap="round" opacity=".95" />)}
    {dots.map((d) => <circle cx={d.p.x} cy={d.p.y} r="5" fill="#f5f5f0" />)}
  </g>
  <circle cx={view.cx} cy={view.cy} r={DISC} fill="none" stroke="#fff" stroke-opacity=".12" />
  <g transform={`translate(${pl.x} ${pl.y - 6}) rotate(${heading}) scale(1.6)`}>
    <path d="M12 0 L3 -2 L-2 -10 L-5 -10 L-3 -2 L-9 -2 L-11 -5 L-13 -5 L-12 0 L-13 5 L-11 5 L-9 2 L-3 2 L-5 10 L-2 10 L3 2 Z" fill="#f5f5f0" />
  </g>
  <!-- board -->
  <g transform="translate(46 96)">
    <rect x="-16" y="-20" width="340" height="360" rx="18" fill="#0b0b10" stroke="#24242e" stroke-width="2" />
    {
      word.map((ch, i) => (
        <g transform={`translate(${i * 44} 0)`}>
          <rect width="40" height="56" rx="5" fill="url(#flc-flap)" />
          <line x1="0" x2="40" y1="28" y2="28" stroke="#07070a" stroke-width="2" />
          <text x="20" y="41" text-anchor="middle" font-family="Inter, Arial, sans-serif" font-weight="800" font-size="34" fill="#f5f5f0">{ch}</text>
        </g>
      ))
    }
    <text x="0" y="96" font-family="Inter, Arial, sans-serif" font-weight="600" font-size="13" letter-spacing="3" fill="#a3a3ad">DEPARTURES</text>
    {
      rows.map((r, i) => (
        <g transform={`translate(0 ${120 + i * 50})`}>
          <rect width="308" height="40" rx="6" fill="#15151c" />
          <circle cx="16" cy="20" r="5" fill={r.col} />
          <text x="32" y="26" font-family="Inter, Arial, sans-serif" font-weight="700" font-size="17" fill="#f5f5f0" style="font-variant-numeric:tabular-nums">{r.t}</text>
          <text x="96" y="26" font-family="Inter, Arial, sans-serif" font-weight="700" font-size="17" fill="#f5f5f0">{r.c}</text>
          <text x="296" y="26" text-anchor="end" font-family="Inter, Arial, sans-serif" font-weight="800" font-size="14" letter-spacing="1" fill={r.col}>{r.s}</text>
        </g>
      ))
    }
  </g>
  <!-- dynamic island -->
  <g transform="translate(470 40)">
    <rect width="240" height="44" rx="22" fill="#000" stroke="#24242e" />
    <text x="22" y="28" font-family="Inter, Arial, sans-serif" font-weight="800" font-size="15" fill={FL.late}>14:53</text>
    <text x="74" y="28" font-family="Inter, Arial, sans-serif" font-weight="600" font-size="13" fill="#a3a3ad" text-decoration="line-through">14:05</text>
    <circle cx="214" cy="22" r="11" fill="none" stroke="#2a2a35" stroke-width="4" />
    <circle cx="214" cy="22" r="11" fill="none" stroke={FL.late} stroke-width="4" stroke-dasharray="20 99" transform="rotate(-90 214 22)" stroke-linecap="round" />
  </g>
</svg>

<style>
  svg { display: block; width: 100%; height: 100%; }
</style>
