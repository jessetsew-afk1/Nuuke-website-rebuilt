---
// Cover art for the Tiimo concept: a scatter of to-dos drifting into a calm,
// colour-blocked day on a phone, with a draining focus disc. Original NUUKE SVG.
import type { Project } from '../../../data/projects';
import { TI, DAY } from '../../../data/cases/tiimo';
interface Props {
  project: Project;
}
const { project } = Astro.props;
const blocks = DAY.slice(0, 6);
const heights = [52, 46, 92, 46, 40, 56];
let y = 132;
const placed = blocks.map((b, i) => {
  const out = { ...b, y, h: heights[i] };
  y += heights[i] + 10;
  return out;
});
const chips = [
  { t: 'email Sam', x: 70, y: 96, r: -8 },
  { t: 'dentist?!', x: 120, y: 168, r: 6 },
  { t: 'laundry', x: 46, y: 236, r: -4 },
  { t: 'deck for Friday??', x: 92, y: 300, r: 5 },
  { t: 'call mum', x: 40, y: 372, r: -7 },
];
---

<svg viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true" data-brand={project.brand}>
  <defs>
    <radialGradient id="ti-cv-bg" cx="70%" cy="20%" r="95%">
      <stop offset="0" stop-color="#FFFFFF" />
      <stop offset=".45" stop-color={TI.canvas} />
      <stop offset="1" stop-color={TI.canvas2} />
    </radialGradient>
  </defs>
  <rect width="800" height="600" fill="url(#ti-cv-bg)" />
  <circle cx="660" cy="110" r="150" fill={TI.pink} opacity=".55" />
  <circle cx="120" cy="520" r="190" fill={TI.mint} opacity=".5" />
  <circle cx="720" cy="520" r="110" fill={TI.butter} opacity=".6" />
  <circle cx="160" cy="70" r="90" fill={TI.lilac} opacity=".55" />

  <!-- loose to-dos, drifting right -->
  <g font-family="Inter, system-ui, sans-serif" font-size="15" font-weight="600" fill={TI.ink2}>
    {
      chips.map((c) => (
        <g transform={`translate(${c.x} ${c.y}) rotate(${c.r})`}>
          <rect x="0" y="-20" width={c.t.length * 8.6 + 28} height="34" rx="17" fill="#FFFFFF" stroke={TI.line} stroke-width="2" />
          <text x="14" y="3">{c.t}</text>
        </g>
      ))
    }
  </g>
  <g fill="none" stroke={TI.purple} stroke-width="3" stroke-linecap="round" stroke-dasharray="2 10" opacity=".8">
    <path d="M250 120 C 300 120, 300 170, 338 180" />
    <path d="M280 316 C 310 316, 312 300, 338 296" />
  </g>

  <!-- phone -->
  <g transform="translate(330 40) rotate(4 150 260)">
    <rect x="-8" y="-8" width="296" height="556" rx="50" fill={TI.ink} />
    <rect width="280" height="540" rx="44" fill="#FFFFFF" />
    <rect x="110" y="14" width="60" height="18" rx="9" fill={TI.ink} />
    <text x="24" y="74" font-family="Inter, system-ui, sans-serif" font-size="11" font-weight="700" letter-spacing="2" fill={TI.muted}>TUESDAY 14</text>
    <text x="24" y="108" font-family="Montserrat, sans-serif" font-size="30" font-weight="800" fill={TI.ink}>Today</text>
    {
      placed.map((b) => (
        <g>
          <rect x="66" y={b.y} width="192" height={b.h} rx="16" fill={TI[b.c]} />
          <text x="82" y={b.y + b.h / 2 + 7} font-size="18">{b.emoji}</text>
          <text x="110" y={b.y + b.h / 2 + 5} font-family="Inter, system-ui, sans-serif" font-size="13" font-weight="700" fill={TI.ink}>{b.t}</text>
          <rect x="22" y={b.y + 8} width="30" height="8" rx="4" fill={TI.line} />
        </g>
      ))
    }
    <line x1="16" x2="264" y1="250" y2="250" stroke={TI.deep} stroke-width="3" />
    <circle cx="60" cy="250" r="6" fill={TI.deep} />
  </g>

  <!-- focus disc card -->
  <g transform="translate(600 300) rotate(-6)">
    <rect x="-20" y="-20" width="170" height="190" rx="30" fill="#FFFFFF" stroke={TI.line} stroke-width="2" />
    <circle cx="65" cy="62" r="52" fill={TI.canvas2} />
    <path d="M65 62 L65 10 A52 52 0 1 1 15.5 78 Z" fill={TI.purple} />
    <circle cx="65" cy="62" r="20" fill="#FFFFFF" />
    <text x="65" y="148" text-anchor="middle" font-family="Montserrat, sans-serif" font-weight="800" font-size="22" fill={TI.ink}>15:30</text>
  </g>
</svg>

<style>
  svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
</style>
