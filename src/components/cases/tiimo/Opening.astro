---
// Cinematic opening. A pinned, scroll-scrubbed manifesto on a calm pastel canvas:
// a messy brain dump floats, then each to-do gently falls into a colour block on a
// day timeline, a "now" line glides down, a focus disc drains, the manifesto lights
// up word by word, and the lockup lands over a slow marquee.
import { DAY, TI, fmtTime } from '../../../data/cases/tiimo';

type Word = { w: string; k?: 'hl' | 'pill' | 'under' | 'disc' };
// [words, window start, window end] in scroll progress.
const lines: [Word[], number, number][] = [
  [[{ w: 'Some' }, { w: 'mornings' }, { w: 'arrive' }, { w: 'all' }, { w: 'at' }, { w: 'once,' }], 0.02, 0.08],
  [[{ w: 'every' }, { w: 'to-do' }, { w: 'talking' }, { w: 'over' }, { w: 'the' }, { w: 'others.' }], 0.07, 0.13],
  [[{ w: 'So' }, { w: 'set' }, { w: 'them' }, { w: 'down.' }, { w: 'Give' }, { w: 'each' }, { w: 'one' }], 0.16, 0.28],
  [[{ w: 'a' }, { w: 'colour,', k: 'pill' }, { w: 'a' }, { w: 'place,', k: 'under' }, { w: 'a' }, { w: 'little' }, { w: 'time.', k: 'disc' }], 0.28, 0.44],
  [[{ w: 'Then' }, { w: 'start' }, { w: 'with' }, { w: 'the' }, { w: 'one' }, { w: 'in' }, { w: 'front' }, { w: 'of' }, { w: 'you.' }], 0.54, 0.68],
  [[{ w: 'A' }, { w: 'day' }, { w: 'you' }, { w: 'can' }, { w: 'see', k: 'hl' }], 0.72, 0.78],
  [[{ w: 'is' }, { w: 'a' }, { w: 'day' }, { w: 'you' }, { w: 'can' }, { w: 'start.', k: 'hl' }], 0.77, 0.83],
];
const plain = lines.map(([l]) => l.map((x) => x.w).join(' ')).join(' ');
const lockWords = ['A', 'day', 'you', 'can', 'see.'];
const durLabel = (d: number) => (d >= 1 ? `${Math.floor(d)} h${d % 1 ? ` ${Math.round((d % 1) * 60)}` : ''}` : `${Math.round(d * 60)} min`);
---

<section class="ti-op" data-ti-op aria-labelledby="ti-op-title">
  <h2 id="ti-op-title" class="visually-hidden">Manifesto: a day you can see</h2>
  <div class="ti-op-sticky">
    <div class="ti-op-bg" aria-hidden="true" data-ti-bg>
      <span class="ti-blob ti-blob--a"></span><span class="ti-blob ti-blob--b"></span><span class="ti-blob ti-blob--c"></span>
    </div>

    <div class="ti-op-scene" data-ti-scene>
      <p class="ti-op-status" aria-hidden="true"><span class="ti-op-dot"></span><span data-ti-status>Brain dump</span></p>
      <div class="ti-op-grid container">
        <p class="ti-op-text">
          <span class="visually-hidden">{plain}</span>
          {
            lines.map(([line, a, b]) => (
              <span class="ti-line" aria-hidden="true">
                {line.map((x, i) => (
                  <span class:list={['ti-w', x.k && `ti-w--${x.k}`]} data-at={(a + ((b - a) * (i + 1)) / line.length).toFixed(4)}>
                    {x.k === 'disc' && <span class="ti-w-disc" />}
                    {x.w}
                  </span>
                ))}
              </span>
            ))
          }
        </p>
        <div class="ti-op-panel" data-ti-panel aria-hidden="true">
          <div class="ti-op-head">
            <span class="ti-op-day">TUESDAY 14</span>
            <span class="ti-op-today">Today</span>
            <span class="ti-op-count"><b data-ti-count>0</b> of {DAY.length} planned</span>
          </div>
          <div class="ti-op-slots" data-ti-slots>
            {DAY.map((d) => <span class="ti-op-time" data-ti-time>{fmtTime(d.start)}</span>)}
            <div class="ti-op-now" data-ti-now><span class="ti-op-now-t" data-ti-now-t>09:00</span></div>
          </div>
        </div>
      </div>

      <div class="ti-op-chips" aria-hidden="true">
        {
          DAY.map((d) => (
            <div class="ti-chip" data-ti-chip style={`--c:${TI[d.c]}`}>
              <span class="ti-chip-fill" />
              <span class="ti-chip-raw">{d.raw}</span>
              <span class="ti-chip-emoji">{d.emoji}</span>
              <span class="ti-chip-tidy">
                <b>{d.t}</b>
                <small>{durLabel(d.dur)}</small>
              </span>
              <span class="ti-chip-check">✓</span>
            </div>
          ))
        }
      </div>

      <div class="ti-op-ring" data-ti-ring aria-hidden="true">
        <svg viewBox="0 0 120 120">
          <circle cx="60" cy="60" r="57" fill="#fff" />
          <circle cx="60" cy="60" r="48" fill={TI.canvas2} />
          <circle class="ti-op-pie" data-ti-pie cx="60" cy="60" r="24" fill="none" stroke={TI.purple} stroke-width="48" pathLength="1" stroke-dasharray="1 1" transform="rotate(-90 60 60)" />
          <circle cx="60" cy="60" r="15" fill="#fff" />
          <path class="ti-op-tick" d="M52 60 l6 6 l11 -13" fill="none" stroke={TI.deep} stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" pathLength="1" />
        </svg>
        <span class="ti-op-ring-t" data-ti-ring-t>25:00</span>
      </div>
    </div>

    <div class="ti-op-lockup" data-ti-lockup aria-hidden="true">
      <span class="ti-lock-pre">Tiimo · a NUUKE concept</span>
      <span class="ti-lock-main">{lockWords.map((w, i) => <span style={`--j:${i}`}>{w}</span>)}</span>
      <span class="ti-lock-sub">is a day you can start.</span>
    </div>

    <div class="ti-op-marquee" aria-hidden="true">
      <div class="ti-op-marquee-track">
        {Array.from({ length: 2 }, () => <span>SEE YOUR DAY ✶ ONE THING AT A TIME ✶ PLAN THE WAY YOU THINK ✶ GENTLE BY DEFAULT ✶ BREATHE OUT ✶ ADAPTIVE BY DESIGN ✶&nbsp;</span>)}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, reducedMotion } from '../../../scripts/motion';
  import { DAY, fmtTime } from '../../../data/cases/tiimo';

  const clamp01 = (x: number) => Math.max(0, Math.min(1, x));
  const seg = (p: number, a: number, b: number) => clamp01((p - a) / (b - a));
  const inOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  const outQ = (t: number) => 1 - Math.pow(1 - t, 4);
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const FOCUS = 2; // index of the task that gets the focus disc

  document.querySelectorAll<HTMLElement>('[data-ti-op]').forEach((root) => {
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const sticky = q<HTMLElement>('.ti-op-sticky');
    const words = [...root.querySelectorAll<HTMLElement>('.ti-w')].map((el) => ({ el, at: parseFloat(el.dataset.at || '0'), on: false }));
    const chips = [...root.querySelectorAll<HTMLElement>('[data-ti-chip]')].map((el) => ({
      el,
      fill: el.querySelector<HTMLElement>('.ti-chip-fill')!,
      raw: el.querySelector<HTMLElement>('.ti-chip-raw')!,
      emoji: el.querySelector<HTMLElement>('.ti-chip-emoji')!,
      tidy: el.querySelector<HTMLElement>('.ti-chip-tidy')!,
      check: el.querySelector<HTMLElement>('.ti-chip-check')!,
      w0: 120,
      h0: 38,
    }));
    const times = [...root.querySelectorAll<HTMLElement>('[data-ti-time]')];
    const slots = q<HTMLElement>('[data-ti-slots]');
    const panel = q<HTMLElement>('[data-ti-panel]');
    const now = q<HTMLElement>('[data-ti-now]');
    const nowT = q<HTMLElement>('[data-ti-now-t]');
    const ring = q<HTMLElement>('[data-ti-ring]');
    const pie = q<SVGCircleElement>('[data-ti-pie]');
    const ringT = q<HTMLElement>('[data-ti-ring-t]');
    const count = q<HTMLElement>('[data-ti-count]');
    const status = q<HTMLElement>('[data-ti-status]');
    const lock = q<HTMLElement>('[data-ti-lockup]');
    const bg = q<HTMLElement>('[data-ti-bg]');
    const text = q<HTMLElement>('.ti-op-text');

    // Deterministic "messy" scatter, in fractions of the stage.
    const scatterDesk = [
      [0.58, 0.22, -7], [0.8, 0.16, 5], [0.64, 0.44, 4], [0.86, 0.38, -5], [0.55, 0.66, -3], [0.75, 0.6, 8], [0.88, 0.76, -6], [0.66, 0.84, 5], [0.52, 0.34, -9],
    ];
    const scatterMob = [
      [0.08, 0.5, -7], [0.5, 0.47, 6], [0.2, 0.6, 4], [0.56, 0.62, -5], [0.06, 0.72, -3], [0.46, 0.75, 8], [0.18, 0.84, -6], [0.58, 0.86, 5], [0.3, 0.53, -9],
    ];

    type Slot = { x: number; y: number; w: number; h: number };
    let slotBox: Slot[] = [];
    let stage = { w: 1, h: 1 };
    let mobile = false;
    let slotTop = 0;
    let slotLeft = 0;
    let panelLeft = 0;
    let textRight = 0;

    const measure = () => {
      const sr = sticky.getBoundingClientRect();
      stage = { w: sr.width, h: sr.height };
      mobile = sr.width < 760;
      // Natural chip size for the scatter state.
      chips.forEach((c) => {
        c.el.style.width = 'auto';
        c.el.style.height = '';
        c.el.classList.add('is-measuring');
        c.w0 = c.raw.offsetWidth + 30;
        c.h0 = mobile ? 34 : 40;
        c.el.classList.remove('is-measuring');
      });
      const r = slots.getBoundingClientRect();
      const pr = panel.getBoundingClientRect();
      slotTop = r.top - sr.top;
      slotLeft = r.left - sr.left;
      panelLeft = pr.left - sr.left;
      textRight = text.getBoundingClientRect().right - sr.left;
      const gutter = mobile ? 46 : 58;
      const gap = 6;
      const raw = DAY.map((d) => 30 + d.dur * 36);
      const total = raw.reduce((a, b) => a + b, 0) + gap * (DAY.length - 1);
      const s = Math.min(1.25, r.height / total);
      let y = 0;
      slotBox = raw.map((h) => {
        const box = { x: slotLeft + gutter, y: slotTop + y, w: r.width - gutter, h: h * s };
        y += h * s + gap;
        return box;
      });
      times.forEach((t, i) => (t.style.transform = `translate3d(0, ${(slotBox[i].y - slotTop + 2).toFixed(1)}px, 0)`));
      now.style.left = `${gutter - 10}px`;
    };

    // The now line's position in slot space: glides to the focus block, waits, then moves on.
    const nowY = (p: number) => {
      const f = slotBox[FOCUS];
      const startY = slotBox[0].y - slotTop + 4;
      const midY = f.y - slotTop + f.h * 0.35;
      const endY = slotBox[FOCUS + 2].y - slotTop + slotBox[FOCUS + 2].h * 0.5;
      if (p < 0.6) return lerp(startY, midY, inOut(seg(p, 0.48, 0.6)));
      if (p < 0.76) return lerp(midY, f.y - slotTop + f.h * 0.9, seg(p, 0.6, 0.76));
      return lerp(f.y - slotTop + f.h * 0.9, endY, inOut(seg(p, 0.76, 0.86)));
    };
    const timeAt = (y: number) => {
      const abs = y + slotTop;
      for (let i = 0; i < DAY.length; i++) {
        const b = slotBox[i];
        if (abs <= b.y + b.h) {
          if (abs < b.y) {
            const prev = i ? DAY[i - 1].start + DAY[i - 1].dur : DAY[0].start - 0.5;
            const prevB = i ? slotBox[i - 1].y + slotBox[i - 1].h : b.y - 20;
            return lerp(prev, DAY[i].start, clamp01((abs - prevB) / Math.max(1, b.y - prevB)));
          }
          return DAY[i].start + DAY[i].dur * clamp01((abs - b.y) / b.h);
        }
      }
      return DAY[DAY.length - 1].start;
    };

    let lastStatus = '';
    let lastCount = -1;
    let p = 0;
    const render = (time: number) => {
      // Words.
      for (const w of words) {
        const on = p >= w.at;
        if (on !== w.on) {
          w.on = on;
          w.el.classList.toggle('is-lit', on);
        }
      }
      // Background drift.
      bg.style.transform = `translate3d(0, ${(-p * 8).toFixed(2)}%, 0)`;
      panel.style.opacity = String(seg(p, 0.08, 0.2));
      panel.style.transform = `translate3d(0, ${((1 - outQ(seg(p, 0.08, 0.22))) * 30).toFixed(1)}px, 0)`;

      // Chips: float, then fall into their slot.
      const sc = mobile ? scatterMob : scatterDesk;
      let placed = 0;
      chips.forEach((c, i) => {
        const a = 0.12 + i * 0.03;
        const t = seg(p, a, a + 0.12);
        const e = inOut(t);
        const s = slotBox[i];
        const [fx, fy, r0] = sc[i % sc.length];
        const sx = fx * stage.w;
        const sy = fy * stage.h;
        const drift = (1 - outQ(t)) * (reducedMotion ? 0 : 1);
        const jx = Math.sin(time * 0.55 + i * 1.7) * 7 * drift;
        const jy = Math.cos(time * 0.45 + i * 1.3) * 6 * drift;
        const jr = Math.sin(time * 0.35 + i) * 2.2 * drift;
        const w = lerp(c.w0, s.w, e);
        const h = lerp(c.h0, s.h, e);
        const x = lerp(sx, s.x, e) + jx;
        const y = lerp(sy, s.y, e) + jy;
        c.el.style.width = `${w.toFixed(1)}px`;
        c.el.style.height = `${h.toFixed(1)}px`;
        c.el.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0) rotate(${(lerp(r0, 0, e) + jr).toFixed(2)}deg)`;
        c.fill.style.opacity = String(seg(t, 0.25, 0.9));
        c.raw.style.opacity = String(1 - seg(t, 0.2, 0.55));
        c.tidy.style.opacity = String(seg(t, 0.55, 1));
        c.emoji.style.opacity = String(seg(t, 0.45, 0.95));
        c.emoji.style.transform = `scale(${(0.4 + 0.6 * outQ(seg(t, 0.45, 1))).toFixed(3)})`;
        c.el.classList.toggle('is-placed', t >= 1);
        times[i].style.opacity = String(seg(t, 0.6, 1));
        if (t >= 1) placed++;
      });
      if (placed !== lastCount) {
        count.textContent = String(placed);
        lastCount = placed;
      }

      // Now line.
      const ny = nowY(p);
      now.style.opacity = String(seg(p, 0.46, 0.52));
      now.style.transform = `translate3d(0, ${ny.toFixed(1)}px, 0)`;
      nowT.textContent = fmtTime(Math.round(timeAt(ny) * 12) / 12);

      // Focus disc on the current block.
      const f = slotBox[FOCUS];
      // Desktop: the disc floats in the gap left of the panel. Narrow: it sits inside the block.
      const roomLeft = !mobile && panelLeft - 132 - 40 > textRight + 8;
      const size = roomLeft ? 132 : mobile ? 66 : 86;
      const rx = roomLeft ? panelLeft - size - 40 : f.x + f.w - size - 8;
      const ry = roomLeft ? f.y + f.h / 2 - size / 2 - 14 : f.y + f.h / 2 - size / 2;
      ring.style.width = `${size}px`;
      ring.classList.toggle('is-inline', !roomLeft);
      const appear = outQ(seg(p, 0.56, 0.62));
      const gone = seg(p, 0.8, 0.86);
      ring.style.opacity = String(appear * (1 - gone));
      ring.style.transform = `translate3d(${rx.toFixed(1)}px, ${ry.toFixed(1)}px, 0) scale(${(0.6 + 0.4 * appear - 0.1 * gone).toFixed(3)})`;
      const drain = seg(p, 0.61, 0.76);
      pie.style.strokeDasharray = `${(1 - drain).toFixed(4)} 1`;
      const left = Math.round(25 * 60 * (1 - drain));
      ringT.textContent = drain >= 1 ? 'Done' : `${Math.floor(left / 60)}:${String(left % 60).padStart(2, '0')}`;
      ring.classList.toggle('is-done', drain >= 1);
      chips[FOCUS].el.classList.toggle('is-focus', p > 0.58 && drain < 1);
      chips[FOCUS].el.classList.toggle('is-ticked', drain >= 1);

      const st = p < 0.1 ? 'Brain dump' : p < 0.46 ? 'Sorting it out' : p < 0.6 ? 'Planned · 9 things' : drain < 1 ? 'Focus · one thing' : 'Done · breathe out';
      if (st !== lastStatus) {
        status.textContent = st;
        lastStatus = st;
      }

      const done = p > 0.86;
      root.classList.toggle('is-done', done);
      lock.classList.toggle('is-in', done);
    };

    measure();
    if (reducedMotion) {
      root.classList.add('is-static');
      p = 0.84;
      requestAnimationFrame(() => {
        measure();
        render(0);
      });
      window.addEventListener('resize', () => (measure(), render(0)), { passive: true });
      return;
    }

    const state = { p: 0 };
    let visible = false;
    let raf = 0;
    const loop = () => {
      raf = 0;
      p = state.p;
      render(performance.now() / 1000);
      // Keep floating while the brain dump is still messy; otherwise render on scroll only.
      if (visible && p < 0.5) raf = requestAnimationFrame(loop);
    };
    const kick = () => {
      if (!raf) raf = requestAnimationFrame(loop);
    };
    new IntersectionObserver((e) => {
      visible = e[0]?.isIntersecting ?? false;
      if (visible) kick();
    }).observe(root);

    gsap.to(state, {
      p: 1,
      ease: 'none',
      onUpdate: kick,
      scrollTrigger: { trigger: root, start: 'top top', end: 'bottom bottom', scrub: 1.1, onRefresh: () => (measure(), kick()) },
    });
    window.addEventListener('resize', () => (measure(), kick()), { passive: true });
    document.fonts?.ready.then(() => (measure(), kick()));
    kick();
  });
</script>

<style>
  .ti-op { position: relative; height: 560vh; background: #f7f3ff; color: #1f1a33; }
  .ti-op-sticky { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; isolation: isolate; }
  .ti-op-bg { position: absolute; inset: -10% -5% -20%; z-index: -1; will-change: transform; }
  .ti-blob { position: absolute; border-radius: 50%; }
  .ti-blob--a { width: 60vmax; height: 60vmax; left: -18vmax; top: -16vmax; background: radial-gradient(closest-side, #e6dbff, transparent); }
  .ti-blob--b { width: 54vmax; height: 54vmax; right: -16vmax; top: 18%; background: radial-gradient(closest-side, #ffdbe5, transparent); }
  .ti-blob--c { width: 50vmax; height: 50vmax; left: 22%; bottom: -14vmax; background: radial-gradient(closest-side, #d6f4e5, transparent); }

  .ti-op-scene { position: absolute; inset: 0; transition: opacity 0.9s var(--ease-out), filter 0.9s, transform 1.1s var(--ease-out); }
  .ti-op.is-done .ti-op-scene { opacity: 0.16; filter: blur(5px) saturate(0.8); transform: scale(0.97); }

  .ti-op-status { position: absolute; top: calc(var(--nav-h) + 1.4rem); left: var(--gutter); display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.45rem 0.9rem 0.45rem 0.7rem; border-radius: 999px; background: #fff; box-shadow: 0 6px 20px -10px rgb(60 40 120 / 0.35); font: 600 0.8rem/1 var(--font-ui); color: #1f1a33; z-index: 3; }
  .ti-op-dot { width: 10px; height: 10px; border-radius: 50%; background: #a98bff; animation: ti-breathe 3.2s ease-in-out infinite; }
  @keyframes ti-breathe { 50% { transform: scale(1.35); opacity: 0.7; } }

  .ti-op-grid { position: relative; height: 100%; display: grid; grid-template-columns: 1.05fr minmax(320px, 440px); gap: clamp(2rem, 6vw, 7rem); align-items: center; padding-top: calc(var(--nav-h) + 3.5rem); padding-bottom: calc(var(--safe-bottom) - 1rem); }
  @media (min-width: 1280px) { .ti-op-grid { padding-left: max(var(--gutter), 76px); } }

  .ti-op-text { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.6rem, 0.9rem + 2.3vw, 3.4rem); line-height: 1.1; letter-spacing: -0.035em; max-width: 20ch; position: relative; z-index: 1; text-wrap: pretty; }
  .ti-line { display: inline; }
  .ti-w { display: inline-block; position: relative; margin-right: 0.22em; opacity: 0.14; transform: translateY(0.18em); filter: blur(2px); transition: opacity 0.8s var(--ease-out), transform 1s var(--ease-out), filter 0.8s var(--ease-out), color 0.6s; }
  .ti-w.is-lit { opacity: 1; transform: none; filter: none; }
  .ti-w--hl.is-lit { color: #5b3fd1; }
  .ti-w--pill { padding: 0 0.28em; border-radius: 0.45em; transition: opacity 0.8s var(--ease-out), transform 1s var(--ease-out), filter 0.8s, background 0.9s; }
  .ti-w--pill.is-lit { background: linear-gradient(90deg, #ffd3df, #dccfff 50%, #c9f1dd); }
  .ti-w--under::after { content: ''; position: absolute; left: 0; right: 0.1em; bottom: 0.02em; height: 0.12em; border-radius: 0.1em; background: #a98bff; transform: scaleX(0); transform-origin: left; transition: transform 0.9s var(--ease-out) 0.2s; }
  .ti-w--under.is-lit::after { transform: scaleX(1); }
  .ti-w--disc { padding-left: 1.05em; }
  .ti-w-disc { position: absolute; left: 0; top: 0.22em; width: 0.8em; height: 0.8em; border-radius: 50%; background: conic-gradient(#a98bff 0 var(--ti-d, 0%), #eee7fc 0); transition: --ti-d 1.4s; }
  .ti-w--disc.is-lit .ti-w-disc { animation: ti-disc 2.4s var(--ease-out) forwards; }
  @property --ti-d { syntax: '<percentage>'; inherits: false; initial-value: 0%; }
  @keyframes ti-disc { from { --ti-d: 0%; } to { --ti-d: 72%; } }

  .ti-op-panel { position: relative; height: min(76svh, 700px); max-height: 100%; border-radius: 34px; background: rgb(255 255 255 / 0.72); box-shadow: 0 40px 80px -40px rgb(70 50 140 / 0.35), inset 0 0 0 1px rgb(255 255 255 / 0.9); padding: 1.4rem 1.2rem 1.2rem; display: grid; grid-template-rows: auto 1fr; gap: 0.9rem; opacity: 0; backdrop-filter: blur(6px); }
  .ti-op-head { display: grid; grid-template-columns: 1fr auto; align-items: end; row-gap: 0.1rem; }
