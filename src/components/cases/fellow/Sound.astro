---
// Sound design notes: one beat per shot, a sound map synced to the animatic,
// and tiny Web Audio sketches of each beat (synthesised in the browser, no files).
import { shots, shotStarts, totalDuration, soundBeats } from '../../../data/cases/fellow';

const W = 1000;
const H = 150;
const x = (t: number) => (t / totalDuration) * W;
const pts = soundBeats.map((b, i) => [x(shotStarts[i] + shots[i].dur / 2), H - 20 - b.level * (H - 46)]);
const path = pts.reduce((d, p, i) => {
  if (!i) return `M0 ${H - 22} L${p[0]} ${p[1]}`;
  const q = pts[i - 1];
  const mx = (q[0] + p[0]) / 2;
  return `${d} C${mx} ${q[1]} ${mx} ${p[1]} ${p[0]} ${p[1]}`;
}, '');
const area = `${path} L${W} ${H - 30} L${W} ${H} L0 ${H} Z`;
---

<div class="fw-snd" data-fw-snd>
  <div class="fw-snd-map" style={`--pn:${3 / totalDuration}`} data-fw-sndmap>
    <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="fw-snd-g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#c98a4e" stop-opacity=".45" /><stop offset="1" stop-color="#c98a4e" stop-opacity="0" /></linearGradient>
      </defs>
      {shotStarts.slice(1).map((s) => <line x1={x(s)} x2={x(s)} y1="0" y2={H} stroke="#2a2522" stroke-width="1" vector-effect="non-scaling-stroke" />)}
      <path d={area} fill="url(#fw-snd-g)" />
      <path d={path} fill="none" stroke="#c98a4e" stroke-width="2" vector-effect="non-scaling-stroke" />
      {pts.map((p) => <circle cx={p[0]} cy={p[1]} r="4" fill="#f0d2b0" />)}
    </svg>
    <div class="fw-snd-labels" aria-hidden="true">{shots.map((s, i) => <span style={`left:${(shotStarts[i] / totalDuration) * 100}%;width:${(s.dur / totalDuration) * 100}%`}>{String(i + 1).padStart(2, '0')}</span>)}</div>
    <i class="fw-snd-head" aria-hidden="true"></i>
    <p class="fw-snd-legend t-label">Music + SFX intensity across the 50 s cut</p>
  </div>
  <ol class="fw-snd-list" role="list" data-stagger="0.04">
    {
      shots.map((s, i) => (
        <li class="fw-snd-row" data-fw-sndrow={i}>
          <span class="t-num fw-snd-n">{String(i + 1).padStart(2, '0')}</span>
          <div class="fw-snd-copy">
            <p class="fw-snd-title">{s.title}</p>
            <p class="t-small">{s.sound}</p>
          </div>
          <span class="fw-snd-meter" aria-hidden="true"><i style={`width:${soundBeats[i].level * 100}%`} /></span>
          <button type="button" class="fel-chip-btn fw-snd-btn" data-fw-sfx={soundBeats[i].kind} aria-label={`Play a sketch of the ${soundBeats[i].label} sound for shot ${i + 1}`}>
            ▶ {soundBeats[i].label}
          </button>
        </li>
      ))
    }
  </ol>
  <p class="t-small">Sketches are synthesised live in your browser with the Web Audio API, a stand-in for the foley we’d record (real detents, a real lid, real water). Nothing plays until you press a button.</p>
</div>

<script>
  import { on, totalDuration } from '../../../scripts/three/fellow-bus';
  const root = document.querySelector<HTMLElement>('[data-fw-snd]');
  if (root) {
    const map = root.querySelector<HTMLElement>('[data-fw-sndmap]')!;
    const rows = [...root.querySelectorAll<HTMLElement>('[data-fw-sndrow]')];
    on('time', (i) => {
      map.style.setProperty('--pn', String(i.t / totalDuration));
      rows.forEach((r, j) => r.classList.toggle('is-on', i.active && j === i.shot));
    });

    let ctx: AudioContext | null = null;
    let noise: AudioBuffer | null = null;
    const ac = () => {
      if (!ctx) {
        ctx = new AudioContext();
        noise = ctx.createBuffer(1, ctx.sampleRate * 2, ctx.sampleRate);
        const d = noise.getChannelData(0);
        for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
      }
      return ctx;
    };
    const out = (c: AudioContext, t0: number, peak: number, a: number, dur: number) => {
      const g = c.createGain();
      g.gain.setValueAtTime(0.0001, t0);
      g.gain.exponentialRampToValueAtTime(peak, t0 + a);
      g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
      g.connect(c.destination);
      return g;
    };
    const tone = (c: AudioContext, t0: number, f: number, dur: number, peak = 0.2, type: OscillatorType = 'sine', f2?: number) => {
      const o = c.createOscillator();
      o.type = type;
      o.frequency.setValueAtTime(f, t0);
      if (f2) o.frequency.exponentialRampToValueAtTime(f2, t0 + dur);
      o.connect(out(c, t0, peak, 0.005, dur));
      o.start(t0);
      o.stop(t0 + dur + 0.05);
    };
    const hiss = (c: AudioContext, t0: number, dur: number, f1: number, f2: number, peak = 0.2, q = 1, a = 0.01) => {
      const s = c.createBufferSource();
      s.buffer = noise;
      const bp = c.createBiquadFilter();
      bp.type = 'bandpass';
      bp.Q.value = q;
      bp.frequency.setValueAtTime(f1, t0);
      bp.frequency.exponentialRampToValueAtTime(f2, t0 + dur);
      s.connect(bp).connect(out(c, t0, peak, a, dur));
      s.start(t0);
      s.stop(t0 + dur + 0.05);
    };
    const sfx: Record<string, (c: AudioContext, t: number) => void> = {
      swell: (c, t) => {
        tone(c, t, 55, 2.2, 0.25);
        hiss(c, t, 2.2, 200, 900, 0.12, 0.7, 1.2);
      },
      tock: (c, t) => {
        tone(c, t, 340, 0.18, 0.35, 'sine', 170);
        hiss(c, t, 0.04, 3000, 2000, 0.15, 2);
      },
      blip: (c, t) => {
        tone(c, t, 1320, 0.09, 0.12, 'square');
        tone(c, t + 0.1, 1760, 0.12, 0.1, 'square');
      },
      detents: (c, t) => {
        for (let i = 0; i < 16; i++) hiss(c, t + i * 0.065, 0.018, 3200 + i * 60, 2600, 0.35, 6);
      },
      hiss: (c, t) => {
        hiss(c, t, 2, 400, 3200, 0.16, 1.2, 0.8);
        for (let i = 0; i < 18; i++) tone(c, t + 0.5 + Math.random() * 1.4, 500 + Math.random() * 900, 0.05, 0.06, 'sine', 1400);
      },
      switch: (c, t) => {
        hiss(c, t, 0.02, 4000, 3000, 0.4, 3);
        tone(c, t + 0.05, 110, 1.4, 0.1);
        tone(c, t + 0.05, 220, 1.4, 0.05);
      },
      whoosh: (c, t) => hiss(c, t, 0.9, 300, 1800, 0.25, 1.5, 0.35),
      trickle: (c, t) => {
        for (let i = 0; i < 26; i++) hiss(c, t + i * 0.07, 0.08, 2200 + Math.random() * 1500, 1800, 0.08 + Math.random() * 0.08, 8);
      },
      beats: (c, t) => {
        for (let i = 0; i < 4; i++) hiss(c, t + i * 0.4, 0.35, 400, 2400, 0.25, 1.4, 0.12);
      },
      chime: (c, t) => {
        tone(c, t, 880, 1.8, 0.14);
        tone(c, t + 0.2, 1318.5, 1.8, 0.11);
      },
    };
    root.querySelectorAll<HTMLButtonElement>('[data-fw-sfx]').forEach((b) =>
      b.addEventListener('click', () => {
        try {
          const c = ac();
          if (c.state === 'suspended') c.resume();
          sfx[b.dataset.fwSfx!]?.(c, c.currentTime + 0.02);
        } catch {}
      }),
    );
  }
</script>

<style>
  .fw-snd { display: grid; gap: var(--s-6); }
  .fw-snd > * { min-width: 0; }
  .fw-snd-map { position: relative; height: 190px; padding-top: 6px; border-radius: var(--r-lg); border: 1px solid var(--line); background: #0d0c0b; overflow: hidden; }
  .fw-snd-map svg { width: 100%; height: 150px; }
  .fw-snd-labels { position: absolute; left: 0; right: 0; bottom: 8px; height: 20px; }
  .fw-snd-labels span { position: absolute; text-align: center; font: 600 11px var(--font-ui); color: var(--muted); }
  .fw-snd-head { position: absolute; top: 0; bottom: 0; left: calc(var(--pn) * 100%); width: 2px; background: #fff; box-shadow: 0 0 10px rgb(255 255 255 / 0.6); }
  .fw-snd-legend { position: absolute; top: var(--s-3); left: var(--s-4); }
  .fw-snd-list { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-2) var(--s-5); }
  .fw-snd-row { display: grid; grid-template-columns: 2.2rem 1fr auto; grid-template-areas: 'n copy btn' 'n meter meter'; gap: 6px var(--s-3); align-items: center; padding: var(--s-3) 0; border-bottom: 1px solid var(--line); transition: background var(--dur-1); }
  .fw-snd-row.is-on { background: color-mix(in srgb, var(--a) 8%, transparent); }
  .fw-snd-n { grid-area: n; align-self: start; color: var(--a); font-weight: 700; padding-top: 2px; }
  .fw-snd-copy { grid-area: copy; min-width: 0; }
  .fw-snd-title { font-weight: 700; color: var(--ink); }
  .fw-snd-meter { grid-area: meter; height: 3px; border-radius: 3px; background: var(--line); overflow: hidden; }
  .fw-snd-meter i { display: block; height: 100%; background: var(--a); }
  .fw-snd-btn { grid-area: btn; }
  @media (max-width: 900px) {
    .fw-snd-list { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .fw-snd-row { grid-template-columns: 2rem 1fr; grid-template-areas: 'n copy' 'n meter' 'n btn'; }
    .fw-snd-btn { justify-self: start; }
    .fw-snd-labels span { font-size: 9px; }
  }
</style>
