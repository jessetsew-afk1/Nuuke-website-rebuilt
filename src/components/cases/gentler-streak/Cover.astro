---
// Cover art for Gentler Streak (800 × 600). Original NUUKE illustration in SVG:
// a warm morning, the Activity Path band, a phone showing "You’re steady" and a watch ring.
import type { Project } from '../../../data/projects';
import { GS, band, dotColor, thirtyDays, tenDays } from '../../../data/cases/gentler-streak';
interface Props {
  project: Project;
}
const { project: _p } = Astro.props;
const big = band(-40, 840, 470, 46, thirtyDays, 22, 1.2);
const small = band(22, 218, 238, 22, tenDays, 6, 0.6);
const seg = (i: number, r: number) => {
  const a0 = ((i * 360) / 7 + 3) * (Math.PI / 180);
  const a1 = (((i + 1) * 360) / 7 - 3) * (Math.PI / 180);
  const p = (a: number) => `${(Math.sin(a) * r).toFixed(1)} ${(-Math.cos(a) * r).toFixed(1)}`;
  return `M ${p(a0)} A ${r} ${r} 0 0 1 ${p(a1)}`;
};
const week = [GS.coral, GS.sun, GS.lilac, GS.coral, GS.mint, GS.lilac, GS.coral];
---

<svg class="gs-cover" viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <linearGradient id="gs-cv-sky" x1="0" y1="0" x2="0.4" y2="1">
      <stop offset="0" stop-color="#FFE7D6" />
      <stop offset=".55" stop-color="#FFD2B8" />
      <stop offset="1" stop-color="#F7B9A0" />
    </linearGradient>
    <radialGradient id="gs-cv-sun" cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="#FFB089" />
      <stop offset="1" stop-color="#FF7A45" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="gs-cv-orb" cx="38%" cy="32%" r="70%">
      <stop offset="0" stop-color="#FFD2B8" />
      <stop offset=".55" stop-color="#FF7A45" />
      <stop offset="1" stop-color="#E2551F" />
    </radialGradient>
    <linearGradient id="gs-cv-band" x1="0" x2="1">
      <stop offset="0" stop-color="#7ED957" stop-opacity=".25" />
      <stop offset=".5" stop-color="#7ED957" stop-opacity=".55" />
      <stop offset="1" stop-color="#7ED957" stop-opacity=".3" />
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#gs-cv-sky)" />
  <circle cx="610" cy="140" r="210" fill="url(#gs-cv-sun)" opacity=".7" />
  <!-- weekly ring -->
  <g transform="translate(610 150)" fill="none" stroke-linecap="round">
    <circle r="96" stroke="#fff" stroke-opacity=".5" stroke-width="16" />
    {week.map((c, i) => <path d={seg(i, 96)} stroke={c} stroke-width="16" />)}
  </g>
  <!-- the Activity Path band sweeping across -->
  <path d={big.fill} fill="url(#gs-cv-band)" />
  <path d={big.top} fill="none" stroke="#2F7D32" stroke-opacity=".35" stroke-width="2" />
  <path d={big.bottom} fill="none" stroke="#2F7D32" stroke-opacity=".35" stroke-width="2" />
  {big.dots.map((d) => <circle cx={d.x} cy={d.y} r="7" fill={dotColor(d.v)} stroke="#FFF4EC" stroke-width="3" />)}
  <!-- phone -->
  <g transform="translate(232 58) rotate(-7 125 250)">
    <rect x="-6" y="-6" width="262" height="512" rx="44" fill="#2B1208" />
    <rect width="250" height="500" rx="38" fill={GS.cream} />
    <rect x="95" y="12" width="60" height="16" rx="8" fill="#2B1208" />
    <text x="22" y="62" fill={GS.ink2} font-family="Inter, sans-serif" font-size="10" letter-spacing="1.8">TUESDAY · 6 OCT</text>
    <text x="22" y="92" fill={GS.ink} font-family="Montserrat, sans-serif" font-weight="800" font-size="26">Today</text>
    <rect x="14" y="108" width="222" height="88" rx="20" fill={GS.peach} />
    <circle cx="52" cy="152" r="24" fill="url(#gs-cv-orb)" />
    <text x="88" y="140" fill={GS.ink2} font-family="Inter, sans-serif" font-size="9" letter-spacing="1.4">READINESS</text>
    <text x="88" y="160" fill={GS.ink} font-family="Montserrat, sans-serif" font-weight="800" font-size="16">You’re steady.</text>
    <rect x="88" y="170" width="110" height="7" rx="3.5" fill="#E8B9A0" />
    <rect x="14" y="206" width="222" height="76" rx="20" fill="#fff" />
    <path d={small.fill} fill={GS.mint} opacity=".5" />
    {small.dots.map((d, i) => <circle cx={d.x} cy={d.y} r={i === 9 ? 5.5 : 4} fill={dotColor(d.v)} />)}
    <circle cx={small.dots[9].x} cy={small.dots[9].y} r="9" fill="none" stroke={GS.coral} stroke-width="2" />
    <rect x="14" y="294" width="222" height="58" rx="18" fill={GS.coral} />
    <text x="30" y="318" fill={GS.ink} font-family="Inter, sans-serif" font-size="9" letter-spacing="1.4">GO GENTLER</text>
    <text x="30" y="337" fill={GS.ink} font-family="Montserrat, sans-serif" font-weight="800" font-size="12.5">A 20-min walk is perfect</text>
    <rect x="14" y="362" width="222" height="48" rx="16" fill="#fff" />
    <rect x="30" y="378" width="96" height="8" rx="4" fill={GS.ink} opacity=".75" />
    <rect x="30" y="392" width="64" height="6" rx="3" fill="#D9BBA9" />
    <rect x="0" y="440" width="250" height="60" rx="0" fill="#fff" />
    {[0, 1, 2, 3].map((i) => <rect x={30 + i * 56} y="456" width="22" height="16" rx="6" fill={i === 0 ? GS.coral : '#EAD6C8'} />)}
  </g>
  <!-- watch -->
  <g transform="translate(548 300) rotate(8 80 110)">
    <rect x="38" y="-70" width="84" height="90" rx="20" fill={GS.plum} />
    <rect x="38" y="200" width="84" height="100" rx="20" fill={GS.plum} />
    <rect x="0" y="0" width="160" height="216" rx="46" fill="#2B1208" />
    <rect x="164" y="54" width="10" height="34" rx="5" fill="#5a3a2a" />
    <rect x="10" y="10" width="140" height="196" rx="38" fill="#0b0705" />
    <g transform="translate(80 100)" fill="none" stroke-linecap="round">
      <circle r="48" stroke="#2a1a14" stroke-width="10" />
      <path d="M 0 -48 A 48 48 0 1 1 -41.6 24" stroke={GS.coral} stroke-width="10" />
      <circle r="34" stroke="#1d2a14" stroke-width="8" />
      <path d="M 0 -34 A 34 34 0 1 1 -29.4 -17" stroke={GS.mint} stroke-width="8" />
    </g>
    <text x="80" y="104" text-anchor="middle" fill="#FFF4EC" font-family="Montserrat, sans-serif" font-weight="800" font-size="20">20</text>
    <text x="80" y="120" text-anchor="middle" fill="#FFB089" font-family="Inter, sans-serif" font-size="9">min walk</text>
  </g>
  <!-- concept stamp -->
  <g transform="translate(110 92) rotate(-10)">
    <rect x="-62" y="-26" width="124" height="52" rx="10" fill={GS.cream} stroke={GS.ink} stroke-width="3" stroke-dasharray="7 5" />
    <text text-anchor="middle" y="-3" font-family="Inter, sans-serif" font-weight="800" font-size="12" letter-spacing="2" fill={GS.ink}>NUUKE</text>
    <text text-anchor="middle" y="14" font-family="Inter, sans-serif" font-weight="600" font-size="9" letter-spacing="1.6" fill={GS.ink}>BY NUUKE</text>
  </g>
</svg>

<style>
  .gs-cover { display: block; width: 100%; height: 100%; }
</style>
