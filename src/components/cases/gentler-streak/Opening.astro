---
// The cinematic opening: one day and one night, scrubbed by scroll.
// A racing heartbeat slows and smooths, rises into the Activity Path band and the days
// settle into the green zone. The manifesto lights up word by word while a weekly ring
// sweeps (rest days count), night falls, dawn breaks and the lockup lands.
// All artwork is original NUUKE SVG; reduced motion gets a calm static composition.
type Word = { w: string; k?: 'hl' | 'soft' | 'pill' | 'rest' };
const lines: Word[][] = [
  [{ w: 'Most' }, { w: 'trackers' }, { w: 'only' }, { w: 'count' }, { w: 'the' }, { w: 'hard' }, { w: 'days.', k: 'hl' }],
  [{ w: 'But' }, { w: 'a' }, { w: 'body' }, { w: 'isn’t' }, { w: 'a' }, { w: 'to-do' }, { w: 'list.' }],
  [{ w: 'Some' }, { w: 'days' }, { w: 'it' }, { w: 'wants' }, { w: 'a' }, { w: 'long' }, { w: 'run,' }],
  [{ w: 'some' }, { w: 'days' }, { w: 'a' }, { w: 'slow' }, { w: 'walk,' }],
  [{ w: 'and' }, { w: 'some' }, { w: 'days,' }, { w: 'nothing', k: 'soft' }, { w: 'at', k: 'soft' }, { w: 'all.', k: 'soft' }],
  [{ w: 'Rest', k: 'rest' }, { w: 'is' }, { w: 'part' }, { w: 'of' }, { w: 'the' }, { w: 'training.', k: 'hl' }],
  [{ w: 'So' }, { w: 'the' }, { w: 'streak' }, { w: 'should' }, { w: 'count' }, { w: 'it' }, { w: 'too.', k: 'pill' }],
];
let n = 0;
const lock = 'Rest counts.'.split('');
const week = [
  { d: 'Mon', a: 'Run', c: '#FF7A45' },
  { d: 'Tue', a: 'Walk', c: '#F4C430' },
  { d: 'Wed', a: 'Rest', c: '#B9A6E8', rest: true },
  { d: 'Thu', a: 'Yoga', c: '#7ED957' },
  { d: 'Fri', a: 'Ride', c: '#FF7A45' },
  { d: 'Sat', a: 'Rest', c: '#B9A6E8', rest: true },
  { d: 'Sun', a: 'Walk', c: '#F4C430' },
];
const R = 92;
const seg = (i: number) => {
  const a0 = ((i * 360) / 7 + 4) * (Math.PI / 180);
  const a1 = (((i + 1) * 360) / 7 - 4) * (Math.PI / 180);
  const p = (a: number) => `${(Math.sin(a) * R).toFixed(2)} ${(-Math.cos(a) * R).toFixed(2)}`;
  return `M ${p(a0)} A ${R} ${R} 0 0 1 ${p(a1)}`;
};
const marquee = 'REST COUNTS ✶ LISTEN IN ✶ MOVE CONSISTENTLY, NOT CONSTANTLY ✶ SOME DAYS, NOTHING AT ALL ✶ NO GUILT, NO PUNISHMENT ✶ ';
---

<section class="gs-o" id="manifesto" aria-labelledby="gs-o-title" data-gs-open>
  <h2 id="gs-o-title" class="visually-hidden">Opening manifesto: rest counts</h2>
  <div class="gs-o-sticky" data-gs-sticky>
    <div class="gs-o-sky" aria-hidden="true">
      <span class="gs-o-blob gs-o-blob--a"></span>
      <span class="gs-o-blob gs-o-blob--b"></span>
      <span class="gs-o-sun" data-gs-sun></span>
      <span class="gs-o-moon" data-gs-moon></span>
      <span class="gs-o-stars"></span>
    </div>

    <svg class="gs-o-lines" data-gs-lines aria-hidden="true">
      <defs>
        <linearGradient id="gs-o-pulse-grad" gradientUnits="userSpaceOnUse" x1="0" x2="1000" data-gs-pgrad>
          <stop offset="0" stop-color="#E2551F" stop-opacity="0" />
          <stop offset=".18" stop-color="#E2551F" />
          <stop offset=".85" stop-color="#FF7A45" />
          <stop offset="1" stop-color="#FF7A45" stop-opacity=".2" />
        </linearGradient>
        <linearGradient id="gs-o-band-grad" x1="0" x2="1">
          <stop offset="0" stop-color="#7ED957" stop-opacity=".18" />
          <stop offset=".5" stop-color="#7ED957" stop-opacity=".58" />
          <stop offset="1" stop-color="#7ED957" stop-opacity=".25" />
        </linearGradient>
        <filter id="gs-o-glow" x="-10%" y="-50%" width="120%" height="200%">
          <feGaussianBlur stdDeviation="6" />
        </filter>
      </defs>
      <path class="gs-o-band" data-gs-band fill="url(#gs-o-band-grad)" />
      <path class="gs-o-edge" data-gs-edge-top />
      <path class="gs-o-edge" data-gs-edge-bot />
      <g data-gs-dots>
        {Array.from({ length: 30 }, () => <circle r="6" class="gs-o-dot" />)}
      </g>
      <path class="gs-o-pulse-glow" data-gs-pulse-glow filter="url(#gs-o-glow)" />
      <path class="gs-o-pulse" data-gs-pulse stroke="url(#gs-o-pulse-grad)" />
      <circle class="gs-o-head" data-gs-head r="6" />
    </svg>

    <div class="gs-o-hud container" aria-hidden="true">
      <span class="gs-o-scene" data-gs-scene>Morning · the heartbeat</span>
      <span class="gs-o-bpm"><span class="gs-o-heart">♥</span> <span data-gs-bpm>118</span> bpm</span>
    </div>

    <div class="gs-o-grid container" data-gs-grid>
      <p class="gs-o-text">
        <span class="visually-hidden">{lines.map((l) => l.map((x) => x.w).join(' ')).join(' ')}</span>
        {
          lines.map((line) => (
            <span class="gs-o-line" aria-hidden="true">
              {line.map((x) => (
                <span class:list={['gs-w', x.k && `gs-w--${x.k}`]} style={`--i:${n++}`}>
                  {x.w}
                </span>
              ))}{' '}
            </span>
          ))
        }
      </p>
      <div class="gs-o-ring" aria-hidden="true">
        <svg viewBox="-120 -120 240 240">
          <circle r={R} class="gs-o-track" />
          {week.map((d, i) => <path d={seg(i)} class:list={['gs-o-seg', { 'gs-o-seg--rest': d.rest }]} stroke={d.c} data-gs-seg />)}
          {
            week.map((d, i) => {
              const a = ((i + 0.5) * 2 * Math.PI) / 7;
              return (
                <text x={Math.sin(a) * 118} y={-Math.cos(a) * 118 + 4} class="gs-o-dlabel" text-anchor="middle">
                  {d.d[0]}
                </text>
              );
            })
          }
          <g data-gs-marker><circle cy={-R} r="11" class="gs-o-marker" /></g>
          <circle r="62" class="gs-o-breath" />
        </svg>
        <div class="gs-o-ring-c">
          <span class="gs-o-day" data-gs-day>Mon · Run</span>
          <span class="gs-o-streak"><b data-gs-streak>0</b> day streak</span>
        </div>
      </div>
    </div>

    <div class="gs-lock" data-gs-lock aria-hidden="true">
      <span class="gs-lock-pre">A NUUKE concept for Gentler Streak</span>
      <span class="gs-lock-main">{lock.map((c, i) => <span style={`--j:${i}`}>{c === ' ' ? ' ' : c}</span>)}</span>
      <span class="gs-lock-line">“Move consistently, not constantly.” <em>Gentler Streak’s own line</em></span>
      <span class="gs-lock-badges">
        <span>Apple Watch App of the Year · 2022</span>
        <span>Apple Design Award · Social Impact · 2024</span>
      </span>
    </div>

    <div class="gs-o-marquee" aria-hidden="true">
      <div class="gs-o-marquee-track">
        <span>{marquee}</span><span>{marquee}</span>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, reducedMotion } from '../../../scripts/motion';
  import { thirtyDays } from '../../../data/cases/gentler-streak';

  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const range = (v: number, a: number, b: number) => clamp((v - a) / (b - a));
  const sine = (x: number) => 0.5 - Math.cos(Math.PI * x) / 2; // breath-like in-out
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const gauss = (x: number, m: number, s: number) => Math.exp(-((x - m) ** 2) / (2 * s * s));

  type RGB = [number, number, number];
  const hex = (h: string): RGB => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)];
  const SKY: [number, RGB][] = [
    [0, hex('#FFE6D6')],
    [0.16, hex('#FFF0CC')],
    [0.32, hex('#FFDDB5')],
    [0.41, hex('#F2A88C')],
    [0.48, hex('#2E1B4E')],
    [0.72, hex('#2E1B4E')],
    [0.8, hex('#FF8A5B')],
    [1, hex('#FF8A5B')],
  ];
  const skyAt = (p: number): RGB => {
    for (let i = 1; i < SKY.length; i++) {
      const [p1, c1] = SKY[i];
      const [p0, c0] = SKY[i - 1];
      if (p <= p1) {
        const t = sine(range(p, p0, p1));
        return [lerp(c0[0], c1[0], t), lerp(c0[1], c1[1], t), lerp(c0[2], c1[2], t)];
      }
    }
    return SKY[SKY.length - 1][1];
  };
  const lum = ([r, g, b]: RGB) => {
    const f = (v: number) => {
      const c = v / 255;
      return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
    };
    return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b);
  };

  const WEEK = [
    ['Mon', 'Run'],
    ['Tue', 'Walk'],
    ['Wed', 'Rest'],
    ['Thu', 'Yoga'],
    ['Fri', 'Ride'],
    ['Sat', 'Rest'],
    ['Sun', 'Walk'],
  ];
  const SCENES: [number, string][] = [
    [0, 'Morning · the heartbeat'],
    [0.27, 'Day · finding the path'],
    [0.46, 'Night · rest'],
    [0.76, 'Dawn · the streak holds'],
  ];

  document.querySelectorAll<HTMLElement>('[data-gs-open]').forEach((root) => {
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const sticky = q<HTMLElement>('[data-gs-sticky]');
    const svg = q<SVGSVGElement>('[data-gs-lines]');
    const pulse = q<SVGPathElement>('[data-gs-pulse]');
    const glow = q<SVGPathElement>('[data-gs-pulse-glow]');
    const head = q<SVGCircleElement>('[data-gs-head]');
    const pgrad = q<SVGLinearGradientElement>('[data-gs-pgrad]');
    const bandEl = q<SVGPathElement>('[data-gs-band]');
    const edgeT = q<SVGPathElement>('[data-gs-edge-top]');
    const edgeB = q<SVGPathElement>('[data-gs-edge-bot]');
    const dots = [...root.querySelectorAll<SVGCircleElement>('[data-gs-dots] circle')];
    const words = [...root.querySelectorAll<HTMLElement>('.gs-w')];
    const segs = [...root.querySelectorAll<SVGPathElement>('[data-gs-seg]')];
    const marker = q<SVGGElement>('[data-gs-marker]');
    const dayEl = q<HTMLElement>('[data-gs-day]');
    const streakEl = q<HTMLElement>('[data-gs-streak]');
    const bpmEl = q<HTMLElement>('[data-gs-bpm]');
    const sceneEl = q<HTMLElement>('[data-gs-scene]');
    const sun = q<HTMLElement>('[data-gs-sun]');
    const moon = q<HTMLElement>('[data-gs-moon]');
    const lockEl = q<HTMLElement>('[data-gs-lock]');

    const segLen = segs.map((s) => s.getTotalLength());
    segs.forEach((s, i) => (s.style.strokeDasharray = `${segLen[i]} ${segLen[i]}`));

    // Where each day starts (scattered) and where it settles (inside the band).
    const start = thirtyDays.map((v, i) => (v > 0 ? 1 : -1) * (1.6 + ((i * 37) % 11) / 6) * (Math.abs(v) > 0.9 ? 1.25 : 1));
    const settled = thirtyDays.map((v) => clamp(v, -0.75, 0.75));

    let W = 1000;
    let H = 600;
    const resize = () => {
      W = Math.max(320, svg.clientWidth);
      H = Math.max(320, svg.clientHeight);
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      pgrad.setAttribute('x2', String(W));
    };
    resize();
    new ResizeObserver(() => {
      resize();
      draw(true);
    }).observe(svg);

    const small = () => W < 760;
    const baseY = () => H * (small() ? 0.79 : 0.78);
    // The heartbeat runs along the final path line; the band rises from below the screen to meet it.
    const line = (x: number, r: number) => baseY() + Math.sin((x / W) * Math.PI * 1.6 + 1.2) * H * 0.018 * r + Math.sin((x / W) * Math.PI * 3.1 + 2.4) * H * 0.008 * r;
    const centre = (x: number, r: number) => line(x, r) + (1 - r) * H * 0.3;
    const halfW = (x: number, r: number) => H * (small() ? 0.05 : 0.06) * (0.15 + 0.85 * r) * (0.85 + 0.15 * Math.cos((x / W) * Math.PI * 2.2));

    let target = 0;
    let cur = 0;
    let beat = 0;
    let lastBand = -1;
    let lastLit = -1;
    let lastScene = '';
    let lastDark: boolean | null = null;

    const drawBand = (r: number) => {
      const key = Math.round(r * 400) + W * 1000 + H;
      if (key === lastBand) return;
      lastBand = key;
      const N = 36;
      let top = '';
      let bot = '';
      const bpts: string[] = [];
      for (let i = 0; i <= N; i++) {
        const x = (i / N) * W;
        const c = centre(x, r);
        const h = halfW(x, r);
        top += `${i ? 'L' : 'M'} ${x.toFixed(1)} ${(c - h).toFixed(1)} `;
        bpts.push(`${x.toFixed(1)} ${(c + h).toFixed(1)}`);
      }
      bot = 'M ' + bpts.join(' L ');
      bandEl.setAttribute('d', `${top} L ${bpts.reverse().join(' L ')} Z`);
      edgeT.setAttribute('d', top);
      edgeB.setAttribute('d', bot);
    };

    const draw = (force = false) => {
      const p = cur;
      // Heart: fast and spiky → slow and smooth.
      const calm = sine(range(p, 0.03, 0.4));
      const bpm = lerp(118, 56, calm);
      const sharp = 1 - calm;
      const rise = sine(range(p, 0.26, 0.5));
      drawBand(rise);

      const per = W / lerp(5.2, 2.1, calm); // px per beat
      const amp = H * lerp(0.13, 0.045, calm);
      const step = sharp > 0.25 ? 3 : 6;
      let d = '';
      for (let x = 0; x <= W + step; x += step) {
        const u = x / per - beat;
        const f = u - Math.floor(u);
        const ecg = 0.12 * gauss(f, 0.16, 0.03) - 0.16 * gauss(f, 0.3, 0.009) + 1 * gauss(f, 0.33, 0.012) - 0.28 * gauss(f, 0.365, 0.01) + 0.26 * gauss(f, 0.6, 0.055);
        const soft = 0.5 * Math.sin(u * Math.PI * 2);
        const y = line(x, rise) - amp * (sharp * ecg + (1 - sharp) * soft);
        d += `${x ? 'L' : 'M'} ${x.toFixed(1)} ${y.toFixed(1)} `;
      }
      pulse.setAttribute('d', d);
      glow.setAttribute('d', d);
      const hx = W * 0.86;
      const hu = hx / per - beat;
      const hf = hu - Math.floor(hu);
      const hy = line(hx, rise) - amp * (sharp * (gauss(hf, 0.33, 0.012) + 0.26 * gauss(hf, 0.6, 0.055)) + (1 - sharp) * 0.5 * Math.sin(hu * Math.PI * 2));
      head.setAttribute('cx', hx.toFixed(1));
      head.setAttribute('cy', hy.toFixed(1));
      bpmEl.textContent = String(Math.round(bpm));
      root.style.setProperty('--bpm-s', `${(60 / bpm).toFixed(2)}s`);

      // Days: drift in scattered, then settle into the green zone one by one.
      const show = range(p, 0.3, 0.4);
      const settle = range(p, 0.38, 0.7);
      dots.forEach((c, i) => {
        const x = W * 0.05 + (i * W * 0.9) / (dots.length - 1);
        const h = halfW(x, rise);
        const s = sine(range(settle, i * 0.016, i * 0.016 + 0.5));
        const v = lerp(start[i], settled[i], s);
        c.setAttribute('cx', x.toFixed(1));
        c.setAttribute('cy', (centre(x, rise) - v * h * 1.1).toFixed(1));
        c.style.opacity = String(show);
        c.classList.toggle('is-in', s > 0.75);
        c.classList.toggle('is-up', s <= 0.75 && start[i] > 0);
      });

      // Weekly ring.
      const sweep = range(p, 0.06, 0.76);
      segs.forEach((s, i) => (s.style.strokeDashoffset = String(segLen[i] * (1 - clamp(sweep * 7 - i)))));
      marker.style.transform = `rotate(${sweep * 360}deg)`;
      const k = Math.min(6, Math.floor(sweep * 7));
      const [dn, act] = WEEK[k];
      dayEl.textContent = act === 'Rest' ? `${dn} · Rest ✓` : `${dn} · ${act}`;
      streakEl.textContent = String(Math.min(7, Math.floor(sweep * 7 + 0.02)));

      // Words.
      const lit = Math.round(range(p, 0.04, 0.74) * words.length);
      if (lit !== lastLit || force) {
        lastLit = lit;
        words.forEach((w, i) => w.classList.toggle('is-lit', i < lit));
      }

      // Sky, sun and moon.
      const sky = skyAt(p);
      sticky.style.setProperty('--sky', `rgb(${sky.map((v) => Math.round(v)).join(' ')})`);
      const dark = lum(sky) < 0.3;
      if (dark !== lastDark) {
        lastDark = dark;
        root.classList.toggle('is-night', dark);
      }
      const day = range(p, 0, 0.47);
      const dawn = range(p, 0.74, 1);
      const sunT = p < 0.6 ? day : dawn * 0.4;
      const sunVis = p < 0.6 ? 1 - range(p, 0.43, 0.48) : range(p, 0.74, 0.8);
      sun.style.transform = `translate(${(30 + sunT * 50).toFixed(2)}vw, ${(12 - Math.sin(Math.PI * sunT) * 5).toFixed(2)}vh)`;
      sun.style.opacity = String(sunVis);
      const night = range(p, 0.44, 0.76);
      moon.style.transform = `translate(${(30 + night * 50).toFixed(2)}vw, ${(12 - Math.sin(Math.PI * night) * 5).toFixed(2)}vh)`;
      moon.style.opacity = String(range(p, 0.45, 0.5) * (1 - range(p, 0.72, 0.77)));

      let scene = SCENES[0][1];
      SCENES.forEach(([at, s]) => p >= at && (scene = s));
      if (scene !== lastScene) {
        lastScene = scene;
        sceneEl.textContent = scene;
      }
      const done = p > 0.8;
      root.classList.toggle('is-done', done);
      lockEl.classList.toggle('is-in', done);
    };

    if (reducedMotion) {
      root.classList.add('is-static');
      cur = 0.62;
      draw(true);
      words.forEach((w) => w.classList.add('is-lit'));
      lockEl.classList.add('is-in');
      return;
    }

    ScrollTrigger.create({ trigger: root, start: 'top top', end: 'bottom bottom', onUpdate: (s) => (target = s.progress) });

    let visible = false;
    new IntersectionObserver((e) => (visible = e[0]?.isIntersecting ?? false), { rootMargin: '100px' }).observe(root);
    gsap.ticker.add((_t, dms) => {
      if (!visible) return;
      const dt = Math.min(0.05, dms / 1000);
      // Breath-like catch-up: the scene exhales toward the scroll position.
      cur += (target - cur) * (1 - Math.exp(-dt * 2.6));
      const calm = sine(range(cur, 0.03, 0.4));
      beat += dt * (lerp(118, 56, calm) / 60) * 0.55;
      draw();
    });
    draw(true);
  });
</script>

<style>
  .gs-o { position: relative; height: 520vh; --ink-o: #2b1208; --ink-o2: #6b4a3a; }
  .gs-o.is-night { --ink-o: #fff4ec; --ink-o2: #e3d6f5; }
  .gs-o-sticky { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; background: var(--sky, #ffe6d6); color: var(--ink-o); isolation: isolate; }
  .gs-o-sky { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .gs-o-blob { position: absolute; border-radius: 50%; filter: blur(60px); animation: gs-o-breathe 5.5s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
  .gs-o-blob--a { width: 60vmax; height: 60vmax; left: -18vmax; top: -22vmax; background: radial-gradient(circle, rgb(255 255 255 / 0.55), transparent 65%); }
  .gs-o-blob--b { width: 50vmax; height: 50vmax; right: -16vmax; bottom: -20vmax; background: radial-gradient(circle, rgb(255 122 69 / 0.28), transparent 65%); animation-delay: -2.7s; }
  .gs-o.is-night .gs-o-blob--a { background: radial-gradient(circle, rgb(185 166 232 / 0.22), transparent 65%); }
  .gs-o.is-night .gs-o-blob--b { background: radial-gradient(circle, rgb(74 47 120 / 0.6), transparent 65%); }
  @keyframes gs-o-breathe { 50% { transform: scale(1.08); } }
  .gs-o-sun, .gs-o-moon { position: absolute; left: 0; top: 0; width: clamp(56px, 7vw, 110px); aspect-ratio: 1; margin: calc(clamp(56px, 7vw, 110px) / -2) 0 0 calc(clamp(56px, 7vw, 110px) / -2); border-radius: 50%; will-change: transform, opacity; }
  .gs-o-sun { background: radial-gradient(circle at 40% 38%, #fff6e2, #ffd08a 45%, #ffa477 80%); box-shadow: 0 0 90px 40px rgb(255 190 140 / 0.4); filter: blur(1px); }
  .gs-o-moon { background: radial-gradient(circle at 36% 34%, #fff8ee, #e9dcff 70%); box-shadow: 0 0 60px 16px rgb(233 220 255 / 0.25); opacity: 0; -webkit-mask: radial-gradient(circle at 78% 30%, transparent 38%, #000 39%); mask: radial-gradient(circle at 78% 30%, transparent 38%, #000 39%); }
  .gs-o-stars { position: absolute; inset: 0; opacity: 0; transition: opacity 1.4s; background-image: radial-gradient(1.5px 1.5px at 12% 18%, #fff 50%, transparent), radial-gradient(1px 1px at 28% 9%, #fff 50%, transparent), radial-gradient(1.5px 1.5px at 46% 22%, #fff 50%, transparent), radial-gradient(1px 1px at 63% 12%, #fff 50%, transparent), radial-gradient(1.5px 1.5px at 78% 26%, #fff 50%, transparent), radial-gradient(1px 1px at 88% 8%, #fff 50%, transparent), radial-gradient(1px 1px at 8% 40%, #fff 50%, transparent), radial-gradient(1px 1px at 92% 44%, #fff 50%, transparent); }
  .gs-o.is-night .gs-o-stars { opacity: 0.8; }

  .gs-o-lines { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; overflow: visible; }
  .gs-o-band { transition: opacity 0.6s; }
