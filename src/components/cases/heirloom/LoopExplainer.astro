---
// The centrepiece: a pinned, full-viewport WebGL explainer of Heirloom's limestone loop.
// Scroll (GSAP ScrollTrigger scrub) drives 8 beats; each beat has an HTML caption, so the
// story is readable text first and 3D second. Reduced motion → no pin, a static frame per
// beat and step buttons. No WebGL → the storyboard frame for the active beat.
import type { Beat } from '../../../data/cases/heirloom';
interface Props {
  beats: Beat[];
}
const { beats } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="hlx" data-hlx style={`--n:${beats.length}`}>
  <div class="hlx-track" data-hlx-track>
    <div class="hlx-stage">
      <canvas class="hlx-canvas" data-hlx-canvas aria-hidden="true"></canvas>
      <div class="hlx-fallback" aria-hidden="true">
        {beats.map((b, i) => <div class="hlx-fb" data-fb={i} set:html={b.svg} />)}
      </div>
      <div class="hlx-tags" data-hlx-tags aria-hidden="true"></div>
      <div class="hlx-vignette" aria-hidden="true"></div>

      <div class="hlx-caps" aria-live="polite" data-hlx-caps>
        {
          beats.map((b, i) => (
            <article class:list={['hlx-cap', { 'is-on': i === 0 }]} data-cap={i}>
              <p class="hlx-kicker">
                <span class="hlx-num">{pad(i + 1)}</span>
                <span class="hlx-of">/ {pad(beats.length)}</span> · {b.kicker}
              </p>
              <h3 class="hlx-title">{b.title}</h3>
              <p class="hlx-text" set:html={b.text} />
              {b.formula && <p class="hlx-formula">{b.formula}</p>}
              {i === 1 && (
                <p class="hlx-ro">
                  <span class="hlx-ro-k">Kiln</span>
                  <span class="hlx-ro-v"><span data-ro="temp">0</span> °C</span>
                  <span class="hlx-meter"><i data-ro="tempbar" /></span>
                </p>
              )}
              {i === 3 && (
                <p class="hlx-chips">
                  <span class="hlx-chip">Tracy, CA · concrete (CarbonCure)</span>
                  <span class="hlx-chip hlx-chip--plan">Louisiana · geologic (planned)</span>
                </p>
              )}
              {i === 5 && (
                <p class="hlx-ro">
                  <span class="hlx-ro-k">Rack height</span>
                  <span class="hlx-ro-v">~<span data-ro="height">0</span> ft</span>
                  <span class="hlx-meter"><i data-ro="heightbar" /></span>
                </p>
              )}
              {i === 6 && (
                <div class="hlx-days" data-ro="days">
                  <span>Day 1</span><span>Day 2</span><span>Day 3</span>
                  <span class="hlx-meter hlx-meter--air"><i data-ro="daybar" /></span>
                </div>
              )}
            </article>
          ))
        }
      </div>

      <nav class="hlx-steps" aria-label="Explainer beats">
        <span class="hlx-steps-track" aria-hidden="true"><i data-hlx-fill></i></span>
        <ol role="list">
          {
            beats.map((b, i) => (
              <li>
                <button type="button" data-goto={i} aria-label={`Beat ${i + 1}: ${b.title}`} aria-current={i === 0 ? 'step' : undefined}>
                  <span class="hlx-dot" aria-hidden="true" />
                  <span class="hlx-step-l">{b.kicker}</span>
                </button>
              </li>
            ))
          }
        </ol>
      </nav>
      <p class="hlx-hint" aria-hidden="true">Scroll to run the loop <span>↓</span></p>
      <p class="hlx-static-note">Reduced motion is on: use the steps to move through the loop.</p>
    </div>
  </div>
</div>

<script>
  import { gsap, reducedMotion, whenNear, lenis } from '../../../scripts/motion';
  import type { LoopScene, Stats } from '../../../scripts/three/heirloom';

  const root = document.querySelector<HTMLElement>('[data-hlx]');
  if (root) {
    const BEATS = 8;
    const track = root.querySelector<HTMLElement>('[data-hlx-track]')!;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-hlx-canvas]')!;
    const caps = [...root.querySelectorAll<HTMLElement>('[data-cap]')];
    const fbs = [...root.querySelectorAll<HTMLElement>('[data-fb]')];
    const steps = [...root.querySelectorAll<HTMLButtonElement>('[data-goto]')];
    const fill = root.querySelector<HTMLElement>('[data-hlx-fill]');
    const ro = (k: string) => root.querySelector<HTMLElement>(`[data-ro="${k}"]`);
    const temp = ro('temp'), tempbar = ro('tempbar'), height = ro('height'), heightbar = ro('heightbar'), days = ro('days'), daybar = ro('daybar');
    const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
    const range = (b: number, a: number, c: number) => clamp01((b - a) / (c - a));
    const ease = (x: number) => x * x * (3 - 2 * x);

    let scene: LoopScene | null = null;
    let progress = 0;
    let active = -1;

    const setActive = (i: number) => {
      if (i === active) return;
      active = i;
      caps.forEach((c, j) => c.classList.toggle('is-on', j === i));
      fbs.forEach((c, j) => c.classList.toggle('is-on', j === i));
      steps.forEach((s, j) => {
        s.classList.toggle('is-done', j < i);
        if (j === i) s.setAttribute('aria-current', 'step');
        else s.removeAttribute('aria-current');
      });
      root.classList.toggle('is-first', i === 0);
    };

    const apply = (p: number) => {
      progress = p;
      const b = Math.min(BEATS - 0.001, p * BEATS);
      setActive(Math.floor(b));
      if (fill) fill.style.setProperty('--p', String(p));
      const heat = ease(range(b, 0.95, 1.75));
      if (temp) temp.textContent = String(Math.round(heat * 900));
      if (tempbar) tempbar.style.transform = `scaleX(${heat})`;
      const rise = range(b, 4.95, 5.75);
      if (height) height.textContent = String(Math.round(rise * 40));
      if (heightbar) heightbar.style.transform = `scaleX(${rise})`;
      const day = range(b, 6.05, 6.95);
      if (days) [...days.children].slice(0, 3).forEach((d, j) => d.classList.toggle('is-on', j === Math.min(2, Math.floor(day * 3))));
      if (daybar) daybar.style.transform = `scaleX(${day})`;
      scene?.setProgress(p);
    };

    // Where each beat "sits" in the scroll (camera keyframes are mid-beat).
    const beatPos = (i: number) => (i === BEATS - 1 ? 7.93 : i + 0.75) / BEATS;

    let st: { start: number; end: number } | null = null;
    if (reducedMotion) {
      root.classList.add('is-static');
      apply(beatPos(0));
    } else {
      const proxy = { p: 0 };
      const tw = gsap.to(proxy, {
        p: 1,
        ease: 'none',
        scrollTrigger: { trigger: track, start: 'top top', end: 'bottom bottom', scrub: 0.5 },
        onUpdate: () => apply(proxy.p),
      });
      st = tw.scrollTrigger ?? null;
      apply(0);
    }

    const goTo = (i: number) => {
      if (!st) {
        apply(beatPos(i));
        root.scrollIntoView({ block: 'start' });
        return;
      }
      const y = st.start + (st.end - st.start) * beatPos(i);
      if (lenis) lenis.scrollTo(y, { duration: 1.6 });
      else window.scrollTo({ top: y, behavior: 'smooth' });
    };
    steps.forEach((s, i) => s.addEventListener('click', () => (st ? goTo(i) : apply(beatPos(i)))));
    window.addEventListener('hl:goto', (e) => goTo((e as CustomEvent<number>).detail));

    whenNear(
      root,
      () =>
        import('../../../scripts/three/heirloom')
          .then((m) => {
            scene = m.init(canvas, {
              labels: root.querySelector<HTMLElement>('[data-hlx-tags]'),
              onStats: (s: Stats) => window.dispatchEvent(new CustomEvent('hl:stats', { detail: s })),
            });
            scene.setProgress(progress, true);
            root.classList.add('is-live');
          })
          .catch(() => root.classList.add('is-fallback')),
      '900px',
    );
  }
</script>

<style>
  .hlx { position: relative; --edge: max(var(--gutter), 20px); }
  .hlx-track { position: relative; height: calc(100svh * (var(--n) + 1)); }
  .hlx-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    background: radial-gradient(120% 90% at 62% 40%, #2a2926 0%, #161615 55%, #0b0b0a 100%);
    isolation: isolate;
  }
  .hlx-canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1.2s var(--ease-out); }
  .is-live .hlx-canvas { opacity: 1; }
  .hlx-vignette { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, rgb(11 11 10 / 0.75), transparent 38%), linear-gradient(0deg, rgb(11 11 10 / 0.5), transparent 22%); }

  /* Fallback (no WebGL): storyboard frame for the active beat. */
  .hlx-fallback { position: absolute; inset: 12% 6% 12% 38%; display: none; }
  .is-fallback .hlx-fallback { display: grid; }
  .hlx-fb { grid-area: 1 / 1; opacity: 0; transition: opacity var(--dur-2); display: grid; place-items: center; }
  .hlx-fb.is-on { opacity: 1; }
  .hlx-fb :global(svg) { width: 100%; height: 100%; border-radius: var(--r-lg); }

  /* World-anchored tags (positioned by the scene). */
  .hlx-tags { position: absolute; inset: 0; pointer-events: none; }
  .hlx-tags :global(.hlx-tag) {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    padding: 4px 10px;
    border-radius: 99px;
    background: rgb(242 239 232 / 0.92);
    color: #1e1e1c;
    font: 600 12px/1.3 var(--font-ui);
    white-space: nowrap;
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.35);
    will-change: transform, opacity;
  }
  .hlx-tags :global(.hlx-tag::after) { content: ''; position: absolute; left: 50%; top: 100%; width: 1px; height: 14px; background: rgb(242 239 232 / 0.6); }
  .hlx-tags :global(.hlx-tag--hot) { background: #e2783a; color: #1e1e1c; }
  .hlx-tags :global(.hlx-tag--air) { background: #a9c1d9; color: #1e1e1c; }

  /* Captions */
  .hlx-caps { position: absolute; left: max(var(--edge), 76px); top: 50%; transform: translateY(-46%); width: min(29rem, 36vw); display: grid; }
  .hlx-cap {
    grid-area: 1 / 1;
    align-self: center;
    display: grid;
    gap: var(--s-3);
    padding: var(--s-6);
    border-radius: var(--r-lg);
    /* Solid-ish panel, no backdrop-filter: blurring a live WebGL canvas every frame is costly. */
    background: rgb(22 22 21 / 0.88);
    border: 1px solid rgb(242 239 232 / 0.1);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.7);
    opacity: 0;
    visibility: hidden;
    transform: translateY(18px);
    transition: opacity 0.5s var(--ease-out), transform 0.7s var(--ease-out), visibility 0s 0.5s;
  }
  .hlx-cap.is-on { opacity: 1; visibility: visible; transform: none; transition: opacity 0.6s var(--ease-out) 0.1s, transform 0.8s var(--ease-out) 0.1s, visibility 0s; }
  .hlx-kicker { font: 500 var(--fs-label) / 1.2 var(--font-ui); letter-spacing: var(--tracking-label); text-transform: uppercase; color: #b9b5ab; }
  .hlx-num { color: #e2783a; font-weight: 700; }
  .hlx-of { opacity: 0.6; }
  .hlx-title { font-size: var(--fs-2xl); line-height: 1.02; color: #f2efe8; }
  .hlx-text { color: #d8d4ca; font-size: var(--fs-base); line-height: 1.55; }
  .hlx-text :global(strong), .hlx-text :global(em) { color: #f2efe8; }
  .hlx-formula { justify-self: start; padding: 6px 12px; border-radius: 10px; background: rgb(242 239 232 / 0.08); border: 1px solid rgb(242 239 232 / 0.14); font: 600 var(--fs-sm) / 1.3 var(--font-ui); color: #f2efe8; letter-spacing: 0.01em; }
  .hlx-ro { display: grid; grid-template-columns: 1fr auto; gap: 6px 12px; align-items: baseline; font-family: var(--font-ui); }
  .hlx-ro-k { font-size: var(--fs-label); letter-spacing: var(--tracking-label); text-transform: uppercase; color: #9a968d; }
  .hlx-ro-v { font-weight: 700; font-size: var(--fs-xl); color: #e2783a; font-feature-settings: 'tnum' 1; }
  .hlx-meter { grid-column: 1 / -1; height: 6px; border-radius: 3px; background: rgb(242 239 232 / 0.1); overflow: hidden; }
  .hlx-meter i { display: block; height: 100%; background: linear-gradient(90deg, #d2691e, #f4b06e); transform-origin: left; transform: scaleX(0); }
  .hlx-meter--air i { background: linear-gradient(90deg, #a9c1d9, #f2efe8); }
  .hlx-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .hlx-chip { padding: 4px 10px; border-radius: 99px; border: 1px solid rgb(242 239 232 / 0.25); font: 500 12px/1.4 var(--font-ui); color: #f2efe8; }
  .hlx-chip--plan { border-style: dashed; color: #a9c1d9; border-color: rgb(169 193 217 / 0.5); }
  .hlx-days { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; font: 600 var(--fs-sm) / 1 var(--font-ui); }
  .hlx-days > span:not(.hlx-meter) { padding: 9px 0; text-align: center; border-radius: 10px; background: rgb(242 239 232 / 0.06); color: #8f8b83; transition: background var(--dur-1), color var(--dur-1); }
  .hlx-days > span.is-on { background: #a9c1d9; color: #1e1e1c; }

  /* Step indicator */
  .hlx-steps { position: absolute; right: var(--edge); top: 50%; transform: translateY(-50%); display: flex; gap: 10px; }
  .hlx-steps-track { position: relative; width: 2px; border-radius: 2px; background: rgb(242 239 232 / 0.15); margin-block: 14px; }
  .hlx-steps-track i { position: absolute; inset: 0; background: #e2783a; transform-origin: top; transform: scaleY(var(--p, 0)); border-radius: 2px; }
  .hlx-steps ol { list-style: none; padding: 0; display: grid; gap: 2px; }
  .hlx-steps button { display: flex; align-items: center; gap: 10px; min-height: 36px; padding: 0 8px; border-radius: 10px; color: #8f8b83; font: 500 12px/1 var(--font-ui); letter-spacing: 0.06em; text-transform: uppercase; transition: color var(--dur-1), background var(--dur-1); }
  .hlx-steps button:hover { color: #f2efe8; background: rgb(242 239 232 / 0.06); }
  .hlx-dot { width: 9px; height: 9px; border-radius: 50%; border: 1.5px solid currentColor; flex: none; transition: background var(--dur-1), transform var(--dur-1); }
  .hlx-steps button.is-done .hlx-dot { background: #8f8b83; }
  .hlx-steps button[aria-current] { color: #f2efe8; }
  .hlx-steps button[aria-current] .hlx-dot { background: #e2783a; border-color: #e2783a; transform: scale(1.35); }
  .hlx-step-l { opacity: 0; transform: translateX(-4px); transition: opacity var(--dur-1), transform var(--dur-1); white-space: nowrap; }
  .hlx-steps:hover .hlx-step-l, .hlx-steps button[aria-current] .hlx-step-l, .hlx-steps button:focus-visible .hlx-step-l { opacity: 1; transform: none; }
  .hlx-steps { flex-direction: row-reverse; }
  .hlx-steps button { flex-direction: row-reverse; }

  .hlx-hint { position: absolute; left: 50%; bottom: 104px; transform: translateX(-50%); font: 500 var(--fs-label) / 1 var(--font-ui); letter-spacing: var(--tracking-label); text-transform: uppercase; color: #b9b5ab; opacity: 0; transition: opacity var(--dur-2); pointer-events: none; }
  .hlx-hint span { display: inline-block; animation: hlx-bob 1.6s ease-in-out infinite; }
  .is-first .hlx-hint { opacity: 1; }
  @keyframes hlx-bob { 50% { transform: translateY(4px); } }
  .hlx-static-note { display: none; }

  /* Reduced motion: no pin, step through static frames. */
  .is-static .hlx-track { height: auto; }
  .is-static .hlx-stage { position: relative; height: min(88svh, 860px); min-height: 640px; }
  .is-static .hlx-hint { display: none; }
  .is-static .hlx-static-note { display: block; position: absolute; left: max(var(--edge), 76px); top: 24px; font: 500 var(--fs-sm) / 1.4 var(--font-ui); color: #b9b5ab; }

  @media (max-width: 900px), (max-aspect-ratio: 1/1) {
    .hlx-vignette { background: linear-gradient(0deg, rgb(11 11 10 / 0.85), transparent 48%); }
    .hlx-caps { left: 16px; right: 16px; width: auto; top: auto; bottom: calc(var(--nav-h) + 1rem + 14px); transform: none; }
    .hlx-cap { padding: var(--s-4) var(--s-5); gap: var(--s-2); }
    .hlx-title { font-size: var(--fs-xl); }
    .hlx-text { font-size: var(--fs-sm); }
    .hlx-steps { left: 16px; right: 16px; top: 84px; transform: none; flex-direction: column; gap: 8px; }
    .hlx-steps-track { width: auto; height: 2px; margin: 0; }
    .hlx-steps-track i { transform-origin: left; transform: scaleX(var(--p, 0)); }
    .hlx-steps ol { grid-template-columns: repeat(8, 1fr); gap: 4px; }
    .hlx-steps button { justify-content: center; min-height: 32px; padding: 0; }
    .hlx-step-l { display: none; }
    .hlx-hint { display: none; }
    .hlx-fallback { inset: 22% 4% 42% 4%; }
    .is-static .hlx-stage { min-height: 720px; }
    .is-static .hlx-static-note { left: 16px; right: 16px; top: 130px; }
  }
</style>
