---
// Community layer (concept): a "what will I see from the road?" massing visualiser
// plus a plain-language FAQ for neighbours of the planned Louisiana plant.
const faqs = [
  {
    q: 'What will I see from the road?',
    a: 'Tall, open racks of flat trays holding white mineral powder, about 40 ft (12 m) high, plus kiln and tank buildings. The picture above is illustrative. The live page would use the real site plan, with renders matched to photos taken from public roads.',
  },
  {
    q: 'Does the kiln burn fuel?',
    a: 'Heirloom’s kilns are electric and run on renewable electricity. In Tracy that power comes from Ava Community Energy. Future plants are set to use Leilac/Calix electric kiln technology. The live page would link to the emissions and safety sections of the project’s environmental documents.',
  },
  {
    q: 'Where does the CO₂ go?',
    a: 'Into permanent storage. In Tracy it goes into concrete with CarbonCure, where it mineralises. Plans for Louisiana call for geologic storage underground. DOE published the final environmental impact statement for Project Cypress in March 2026.',
  },
  {
    q: 'How many local jobs will there be?',
    a: 'We haven’t put a number here because we couldn’t verify one. The live page would list roles, skills and training routes from Heirloom’s own published figures, each with a date.',
  },
  {
    q: 'When will it be built?',
    a: 'The Louisiana plants are planned. Federal support for Project Cypress changed during 2025–26, and current build timelines are not confirmed. So the page shows a dated status rather than a promise.',
  },
];
// Massing in "feet × 4 px" so the 40 ft rack is 160 units tall.
const racks = Array.from({ length: 7 }, (_, i) => i * 46);
---

<div class="rv" data-rv data-view="road" data-time="day">
  <div class="rv-stage">
    <svg class="rv-svg" viewBox="0 0 1000 440" role="img" aria-labelledby="rv-title rv-desc">
      <title id="rv-title">Illustrative view of a planned direct air capture plant from a nearby road</title>
      <desc id="rv-desc">Open tray racks about 40 feet tall behind a tree line, with kiln and tank buildings. Illustrative massing, not a site plan.</desc>
      <defs>
        <linearGradient id="rv-day" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#bcd3e0" /><stop offset="1" stop-color="#eef1ee" /></linearGradient>
        <linearGradient id="rv-night" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#0c111b" /><stop offset="1" stop-color="#252b36" /></linearGradient>
      </defs>
      <rect width="1000" height="440" fill="url(#rv-day)" />
      <rect class="rv-nightsky" width="1000" height="440" fill="url(#rv-night)" />
      <g class="rv-stars" fill="#fff">{Array.from({ length: 40 }, (_, i) => <circle cx={(i * 197) % 1000} cy={(i * 53) % 220} r={i % 3 === 0 ? 1.4 : 0.8} />)}</g>
      <path class="rv-hills" d="M0 300 C 160 270, 300 290, 460 276 S 760 262, 1000 284 V 440 H0Z" />

      <g class="rv-plant">
        <g class="rv-plant-inner">
          <!-- tray racks -->
          {
            racks.map((x) => (
              <g transform={`translate(${x} 0)`}>
                <rect x="0" y="-160" width="34" height="160" class="rv-rack" />
                {Array.from({ length: 16 }, (_, l) => <path d={`M0 ${-8 - l * 9.6} H34`} class="rv-tray" />)}
                <circle cx="17" cy="-150" r="2" class="rv-light" />
              </g>
            ))
          }
          <!-- kiln + tank buildings (illustrative) -->
          <rect x="-150" y="-104" width="120" height="104" class="rv-bldg" />
          <rect x="-128" y="-140" width="26" height="36" class="rv-bldg" />
          <rect x="-24" y="-92" width="18" height="92" rx="9" class="rv-tank" />
          <circle cx="-90" cy="-60" r="2.2" class="rv-light" />
          <!-- person for scale (6 ft) -->
          <g class="rv-person"><circle cx="340" cy="-21" r="3.4" /><rect x="337" y="-17" width="6" height="17" rx="3" /></g>
          <!-- dimension line -->
          <g class="rv-dim">
            <path d="M336 -160 V0 M330 -160 H342 M330 0 H342" />
            <text x="350" y="-76">~40 ft</text>
            <text x="350" y="-60" class="rv-dim-s">12 m</text>
          </g>
          <!-- comparison house (≈25 ft) -->
          <g class="rv-house">
            <path d="M412 0 V-62 L452 -100 L492 -62 V0Z" />
            <text x="452" y="-108" text-anchor="middle">House · ~25 ft</text>
          </g>
        </g>
      </g>

      <g class="rv-trees">{Array.from({ length: 22 }, (_, i) => <ellipse cx={i * 48 + 12} cy={318 - (i % 3) * 4} rx={30} ry={34 + (i % 4) * 6} />)}</g>
      <rect y="330" width="1000" height="110" class="rv-grass" />
      <g class="rv-fence">{Array.from({ length: 26 }, (_, i) => <path d={`M${i * 40} 336 V 362`} />)}<path d="M0 344 H1000 M0 354 H1000" /></g>
      <rect y="384" width="1000" height="44" class="rv-road" />
      <path d="M0 406 H1000" class="rv-lane" />
      <g class="rv-car"><rect x="120" y="388" width="84" height="22" rx="8" /><rect x="138" y="378" width="46" height="16" rx="6" /><circle cx="140" cy="412" r="7" /><circle cx="186" cy="412" r="7" /></g>
    </svg>
    <span class="rv-badge">Concept · illustrative massing, not a site plan</span>
  </div>

  <div class="rv-controls">
    <div class="rv-group" role="group" aria-label="Viewpoint">
      <span class="t-label">Viewpoint</span>
      <div class="rv-seg">
        <button type="button" data-rv-view="fence" aria-pressed="false">At the fence</button>
        <button type="button" data-rv-view="road" aria-pressed="true">From the road</button>
        <button type="button" data-rv-view="far" aria-pressed="false">Across the fields</button>
      </div>
    </div>
    <div class="rv-group" role="group" aria-label="Time of day">
      <span class="t-label">Time</span>
      <div class="rv-seg">
        <button type="button" data-rv-time="day" aria-pressed="true">Day</button>
        <button type="button" data-rv-time="night" aria-pressed="false">Night</button>
      </div>
    </div>
    <div class="rv-group">
      <span class="t-label">Compare</span>
      <button type="button" class="rv-toggle" data-rv-house aria-pressed="false"><span class="rv-sw" aria-hidden="true"></span> Two-storey house</button>
    </div>
  </div>
  <p class="t-small rv-note">Only the rack height (about 40 ft or 12 m) comes from public coverage. Building sizes, lighting and distances are placeholders that the real site plan would replace.</p>

  <div class="rv-faq">
    <p class="t-label">Neighbour FAQ · for Councillor Ray</p>
    <ul role="list">
      {
        faqs.map((f, i) => (
          <li>
            <h3 class="rv-q">
              <button type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`rv-a-${i}`} id={`rv-q-${i}`} data-rv-q>
                <span>{f.q}</span>
                <span class="rv-plus" aria-hidden="true" />
              </button>
            </h3>
            <div class="rv-a" id={`rv-a-${i}`} role="region" aria-labelledby={`rv-q-${i}`} hidden={i !== 0}>
              <p>{f.a}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-rv]').forEach((root) => {
    // Phones: crop the wide scene to the plant so it isn't tiny.
    const svg = root.querySelector<SVGSVGElement>('.rv-svg');
    const mq = window.matchMedia('(max-width: 640px)');
    const crop = () => svg?.setAttribute('viewBox', mq.matches ? '300 110 660 330' : '0 0 1000 440');
    crop();
    mq.addEventListener('change', crop);
    const press = (sel: string, el: HTMLButtonElement) =>
      root.querySelectorAll<HTMLButtonElement>(sel).forEach((b) => b.setAttribute('aria-pressed', String(b === el)));
    root.querySelectorAll<HTMLButtonElement>('[data-rv-view]').forEach((b) =>
      b.addEventListener('click', () => {
        root.dataset.view = b.dataset.rvView;
        press('[data-rv-view]', b);
      }),
    );
    root.querySelectorAll<HTMLButtonElement>('[data-rv-time]').forEach((b) =>
      b.addEventListener('click', () => {
        root.dataset.time = b.dataset.rvTime;
        press('[data-rv-time]', b);
      }),
    );
    const house = root.querySelector<HTMLButtonElement>('[data-rv-house]')!;
    house.addEventListener('click', () => {
      const on = house.getAttribute('aria-pressed') !== 'true';
      house.setAttribute('aria-pressed', String(on));
      root.classList.toggle('show-house', on);
    });
    root.querySelectorAll<HTMLButtonElement>('[data-rv-q]').forEach((q) =>
      q.addEventListener('click', () => {
        const open = q.getAttribute('aria-expanded') !== 'true';
        q.setAttribute('aria-expanded', String(open));
        const panel = document.getElementById(q.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !open;
      }),
    );
  });
</script>

<style>
  .rv { display: grid; gap: var(--s-5); }
  .rv-stage { position: relative; border-radius: var(--r-lg); overflow: hidden; border: 1px solid var(--line); }
  .rv-svg { width: 100%; height: auto; }
  .rv-badge { position: absolute; left: 12px; top: 12px; padding: 5px 10px; border-radius: 99px; background: rgb(30 30 28 / 0.82); color: #f2efe8; font: 600 11px/1.3 var(--font-ui); letter-spacing: 0.04em; }
  .rv-nightsky, .rv-stars { opacity: 0; transition: opacity 0.8s; }
  .rv[data-time='night'] .rv-nightsky, .rv[data-time='night'] .rv-stars { opacity: 1; }
  .rv-hills { fill: #b9c4b0; transition: fill 0.8s; }
  .rv[data-time='night'] .rv-hills { fill: #2c3330; }
  .rv-plant { transition: transform 1s var(--ease-out); }
  .rv[data-view='fence'] .rv-plant { transform: translate(420px, 332px) scale(1); }
  .rv[data-view='road'] .rv-plant { transform: translate(500px, 314px) scale(0.68); }
  .rv[data-view='far'] .rv-plant { transform: translate(570px, 296px) scale(0.36); }
  .rv-rack { fill: rgb(242 239 232 / 0.35); stroke: #6d6b66; stroke-width: 1.5; transition: fill 0.8s; }
  .rv-tray { stroke: #f7f5ef; stroke-width: 3; transition: stroke 0.8s; }
  .rv-bldg { fill: #a9a7a0; transition: fill 0.8s; }
  .rv-tank { fill: #d9d7d0; transition: fill 0.8s; }
  .rv[data-time='night'] .rv-rack { fill: rgb(40 44 50 / 0.6); stroke: #4a4f57; }
  .rv[data-time='night'] .rv-tray { stroke: #59606a; }
  .rv[data-time='night'] .rv-bldg { fill: #3a3f47; }
  .rv[data-time='night'] .rv-tank { fill: #4a5059; }
  .rv-light { fill: #ffd27a; opacity: 0; transition: opacity 0.8s; }
  .rv[data-time='night'] .rv-light { opacity: 1; filter: drop-shadow(0 0 6px #ffd27a); }
  .rv-person { fill: #1e1e1c; }
  .rv[data-time='night'] .rv-person { fill: #9aa0a8; }
  .rv-dim path { stroke: #d2691e; stroke-width: 2; fill: none; }
  .rv-dim text { fill: #d2691e; font: 700 16px Inter, sans-serif; }
  .rv-dim .rv-dim-s { font-weight: 500; font-size: 13px; }
  .rv-house { opacity: 0; transition: opacity 0.5s; }
  .rv-house path { fill: none; stroke: #1e1e1c; stroke-width: 2.5; stroke-dasharray: 6 5; }
  .rv-house text { fill: #1e1e1c; font: 600 13px Inter, sans-serif; }
  .rv[data-time='night'] .rv-house path { stroke: #f2efe8; }
  .rv[data-time='night'] .rv-house text { fill: #f2efe8; }
  .rv.show-house .rv-house { opacity: 1; }
  .rv-trees { fill: #6f8a5a; transition: opacity 0.8s, fill 0.8s; opacity: 0.55; }
  .rv[data-view='far'] .rv-trees { opacity: 1; }
  .rv[data-view='fence'] .rv-trees { opacity: 0; }
  .rv[data-time='night'] .rv-trees { fill: #1f2a22; }
  .rv-grass { fill: #9fae86; transition: fill 0.8s; }
  .rv[data-time='night'] .rv-grass { fill: #27302a; }
  .rv-fence path { stroke: #8c8a85; stroke-width: 2; }
  .rv-road { fill: #4f4e4a; }
  .rv-lane { stroke: #f2efe8; stroke-width: 2; stroke-dasharray: 26 22; }
  .rv-car { fill: #d2691e; }
  .rv-car circle { fill: #1e1e1c; }

  .rv-controls { display: flex; flex-wrap: wrap; gap: var(--s-4) var(--s-6); }
  .rv-group { display: grid; gap: var(--s-2); }
  .rv-seg { display: inline-flex; flex-wrap: wrap; padding: 4px; border-radius: 14px; border: 1px solid var(--line-strong); background: var(--surface); gap: 2px; }
  .rv-seg button, .rv-toggle { padding: 9px 14px; border-radius: 10px; font: 600 var(--fs-sm) / 1.1 var(--font-ui); color: var(--ink-2); transition: background var(--dur-1), color var(--dur-1); }
  .rv-seg button[aria-pressed='true'] { background: var(--a); color: #1e1e1c; }
  .rv-toggle { display: inline-flex; align-items: center; gap: 10px; border: 1px solid var(--line-strong); background: var(--surface); }
  .rv-sw { position: relative; width: 34px; height: 20px; border-radius: 10px; background: var(--surface-2); box-shadow: inset 0 0 0 1px var(--line-strong); transition: background var(--dur-1); }
  .rv-sw::after { content: ''; position: absolute; left: 3px; top: 3px; width: 14px; height: 14px; border-radius: 50%; background: var(--ink-2); transition: transform var(--dur-2) var(--ease-out); }
  .rv-toggle[aria-pressed='true'] .rv-sw { background: var(--a); }
  .rv-toggle[aria-pressed='true'] .rv-sw::after { transform: translateX(14px); background: #1e1e1c; }
  .rv-note { max-width: 70ch; }

  .rv-faq ul { list-style: none; padding: 0; margin-top: var(--s-3); border-top: 1px solid var(--line); }
  .rv-faq li { border-bottom: 1px solid var(--line); }
  .rv-faq h3 { font: inherit; letter-spacing: inherit; }
  .rv-faq button { width: 100%; display: flex; justify-content: space-between; align-items: center; gap: var(--s-4); padding: var(--s-4) 0; text-align: left; font-family: var(--font-display); font-weight: 700; font-size: var(--fs-lg); color: var(--ink); }
  .rv-plus { position: relative; flex: none; width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--line-strong); }
  .rv-plus::before, .rv-plus::after { content: ''; position: absolute; left: 50%; top: 50%; width: 11px; height: 1.5px; background: currentColor; transform: translate(-50%, -50%); transition: transform var(--dur-2) var(--ease-out); }
  .rv-plus::after { transform: translate(-50%, -50%) rotate(90deg); }
  .rv-faq button[aria-expanded='true'] .rv-plus::after { transform: translate(-50%, -50%) rotate(0deg); }
  .rv-faq button[aria-expanded='true'] .rv-plus { border-color: var(--a); color: var(--a); }
  .rv-a p { padding: 0 0 var(--s-5); max-width: 70ch; color: var(--ink-2); }
</style>
