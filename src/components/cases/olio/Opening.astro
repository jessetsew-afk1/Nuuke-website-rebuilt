      if (label !== lastStatus) {
        status.textContent = label;
        lastStatus = label;
      }

      const done = p > 0.86;
      root.classList.toggle('is-done', done);
      lock.classList.toggle('is-in', done);
    };

    measure();
    if (reducedMotion) {
      root.classList.add('is-static');
      requestAnimationFrame(() => {
        measure();
        render(1);
        svg.style.transform = '';
      });
      return;
    }
    render(0);
    const state = { p: 0 };
    gsap.to(state, {
      p: 1,
      ease: 'none',
      onUpdate: () => render(state.p),
      scrollTrigger: { trigger: root, start: 'top top', end: 'bottom bottom', scrub: 0.7, onRefresh: () => (measure(), render(state.p)) },
    });
    window.addEventListener('resize', () => (measure(), render(state.p)), { passive: true });
  });
</script>

