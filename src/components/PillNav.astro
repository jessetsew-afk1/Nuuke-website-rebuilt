---
import { nav, services, site, marketingStudio } from '../data/site';

const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/') || (href === '/blog' && path.startsWith('/blog-posts')));
const primary = nav.filter((n) => ['/', '/works', '/about', '/contact'].includes(n.href));
---

<nav class="pill" aria-label="Main">
  <div class="pill-track" data-pill>
    <span class="pill-indicator" aria-hidden="true" data-pill-indicator></span>
    {
      primary.map((item) => (
        <a href={item.href} class:list={['pill-link', { 'is-active': isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
    <button class="pill-link pill-more" type="button" aria-expanded="false" aria-controls="menu" data-menu-open>
      Menu
      <span class="pill-dots" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</nav>

<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Site menu" hidden data-menu>
  <div class="menu-inner container">
    <ul class="menu-list" role="list">
      {
        nav.map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={item.href} class:list={['menu-link', { 'is-active': isActive(item.href) }]}>
              <span class="t-label">0{i + 1}</span>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="menu-side">
      <p class="t-label">Services</p>
      <ul role="list">
        {services.map((s) => <li><a href={`/services/${s.slug}`}>{s.title}</a></li>)}
      </ul>
      <a class="menu-mk" href={marketingStudio.href} target="_blank" rel="noopener">
        <span class="menu-mk-dot" aria-hidden="true"></span>
        {marketingStudio.name}
        <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span>
      </a>
      <p class="t-label">Talk to us</p>
      <ul role="list">
        <li><a href={site.phoneHref}>{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>
  </div>
  <button class="menu-close" type="button" data-menu-close>Close</button>
</div>

<script>
  // Sliding indicator that follows the hovered / active link.
  const track = document.querySelector<HTMLElement>('[data-pill]');
  const indicator = document.querySelector<HTMLElement>('[data-pill-indicator]');
  if (track && indicator) {
    const links = [...track.querySelectorAll<HTMLElement>('.pill-link')];
    const moveTo = (el: HTMLElement | undefined) => {
      if (!el) {
        indicator.style.opacity = '0';
        return;
      }
      indicator.style.opacity = '1';
      indicator.style.width = `${el.offsetWidth}px`;
      indicator.style.transform = `translateX(${el.offsetLeft}px)`;
    };
    const active = () => links.find((l) => l.classList.contains('is-active'));
    moveTo(active());
    links.forEach((l) => l.addEventListener('pointerenter', () => moveTo(l)));
    track.addEventListener('pointerleave', () => moveTo(active()));
    document.fonts?.ready.then(() => moveTo(active()));
  }

  // Full-screen menu.
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  if (menu && openBtn && closeBtn) {
    const open = () => {
      menu.hidden = false;
      requestAnimationFrame(() => menu.classList.add('is-open'));
      openBtn.setAttribute('aria-expanded', 'true');
      document.documentElement.classList.add('menu-open');
      window.dispatchEvent(new CustomEvent('nuuke:lock', { detail: true }));
      closeBtn.focus();
    };
    const close = () => {
      menu.classList.remove('is-open');
      openBtn.setAttribute('aria-expanded', 'false');
      document.documentElement.classList.remove('menu-open');
      window.dispatchEvent(new CustomEvent('nuuke:lock', { detail: false }));
      setTimeout(() => (menu.hidden = true), 450);
      openBtn.focus();
    };
    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    menu.addEventListener('keydown', (e) => e.key === 'Escape' && close());
  }
</script>

<style>
  .pill {
    position: fixed;
    left: 50%;
    bottom: calc(1rem + env(safe-area-inset-bottom));
    transform: translateX(-50%);
    z-index: 60;
  }
  .pill-track {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2px;
    height: var(--nav-h);
    padding: 6px;
    border-radius: var(--r-pill);
    background: rgb(16 16 20 / 0.94);
    border: 1px solid var(--line);
    box-shadow: 0 10px 40px rgb(0 0 0 / 0.45);
  }
  .pill-indicator {
    position: absolute;
    left: 0;
    top: 6px;
    height: calc(100% - 12px);
    border-radius: var(--r-pill);
    background: var(--ink);
    transition: transform var(--dur-2) var(--ease-out), width var(--dur-2) var(--ease-out), opacity var(--dur-1);
    opacity: 0;
  }
  .pill-link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 100%;
    padding-inline: 1rem;
    border-radius: var(--r-pill);
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--ink-2);
    white-space: nowrap;
    transition: color var(--dur-1);
  }
  .pill-link.is-active,
  .pill-link:hover { color: var(--bg); }
  .pill-track:hover .pill-link.is-active:not(:hover) { color: var(--ink-2); }
  .pill-dots { display: inline-flex; gap: 3px; }
  .pill-dots i { width: 4px; height: 4px; border-radius: 50%; background: currentColor; }
  @media (max-width: 420px) {
    .pill-link { padding-inline: 0.7rem; font-size: 0.75rem; }
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 70;
    background: rgb(5 5 6 / 0.96);
    backdrop-filter: blur(20px);
    display: flex;
    align-items: center;
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out);
    overflow-y: auto;
  }
  .menu[hidden] { display: none; }
  .menu.is-open { opacity: 1; }
  .menu-inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--s-8);
    padding-block: 6rem 8rem;
  }
  .menu-list { list-style: none; padding: 0; }
  .menu-link {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.5rem, 1rem + 6vw, 6rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    color: var(--ink);
    transform: translateY(30px);
    opacity: 0;
    transition: transform var(--dur-3) var(--ease-out), opacity var(--dur-3) var(--ease-out), color var(--dur-1);
    transition-delay: calc(var(--i) * 50ms);
  }
  .menu.is-open .menu-link { transform: none; opacity: 1; }
  .menu-link:hover, .menu-link.is-active { color: var(--accent); }
  .menu-side { align-self: end; display: grid; gap: var(--s-3); }
  .menu-side ul { list-style: none; padding: 0; margin-bottom: var(--s-5); display: grid; gap: var(--s-2); }
  .menu-side a { color: var(--ink-2); }
  .menu-side a:hover { color: var(--ink); }
  .menu-mk { justify-self: start; display: inline-flex; align-items: center; gap: 0.6rem; margin-bottom: var(--s-5); padding: 0.55rem 1rem; border-radius: var(--r-pill); border: 1px solid rgb(255 46 136 / 0.55); background: rgb(255 46 136 / 0.08); color: var(--ink) !important; font: 600 var(--fs-sm) var(--font-ui); letter-spacing: 0.02em; transition: background var(--dur-2), transform var(--dur-2) var(--ease-out); }
  .menu-mk:hover { background: rgb(255 46 136 / 0.2); transform: translateX(4px); }
  .menu-mk-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); animation: menu-mk-pulse 2s ease-in-out infinite; }
  @keyframes menu-mk-pulse { 50% { opacity: 0.35; } }
  @media (prefers-reduced-motion: reduce) { .menu-mk-dot { animation: none; } }
  .menu-close {
    position: fixed;
    left: 50%;
    bottom: calc(1rem + env(safe-area-inset-bottom));
    transform: translateX(-50%);
    height: var(--nav-h);
    padding-inline: 2rem;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--bg);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.8125rem;
  }
  @media (max-width: 760px) {
    .menu { align-items: flex-start; }
    .menu-inner { grid-template-columns: 1fr; gap: var(--s-6); }
  }
</style>
