---
// Slim strip above the footer that flips to reveal our marketing studio.
import { marketingStudio as m } from '../../data/site';
---

<div class="mk-strip container">
  <a class="mk-flip" href={m.href} target="_blank" rel="noopener">
    <span class="mk-face mk-front" aria-hidden="true">
      <span class="mk-dot" aria-hidden="true"></span>
      <span class="mk-kicker">Sister studio</span>
      <span class="mk-q"><span class="mk-long">Need marketing that goes deeper?</span><span class="mk-short">Deeper marketing?</span></span>
      <span class="mk-arrow" aria-hidden="true">↻</span>
    </span>
    <span class="mk-face mk-back" aria-hidden="true">
      <span class="mk-host">{m.host}</span>
      <span class="mk-pitch">{m.pitch}</span>
      <span class="mk-arrow">↗</span>
    </span>
    <span class="visually-hidden">{m.name}: {m.pitch} Visit {m.host} (opens in a new tab)</span>
  </a>
</div>

<script>
  // The strip's looping animations (one repaints a glow every frame) only run while it is on screen.
  document.querySelectorAll<HTMLElement>('.mk-strip').forEach((el) => {
    el.classList.add('is-off');
    new IntersectionObserver((es) => el.classList.toggle('is-off', !(es[0]?.isIntersecting ?? false))).observe(el);
  });
</script>

<style>
  .mk-strip.is-off .mk-flip, .mk-strip.is-off .mk-dot { animation-play-state: paused; }
  .mk-strip { position: relative; z-index: 1; padding-block: var(--s-6) 0; perspective: 900px; }
  .mk-flip {
    position: relative;
    display: block;
    height: 64px;
    transform-style: preserve-3d;
    transition: transform 0.75s var(--ease-out);
    animation: mk-tease 9s var(--ease-in-out) 3s infinite;
  }
  .mk-flip:hover,
  .mk-flip:focus-visible { transform: rotateX(-180deg); animation: none; }
  @keyframes mk-tease {
    0%, 40% { transform: none; }
    50%, 90% { transform: rotateX(-180deg); }
    100% { transform: none; }
  }
  .mk-face {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding-inline: var(--s-5);
    border-radius: 99px;
    border: 1px solid var(--line-strong);
    background: rgb(255 255 255 / 0.025);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .mk-back {
    transform: rotateX(180deg);
    background: linear-gradient(90deg, rgb(255 46 136 / 0.18), rgb(255 46 136 / 0.04));
    border-color: rgb(255 46 136 / 0.55);
  }
  .mk-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 0 rgb(255 46 136 / 0.6); animation: mk-ping 2.4s ease-out infinite; flex-shrink: 0; }
  @keyframes mk-ping { 70% { box-shadow: 0 0 0 10px rgb(255 46 136 / 0); } 100% { box-shadow: 0 0 0 0 rgb(255 46 136 / 0); } }
  .mk-kicker, .mk-host { font: 600 var(--fs-label) var(--font-ui); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-2); white-space: nowrap; }
  .mk-host { color: var(--ink); font-size: var(--fs-sm); letter-spacing: 0.08em; text-transform: none; }
  .mk-q, .mk-pitch { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-lg); letter-spacing: -0.02em; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mk-short { display: none; }
  @media (max-width: 640px) { .mk-short { display: inline; } }
  .mk-arrow { margin-left: auto; font-size: var(--fs-lg); color: var(--accent); }
  @media (max-width: 640px) {
    .mk-flip { height: 56px; }
    .mk-kicker { display: none; }
    .mk-q, .mk-pitch { font-size: 1rem; }
    .mk-pitch { display: none; }
    .mk-host { font-size: 1rem; }
    .mk-long { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mk-flip { animation: none; transition: none; }
    .mk-dot { animation: none; }
  }
</style>
