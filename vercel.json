{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/works/etihad", "destination": "/works", "permanent": true },
    { "source": "/works/prometheus-fuels", "destination": "/works", "permanent": true },
    { "source": "/works/mars-express", "destination": "/works", "permanent": true },
    { "source": "/works/anodyne-2", "destination": "/works", "permanent": true },
    { "source": "/works/gymshark", "destination": "/works", "permanent": true },
    { "source": "/works/robotaxi", "destination": "/works", "permanent": true }
  ],
  "headers": [
    { "source": "/_astro/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
